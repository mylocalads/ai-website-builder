# Copy to .env and fill in. .env is gitignored; NEVER put a real value here.
#
# This file had a real Apify token pasted into it on 2026-08-20, in place of the
# placeholder, because there was no .env for it to go in. It was caught before it
# was ever committed. If you find yourself about to do the same, make a .env —
# that is what it is for.

# Apify — Google Maps business lookup
# Get your token at: apify.com → Settings → Integrations
APIFY_TOKEN=your_apify_token_here

# Vercel — Site deployment (optional, needed for remote/SSH setups)
# Get your token at: vercel.com/account/tokens
# If not set, you must run `vercel login` instead
VERCEL_TOKEN=

# The Vercel team the client projects live under (team_… ). Deploys land in the
# wrong account without it whenever the token can see more than one team.
VERCEL_TEAM_ID=

# --- The customer portal -----------------------------------------------------
#
# Needed by every PORTAL-DRIVEN job — a queued build, a site-edit, an image
# harvest. Without these the agent still builds a site locally, but it cannot
# report progress, cannot fetch the queue, and cannot hand the result back: the
# portal sees a build that never finished and the client sees a counter that
# never moves.
#
# Both were missing from this template until 2026-08-20 even though CLAUDE.md
# and the skills had referenced them for weeks.

# https://client.mylocalads.co in production. Not a secret.
MLA_PORTAL_URL=https://client.mylocalads.co

# Bearer token for /api/builds/* and /api/harvests/*. The SAME value the portal
# holds in its own environment — it is a shared secret, not a per-machine one.
# Every one of those routes fails closed (503) when the portal's copy is unset,
# and answers 401 when the two disagree.
BUILD_API_SECRET=

# --- Optional ----------------------------------------------------------------

# Short.io — Disappearing link creation
# Get your API key at: app.short.io → Settings → Integrations → API Key
# Required for /short-link skill. Uses domain: website-service.mylocalads.co
SHORTIO_API_KEY=

# Higgsfield — image generation and enhancement.
#
# TWO VALUES, NOT ONE. Higgsfield issues an API key as an id and a secret, and
# either alone authenticates nothing. mla-harvest.sh checks them separately so a
# missing half is named rather than reported as "credentials not set".
#
# Only used by the harvest-media skill: upscaling a scraped photo, cutting the
# background off a logo, and serving `job: generate` requests from the portal
# assistant. A scrape-only harvest works fully without either.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
