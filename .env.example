# Copy to .env and fill in. .env is gitignored — never commit real values,
# and never paste a key into a chat, a skill file, or a commit message.
#
# Used by the ai-website-fleet-audit skill.

# --- PageSpeed Insights ---------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> Create credentials
#   -> API key. Then Edit the key and set:
#     Application restrictions: None  (it is called from a script, not a browser)
#     API restrictions: Restrict key -> PageSpeed Insights API
# An unrestricted key works against every API enabled on the project, so
# restricting it is what keeps a leak boring instead of expensive.
# Free tier: 25,000 requests/day. A full fleet run is ~30.
PAGESPEED_API_KEY=

# --- Google Search Console ------------------------------------------------
# Search Console has no API-key auth — it is per-property, so it needs an
# identity. Use a service account:
#   Credentials -> Create credentials -> Service account -> (no IAM role needed;
#   Search Console grants access on its own side) -> Keys -> Add key -> JSON.
#
# Store the downloaded JSON OUTSIDE the repo (e.g. ~/.config/gcloud/) and point
# this at it. Anyone holding that file can read your Search Console data.
#
# THE STEP EVERYONE MISSES: copy the service account's email
# (something@your-project.iam.gserviceaccount.com) and add it as a user on each
# property in Search Console -> Settings -> Users and permissions. Enabling the
# API is not access. A 403 here means this step was skipped.
GSC_SERVICE_ACCOUNT_JSON=

# Property as Search Console identifies it. Domain properties use the sc-domain
# form; URL-prefix properties use the full origin with trailing slash.
#   sc-domain:fireflycd.com        (domain property)
#   https://fireflycd.com/         (URL-prefix property)
GSC_PROPERTY=sc-domain:fireflycd.com
