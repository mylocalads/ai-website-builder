# Environment variables (contains API tokens)
.env

# Vercel project config (created during deploy)
.vercel/
sites/**/.vercel/

# Node modules
node_modules/

# OS files
.DS_Store
Thumbs.db

# Screenshots (regenerated on each run)
screenshots/
.vercel

# Firecrawl scrape archives kept for debugging by intake-from-web. Regenerable,
# and they carry whatever keys were embedded in the client's public page HTML —
# three of them held the same live Google Maps browser key. Nothing downstream
# reads these after intake. Moved here from the monorepo's .gitignore when this
# folder was split into its own repo.
sites/*/raw/

# Caches
.firecrawl/
sites/**/.firecrawl/
