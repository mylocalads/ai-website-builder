---
import { getEntry } from 'astro:content';
import SectionHead from './SectionHead.astro';
const site = (await getEntry('site', 'config')).data as any;
const items = site.why_choose_us ?? [];
const isUrl = (s: string) => typeof s === 'string' && /^https?:\/\//i.test(s);
---
{items.length > 0 && (
  <section class="why-choose-us" aria-label="Why choose us">
    <div class="container">
      <SectionHead eyebrow="Why Choose Us" heading="Why commercial partners choose us" />
      <div class="grid">
        {items.map((i: any) => (
          <article class="tile">
            <div class="icon" aria-hidden="true">
              {isUrl(i.icon) ? (
                <span class="icon-mask" style={`--mask: url(${i.icon});`} aria-hidden="true"></span>
              ) : (
                <span class="emoji" aria-hidden="true">{i.icon}</span>
              )}
            </div>
            <h3>{i.title}</h3>
            <p>{i.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .why-choose-us { padding: var(--space-5) 0; background: var(--color-text); color: white; }
  .why-choose-us :global(.section-head h2) { color: white; }
  .why-choose-us :global(.section-head .subtitle) { color: rgba(255,255,255,0.7); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-3); }
  .tile { padding: var(--space-3); background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; text-align: center; transition: transform 0.2s ease, box-shadow 0.25s ease, border-color 0.2s ease; }
  .tile:hover { transform: translateY(-5px); box-shadow: 0 18px 42px rgba(0, 207, 209, 0.28); border-color: rgba(0, 207, 209, 0.35); }
  .icon { height: 72px; margin: 0 auto var(--space-2); display: flex; align-items: center; justify-content: center; }
  .icon-mask { width: 60px; height: 60px; background-color: var(--color-accent); display: inline-block; -webkit-mask: var(--mask) no-repeat center / contain; mask: var(--mask) no-repeat center / contain; }
  .icon .emoji { font-size: 3rem; }
  .tile h3 { margin: 0 0 var(--space-1); font-size: 1.15rem; color: white; }
  .tile p { color: rgba(255,255,255,0.75); margin: 0; }
</style>
