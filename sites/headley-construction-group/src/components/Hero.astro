---
import { getEntry } from 'astro:content';
import GHLFormEmbed from './GHLFormEmbed.astro';
import SMSConsent from './SMSConsent.astro';
export interface Props {
  eyebrow?: string;
  headline: string;
  subheadline: string;
  cta_text: string;
  cta_href: string;
  photo?: string;
  video?: string;
  form_embed_url?: string;
  form_title?: string;
}
const { eyebrow, headline, subheadline, cta_text, cta_href, photo, video, form_embed_url, form_title = 'Book now' } = Astro.props;
const site = (await getEntry('site', 'config')).data as any;
const calendarSnippet = site.crm?.calendar_embed_snippet;
const heroPhoto = photo ?? site.default_hero_photo;
const heroVideo = video ?? site.default_hero_video;
---
<section class="hero">
  {heroVideo ? (
    <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster={heroPhoto}>
      <source src={heroVideo} type="video/mp4" />
    </video>
  ) : heroPhoto ? (
    <div class="hero-photo" style={`background-image: url(${heroPhoto});`}></div>
  ) : null}
  <div class="hero-overlay"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{headline}</h1>
      <p class="sub">{subheadline}</p>
      <a href={cta_href} class="cta">{cta_text}</a>
    </div>
    <div class="hero-form">
      {calendarSnippet ? (
        <div class="calendar-wrap">
          <Fragment set:html={calendarSnippet} />
        </div>
      ) : form_embed_url ? (
        <div class="form-wrap">
          <SMSConsent />
          <GHLFormEmbed embed_url={form_embed_url} title={form_title} />
        </div>
      ) : (
        <div class="sales-card">
          <p class="sales-eyebrow">Contact Sales</p>
          <h3 class="sales-heading">Talk to an owner directly</h3>
          <div class="sales-people">
            <div class="sales-person">
              <p class="name">Chris Headley</p>
              <p class="role">Co-Founder</p>
              <p class="phone"><a href="tel:+13056131490">(305) 613-1490</a></p>
              <p class="email"><a href="mailto:Chris@headleycg.com">Chris@headleycg.com</a></p>
            </div>
            <div class="sales-divider" aria-hidden="true"></div>
            <div class="sales-person">
              <p class="name">Thomas Headley</p>
              <p class="role">Co-Founder</p>
              <p class="phone"><a href="tel:+13054982327">(305) 498-2327</a></p>
              <p class="email"><a href="mailto:Thomas@headleycg.com">Thomas@headleycg.com</a></p>
            </div>
          </div>
          <p class="sales-foot">Send us the scope, address, and any drawings — we'll come back quickly with a real number.</p>
        </div>
      )}
    </div>
  </div>
</section>
<style>
  .hero { padding: var(--space-5) 0; color: white; position: relative; overflow: hidden; }
  .hero-video, .hero-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .hero-photo { background-size: cover; background-position: center; background-repeat: no-repeat; }
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(rgba(15,20,25,0.55), rgba(15,20,25,0.55)); z-index: 1; }
  .hero-inner { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--space-4); align-items: start; min-height: 480px; position: relative; z-index: 2; }
  .hero-copy { max-width: 34rem; padding-top: var(--space-3); }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.85rem; opacity: 0.9; margin: 0 0 var(--space-1); }
  h1 { font-size: clamp(2.25rem, 4.5vw, 3.75rem); color: white; text-shadow: 0 2px 8px rgba(0,0,0,0.3); }
  .sub { font-size: 1.2rem; opacity: 0.95; max-width: 32rem; }
  .cta { display: inline-block; margin-top: var(--space-2); background: var(--color-accent); color: white; padding: 1rem 1.75rem; border-radius: var(--radius-sm); text-decoration: none; font-weight: 600; font-size: 1.05rem; }
  .cta:hover { filter: brightness(1.1); }
  .hero-form { background: white; color: var(--color-text); border-radius: var(--radius-md); padding: var(--space-2); box-shadow: 0 12px 40px rgba(0,0,0,0.25); }
  .calendar-wrap iframe { width: 100%; min-height: 500px; border: 0; }
  .sales-card { padding: var(--space-3); text-align: center; }
  .sales-eyebrow { text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.8rem; font-weight: 600; color: var(--color-accent); margin: 0 0 var(--space-1); }
  .sales-heading { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; line-height: 1.2; margin: 0 0 var(--space-3); color: var(--color-text); }
  .sales-people { display: grid; grid-template-columns: 1fr auto 1fr; gap: var(--space-2); align-items: stretch; margin-bottom: var(--space-3); }
  .sales-person { text-align: center; padding: 0 var(--space-1); }
  .sales-person .name { font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; margin: 0 0 0.15rem; color: var(--color-text); }
  .sales-person .role { font-size: 0.8rem; color: var(--color-muted); margin: 0 0 var(--space-2); text-transform: uppercase; letter-spacing: 0.08em; }
  .sales-person .phone { font-size: 1.05rem; font-weight: 600; margin: 0 0 0.35rem; }
  .sales-person .phone a { color: var(--color-accent); text-decoration: none; }
  .sales-person .email { font-size: 0.85rem; margin: 0; word-break: break-word; }
  .sales-person .email a { color: var(--color-text); text-decoration: none; border-bottom: 1px solid var(--color-muted); }
  .sales-person .email a:hover { color: var(--color-accent); border-color: var(--color-accent); }
  .sales-divider { width: 1px; background: var(--color-muted); opacity: 0.35; }
  .sales-foot { font-size: 0.9rem; color: var(--color-muted); margin: 0; padding-top: var(--space-2); border-top: 1px solid var(--color-surface); line-height: 1.5; }
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; min-height: auto; }
    .hero-form { margin-top: var(--space-3); }
    .sales-people { grid-template-columns: 1fr; gap: var(--space-2); }
    .sales-divider { width: 100%; height: 1px; }
  }
</style>
