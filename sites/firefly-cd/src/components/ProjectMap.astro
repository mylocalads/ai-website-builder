---
import SmartImage from './SmartImage.astro';
// project-map — server-rendered project list, filter chips, and photo grid.
//
// NOTE: this component deliberately has NO <style> block. Astro scoped styles
// cannot reach Leaflet's runtime-created DOM, so all styling lives in the
// global /project-map.css. See the header comment there.
//
// KEEP IN LOCKSTEP WITH public/project-map.js — renderRow()/renderCard() in
// that file must emit markup matching what this component renders.
//
// Everything a crawler needs is in the served HTML: every title, city, state,
// month, project type, product, and photo alt. The map and the filters are
// enhancements layered on top.
import type { ProjectMapPayload } from '../lib/project-map-payload';

export interface Props { payload: ProjectMapPayload }
const { payload } = Astro.props;
const { projects, facets, map } = payload;

const FACET_LABELS: Record<string, string> = {
  type: 'Project Type',
  product: 'Products Used',
  place: 'City & State',
};
const facetOrder: Array<'type' | 'product' | 'place'> = ['type', 'product', 'place'];
---
{projects.length > 0 && (
  <section id="project-map" data-pm-ssr="true" aria-labelledby="pm-heading">
    <div class="pm-inner">
      <div class="pm-head">
        <h2 id="pm-heading">{map.heading}</h2>
        {map.intro && <p>{map.intro}</p>}
      </div>

      {/* Chips render server-side so their labels are crawlable, but stay
          hidden until JS boots — a chip that does nothing is worse than none. */}
      <div class="pm-filters" data-pm-filters hidden>
        {facetOrder.map((key) => (
          facets[key].length > 1 && (
            <div class="pm-facet" role="group" aria-label={FACET_LABELS[key]}>
              <span class="pm-facet-label">{FACET_LABELS[key]}</span>
              {facets[key].map((f) => (
                <button
                  type="button"
                  class="pm-chip"
                  aria-pressed="false"
                  data-pm-facet={key}
                  data-pm-value={f.value}
                >
                  {f.label} <span class="pm-chip-count">({f.count})</span>
                </button>
              ))}
            </div>
          )
        ))}
        <div class="pm-status">
          <span data-pm-count aria-live="polite">
            Showing all {projects.length} {projects.length === 1 ? 'project' : 'projects'}
          </span>
          <button type="button" class="pm-reset" data-pm-reset hidden>Clear filters</button>
        </div>
      </div>

      <div class="pm-split">
        <ol class="pm-list" data-pm-list>
          {projects.map((p) => (
            <li>
              <button type="button" class="pm-row" data-project-id={p.id}>
                {p.photos[0]
                  ? <SmartImage src={p.photos[0].url} alt={p.photos[0].alt} />
                  : <span />}
                <span>
                  <h3>{p.title}</h3>
                  <p class="pm-meta">{p.completed_label} &middot; {p.project_type}</p>
                </span>
              </button>
            </li>
          ))}
        </ol>

        {/* Un-hidden by JS only once Leaflet loads and there is at least one
            pin, so no-JS users never see an empty grey box. */}
        <div class="pm-mapwrap" data-pm-map hidden aria-hidden="true">
          <div class="pm-map"></div>
        </div>
      </div>

      <p class="pm-empty" data-pm-empty hidden>No projects match those filters.</p>

      <div class="pm-grid" data-pm-grid>
        {projects.map((p) => (
          <figure class="pm-card" data-project-id={p.id}>
            {p.photos[0] && <SmartImage src={p.photos[0].url} alt={p.photos[0].alt} />}
            <figcaption>
              <h3>{p.title}</h3>
              <p class="pm-meta">
                {p.completed_label} &middot; {p.project_type}
                {p.products_used.length > 0 && <> &middot; {p.products_used.join(', ')}</>}
              </p>
              {p.description && <p class="pm-desc">{p.description}</p>}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
