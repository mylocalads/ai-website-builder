---
/**
 * The band directly under the hero.
 *
 * This slot used to hold PartnerBadges — a single 48px award insignia floating
 * on white, which read as an afterthought rather than a claim. The award now
 * lives large in the footer; this band carries the four promises instead,
 * which is what a visitor who has just read the hero is actually deciding on.
 *
 * Content is site.why_choose_us, unchanged — the same titles, icons and order
 * the WhyChooseUs section renders further down the page. Nothing is authored
 * here, so the band and the section can never disagree, and an operator who
 * edits one edits both.
 */
import { getEntry } from 'astro:content';
import { imageUrl } from '../lib/images.ts';

const site = (await getEntry('site', 'config')).data as any;
const items = (site.why_choose_us ?? []).slice(0, 4);

// Same image/emoji detection as WhyChooseUs: a localised icon is a bare
// filename, not a URL, so testing for a URL alone printed the filename.
const looksLikeImage = (s: unknown): s is string =>
  typeof s === 'string' && (/^https?:\/\//i.test(s) || /\.(png|jpe?g|webp|avif|gif|svg)$/i.test(s));

// Resolved up front: a template cannot await inside .map().
const iconUrls: (string | null)[] = await Promise.all(
  items.map((i: any) =>
    looksLikeImage(i.icon) ? imageUrl(i.icon, { width: 96 }) : Promise.resolve(null)
  )
);
const maskUrl = (idx: number) => {
  const u = iconUrls[idx];
  return u && (u.startsWith('/') || /^https?:\/\//i.test(u)) ? u : null;
};
---
{items.length > 0 && (
  <section class="trust-strip" aria-label="What you get with every job">
    <div class="container">
      <ul>
        {items.map((i: any, idx: number) => (
          <li>
            <span class="icon" aria-hidden="true">
              {maskUrl(idx) ? (
                <span class="icon-mask" style={`--mask: url(${maskUrl(idx)});`}></span>
              ) : (
                <span class="emoji">{i.icon}</span>
              )}
            </span>
            <span class="label">{i.title}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
  /* Light band against the dark hero above it, so the page opens up rather
     than staying heavy. The hairline top border is what keeps it reading as
     part of the hero block instead of a free-floating row. */
  .trust-strip {
    background: var(--color-surface);
    border-bottom: 1px solid rgba(10, 16, 20, 0.07);
    padding: var(--space-3) 0;
  }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: var(--space-2) var(--space-3); }
  li { display: flex; align-items: center; justify-content: center; gap: 0.85rem; text-align: left; }

  /* The icon sits in a soft teal disc rather than flat on the grey. At 10% the
     brand teal is light enough to stay quiet behind a solid teal glyph. */
  .icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.9rem; height: 2.9rem; flex-shrink: 0; border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent) 30%, transparent);
  }
  .icon-mask {
    width: 1.5rem; height: 1.5rem; display: inline-block;
    background-color: var(--color-accent);
    -webkit-mask: var(--mask) no-repeat center / contain;
    mask: var(--mask) no-repeat center / contain;
  }
  .emoji { font-size: 1.4rem; }
  .label { font-weight: 600; font-size: clamp(0.92rem, 1.25vw, 1.02rem); line-height: 1.3; color: var(--color-text); }

  /* Two per row on a phone. auto-fit collapses to one column at 375px, which
     turns four short promises into a tall list that pushes the page content
     below two full screens. */
  @media (max-width: 720px) {
    .trust-strip { padding: var(--space-4) 0; }
    ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3) var(--space-2); }
    li { flex-direction: column; justify-content: flex-start; text-align: center; gap: 0.55rem; }
    .label { font-size: 0.85rem; }
  }
</style>
