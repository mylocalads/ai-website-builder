---
/**
 * One image component for the whole site.
 *
 * Content collections store images as bare filenames in src/assets/images/
 * (see scripts/localize-images.mjs). Astro's <Image> needs an ImageMetadata
 * object, not a string, so the glob below resolves filename -> metadata at
 * build time. That is what unlocks sharp: resizing, WebP, a srcset, and
 * intrinsic width/height in the markup.
 *
 * Why width/height matter: without them the browser cannot reserve space
 * before the bytes arrive, so every image shifts the page as it loads. That is
 * the "image elements do not have explicit width and height" audit and a large
 * share of CLS. <Image> emits them automatically from the real file.
 *
 * Anything that is still an absolute URL (or a filename that did not resolve)
 * degrades to a plain <img>. A missing image must never fail the build of a
 * live customer site.
 *
 * `priority` marks the one above-the-fold image per page — it loads eagerly at
 * high fetch priority. Everything else stays lazy. Marking several images
 * priority is worse than marking none: it puts them all in contention.
 */
import { Image } from 'astro:assets';

interface Props {
  src?: string | null;
  alt?: string;
  class?: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  quality?: number;
  [key: string]: any;
}

const {
  src,
  alt = '',
  class: className,
  sizes = '(max-width: 768px) 100vw, 50vw',
  widths,
  priority = false,
  quality = 72,
  ...rest
} = Astro.props;

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpg,jpeg,png,webp,avif,gif}',
  { eager: true }
);

const isRemote = typeof src === 'string' && /^https?:\/\//.test(src);
const asset =
  src && !isRemote ? modules[`/src/assets/images/${src}`]?.default ?? null : null;

// Never upscale: Astro errors if a requested width exceeds the source, and an
// upscaled srcset candidate is wasted bytes for no visual gain.
const candidates = (widths ?? [400, 800, 1200, 1600]).filter((w) => asset && w < asset.width);
const finalWidths = asset ? [...new Set([...candidates, asset.width])].sort((a, b) => a - b) : undefined;

const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : 'auto';
---
{
  asset ? (
    <Image
      src={asset}
      alt={alt}
      class={className}
      widths={finalWidths}
      sizes={sizes}
      format="webp"
      quality={quality}
      loading={loading}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={fetchpriority}
      {...rest}
    />
  ) : src ? (
    <img
      src={src}
      alt={alt}
      class={className}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
      {...rest}
    />
  ) : null
}
