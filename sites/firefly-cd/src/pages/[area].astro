---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Hero from '../components/Hero.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import AboutSection from '../components/AboutSection.astro';
import Gallery from '../components/Gallery.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import OurServices from '../components/OurServices.astro';
import GHLReviewsWidget from '../components/GHLReviewsWidget.astro';
import Financing from '../components/Financing.astro';
import ServiceAreaGrid from '../components/ServiceAreaGrid.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import GHLChatWidget from '../components/GHLChatWidget.astro';
import { AREA_LIMIT, RESERVED_AREA_SLUGS, AREA_SLUG_PATTERN } from '../lib/limits.ts';

export async function getStaticPaths() {
  // getStaticPaths is hoisted into its own module at build time and cannot see
  // frontmatter-level consts — but it CAN see module imports, which is why the
  // caps and slug rules live in src/lib/limits.ts and are imported here. The
  // agent docs (/llms.txt, /index.md) import the same values, so they can never
  // advertise an area page this route did not build.
  const areas = await getCollection('service_areas');
  const validated = areas
    .sort((a, b) => a.data.order - b.data.order)
    .slice(0, AREA_LIMIT)
    .filter((a) => {
      const s = a.slug;
      if (RESERVED_AREA_SLUGS.has(s)) {
        console.warn(`[service_areas] Skipping "${s}" — reserved slug conflicts with a static route.`);
        return false;
      }
      if (!AREA_SLUG_PATTERN.test(s)) {
        console.warn(`[service_areas] Skipping "${s}" — must match city-state pattern (e.g. miami-fl).`);
        return false;
      }
      return true;
    });
  return validated.map((a) => ({ params: { area: a.slug }, props: { area: a } }));
}

const { area } = Astro.props;
const site = (await getEntry('site', 'config')).data as any;
const home = await getEntry('site', 'home').catch(() => null);
const homeFaqs = (home?.data as any)?.faqs ?? [];

const heroFormUrl = site.crm?.estimate_form_embed_url ?? site.crm?.contact_form_embed_url;

const title = `${site.business_name} — Serving ${area.data.name}, ${area.data.state}`;
const description = `${site.business_name} serves ${area.data.name}, ${area.data.state} with local, licensed service across ${area.data.neighborhoods.slice(0, 3).join(', ') || 'the metro area'}.`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Service Areas', href: '/service-areas' },
  { name: `${area.data.name}, ${area.data.state}`, href: `/${area.slug}` },
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: `Local ${site.tagline}`,
  provider: { '@type': 'LocalBusiness', name: site.business_name },
  areaServed: { '@type': 'AdministrativeArea', name: `${area.data.name}, ${area.data.state}` },
  description,
};
---
<BaseLayout
  title={title}
  description={description}
  breadcrumbs={crumbs}
  jsonLd={[serviceLd]}
  pagePath={`/${area.slug}`}
>
  <div class="container"><Breadcrumbs items={crumbs} /></div>
  <Hero
    eyebrow={`${area.data.name}, ${area.data.state}`}
    headline={`${site.business_name} — Serving ${area.data.name}, ${area.data.state}`}
    subheadline={area.data.local_context || `Local service across ${area.data.name} and surrounding communities.`}
    cta_text="Get Your Free Estimate!"
    cta_href="/book"
    photo={area.data.hero_photo}
    form_embed_url={heroFormUrl}
    form_title={`${area.data.name} estimate request`}
  />
  <PartnerBadges />
  <AboutSection
    eyebrow={`About ${area.data.name}`}
    heading={`Local roots in ${area.data.name}`}
    body={area.data.local_context || `${site.business_name} proudly serves ${area.data.name} and the surrounding areas with fast, honest, licensed work.`}
    photo={area.data.landmark_photo}
    photo_alt={area.data.landmark_alt ?? `${area.data.name} landmark`}
    photo_position="right"
  />
  <Gallery items={area.data.gallery ?? []} heading={`${area.data.name} work`} />
  <WhyChooseUs />
  <OurServices />
  <GHLReviewsWidget />
  <Financing />
  <ServiceAreaGrid />
  <FAQ items={homeFaqs} />
  <CTA headline="Need a roof inspection? Book a free inspection now!" cta_text="Get Your Free Estimate!" cta_href="/book" />
  <GHLChatWidget />
</BaseLayout>
