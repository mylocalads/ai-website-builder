---
import { getEntry } from 'astro:content';
import GHLFormEmbed from './GHLFormEmbed.astro';
import SMSConsent from './SMSConsent.astro';
import SmartImage from './SmartImage.astro';
import { getImage } from 'astro:assets';
export interface Props {
  eyebrow?: string;
  headline: string;
  subheadline: string;
  cta_text: string;
  cta_href: string;
  /** Optional quiet link beside the primary button, e.g. "See our work". */
  secondary_cta_text?: string;
  secondary_cta_href?: string;
  photo?: string;
  video?: string;
  form_embed_url?: string;
  form_title?: string;
}
const {
  eyebrow, headline, subheadline, cta_text, cta_href,
  secondary_cta_text, secondary_cta_href,
  photo, video, form_embed_url, form_title = 'Book now',
} = Astro.props;
const site = (await getEntry('site', 'config')).data as any;
const calendarSnippet = site.crm?.calendar_embed_snippet;
const heroPhoto = photo ?? site.default_hero_photo;
const heroVideo = video ?? site.default_hero_video;

/**
 * Proof points shown between the sub-copy and the button.
 *
 * Derived from config with exactly the same rules as TrustBadges.astro, and
 * from the same fields, so the two can never print different claims about the
 * same business. Nothing here is written by hand: if a fact is not in config,
 * it does not appear. That is deliberate — a hero is the worst place on the
 * site to assert a rating or a tenure that no source backs.
 */
const trustPoints: string[] = [
  site.licensed && site.insured && site.bonded
    ? 'Licensed, Insured & Bonded'
    : [site.licensed && 'Licensed', site.insured && 'Insured', site.bonded && 'Bonded'].filter(Boolean).join(', '),
  site.years_in_business && `${site.years_in_business}+ years serving ${site.address.city}`,
  site.rating && site.review_count && `${site.rating}★ from ${site.review_count} reviews`,
].filter(Boolean) as string[];

/**
 * The <video> poster needs a real URL, but content now stores images as bare
 * filenames, so it has to be resolved and optimised here. Without this the
 * poster attribute would emit the filename verbatim and 404.
 *
 * The poster matters more than it looks: on a hero video it is what the user
 * (and Lighthouse) sees until enough video has buffered, so on a throttled
 * mobile connection it is effectively the LCP element. Serving it as a sized
 * WebP rather than the original file is most of the win.
 */
const localImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpg,jpeg,png,webp,avif,gif}',
  { eager: true }
);
const heroAsset =
  heroPhoto && !/^https?:\/\//.test(heroPhoto)
    ? localImages[`/src/assets/images/${heroPhoto}`]?.default ?? null
    : null;
const posterUrl = heroAsset
  ? (await getImage({ src: heroAsset, width: 1600, format: 'webp', quality: 70 })).src
  : heroPhoto;
---
<section class="hero">
  {heroVideo ? (
    <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster={posterUrl}>
      <source src={heroVideo} type="video/mp4" />
    </video>
  ) : heroPhoto ? (
    /* A real <img>, not a CSS background. The browser's preload scanner finds
       an <img> in the raw HTML and can start fetching it before CSS has even
       parsed; a background-image is only discovered after the stylesheet loads
       and the rule matches. This is the hero — it IS the LCP element — so it
       gets priority and a responsive srcset instead of one full-size file. */
    <SmartImage
      src={heroPhoto}
      alt=""
      class="hero-photo"
      priority
      sizes="100vw"
      widths={[640, 1024, 1440, 1920]}
      quality={70}
    />
  ) : null}
  <div class="hero-overlay"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{headline}</h1>
      <p class="sub">{subheadline}</p>
      {trustPoints.length > 0 && (
        <ul class="trust-points">
          {trustPoints.map((p) => (
            <li>
              <svg class="tick" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{p}</span>
            </li>
          ))}
        </ul>
      )}
      <div class="actions">
        <a href={cta_href} class="cta">{cta_text}</a>
        {secondary_cta_text && secondary_cta_href && (
          <a href={secondary_cta_href} class="cta-secondary">{secondary_cta_text}</a>
        )}
      </div>
    </div>
    <div class="hero-form">
      {calendarSnippet ? (
        <div class="calendar-wrap">
          <Fragment set:html={calendarSnippet} />
        </div>
      ) : form_embed_url ? (
        <div class="form-wrap">
          <SMSConsent />
          <GHLFormEmbed embed_url={form_embed_url} title={form_title} />
        </div>
      ) : null}
    </div>
  </div>
</section>
<style>
  .hero { padding: var(--space-5) 0; color: white; position: relative; overflow: hidden; }
  .hero-video, .hero-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .hero-photo { object-position: center; }
  /* Weighted left, not a flat wash. The copy column needs a dark enough ground
     to hold white text at AA; the right-hand third does not, and dimming it
     evenly is what made the photo look like grey fog behind everything. */
  .hero-overlay {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(100deg, rgba(10,16,20,0.86) 0%, rgba(10,16,20,0.66) 45%, rgba(10,16,20,0.34) 100%);
  }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: var(--space-4); align-items: start; min-height: 480px; position: relative; z-index: 2; }
  .hero-copy { max-width: 36rem; padding-top: var(--space-3); }
  .eyebrow {
    text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.8rem; font-weight: 700;
    margin: 0 0 var(--space-2); color: var(--color-accent);
    display: inline-flex; align-items: center; gap: 0.6rem;
  }
  /* A short accent rule reading into the eyebrow — the one piece of ornament
     in the hero, and it echoes the brand mark rather than shouting. */
  .eyebrow::before { content: ''; width: 2rem; height: 2px; background: var(--color-accent); border-radius: 2px; }
  h1 { font-family: var(--font-display); font-size: clamp(2.25rem, 4.6vw, 3.9rem); line-height: 1.05; color: white; margin: 0 0 var(--space-2); text-shadow: 0 2px 14px rgba(0,0,0,0.35); }
  .sub { font-size: clamp(1.05rem, 1.4vw, 1.2rem); color: rgba(255,255,255,0.92); max-width: 34rem; margin: 0 0 var(--space-3); line-height: 1.6; }

  .trust-points { list-style: none; margin: 0 0 var(--space-3); padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); }
  .trust-points li { display: flex; align-items: center; gap: 0.5rem; font-size: 0.95rem; font-weight: 600; color: rgba(255,255,255,0.95); }
  .trust-points .tick { width: 1.15rem; height: 1.15rem; flex-shrink: 0; color: var(--color-accent); }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); }
  /* Dark ink on the brand teal. White on #00cfd1 is 1.94:1 and unreadable;
     --color-on-accent is 10.8:1 on the same fill. */
  .cta { display: inline-block; background: var(--color-accent); color: var(--color-on-accent); padding: 1rem 1.9rem; border-radius: var(--radius-sm); text-decoration: none; font-weight: 700; font-size: 1.05rem; letter-spacing: 0.01em; box-shadow: 0 10px 26px rgba(0, 207, 209, 0.32); transition: transform 0.15s ease, box-shadow 0.2s ease, filter 0.15s ease; }
  .cta:hover, .cta:focus-visible { transform: translateY(-2px); filter: brightness(1.06); box-shadow: 0 14px 32px rgba(0, 207, 209, 0.42); }
  .cta-secondary { color: white; font-weight: 600; font-size: 1rem; text-decoration: none; border-bottom: 2px solid rgba(255,255,255,0.45); padding-bottom: 2px; transition: border-color 0.15s ease, color 0.15s ease; }
  .cta-secondary:hover, .cta-secondary:focus-visible { color: var(--color-accent); border-bottom-color: var(--color-accent); }

  .hero-form { background: white; color: var(--color-text); border-radius: var(--radius-lg); padding: var(--space-2); box-shadow: 0 18px 44px rgba(10,16,20,0.34); }
  .calendar-wrap iframe { width: 100%; min-height: 500px; border: 0; }
  @media (max-width: 900px) { .hero-inner { grid-template-columns: 1fr; min-height: auto; } .hero-form { margin-top: var(--space-3); } }
  @media (max-width: 480px) { .trust-points { gap: var(--space-1) var(--space-2); } .trust-points li { font-size: 0.875rem; } }
</style>
