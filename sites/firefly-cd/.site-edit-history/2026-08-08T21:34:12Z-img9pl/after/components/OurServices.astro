---
import { getEntry, getCollection } from 'astro:content';
import { SERVICE_LIMIT } from '../lib/limits.ts';
import { imageUrl } from '../lib/images.ts';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order).slice(0, SERVICE_LIMIT);
const site = (await getEntry('site', 'config')).data as any;
const section = site.services_section ?? { eyebrow: 'Our Services' };

// Card backgrounds are CSS, so each filename has to be resolved to a real URL
// up front — a template cannot await inside .map(). These are tiles, not the
// LCP element, so one modest width is enough.
const cardBg = new Map(
  await Promise.all(
    services.map(async (s) => [s.slug, await imageUrl(s.data.hero_photo, { width: 800 })] as const)
  )
);
---
<section id="services" class="our-services" aria-label="Services">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{section.eyebrow}</p>
      <h2>{section.heading_lead ? `${section.heading_lead} ${section.heading_rest ?? ''}`.trim() : 'Our services'}</h2>
      {section.subtitle && <p class="subtitle">{section.subtitle}</p>}
    </div>
    <div class="grid">
      {services.map((s) => (
        <a
          href={`/services/${s.slug}`}
          class="card"
          style={cardBg.get(s.slug) && `background-image: linear-gradient(rgba(15,20,25,0.20) 0%, rgba(15,20,25,0.85) 100%), url(${cardBg.get(s.slug)});`}
        >
          <div class="card-inner">
            <h3 class="tile-title">{s.data.title}</h3>
            <span class="btn">Learn More</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  .our-services { padding: var(--space-5) 0; }
  .section-head { text-align: center; max-width: 780px; margin: 0 auto var(--space-4); }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.9rem; font-weight: 600; color: var(--color-accent); margin: 0 0 var(--space-1); }
  h2 { font-family: var(--font-display); font-weight: 700; color: var(--color-text); font-size: clamp(1.85rem, 3.5vw, 3rem); line-height: 1.15; margin: 0 0 var(--space-2); }
  .subtitle { color: var(--color-muted); font-size: 1.05rem; margin: 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-3); }
  .card {
    display: block; aspect-ratio: 4 / 3; background: var(--color-surface);
    background-size: cover; background-position: center; background-repeat: no-repeat;
    border-radius: 14px; text-decoration: none; color: white; position: relative; overflow: hidden;
    box-shadow: 0 8px 22px rgba(15,20,25,0.08);
    transition: transform 0.2s ease, box-shadow 0.25s ease;
  }
  .card:hover, .card:focus-visible {
    transform: translateY(-5px);
    box-shadow: 0 18px 42px rgba(15,20,25,0.22), 0 4px 12px rgba(0, 207, 209, 0.15);
  }
  .card-inner { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: var(--space-3); text-align: center; gap: var(--space-2); }
  .tile-title { margin: 0; font-family: var(--font-display); font-weight: 700; color: white; font-size: clamp(1.35rem, 2.2vw, 1.9rem); line-height: 1.15; }
  .btn { display: inline-block; background: var(--color-accent); color: white; padding: 0.7rem 1.4rem; border-radius: var(--radius-sm); font-size: 0.95rem; font-weight: 600; font-family: var(--font-body); letter-spacing: 0.01em; box-shadow: 0 4px 14px rgba(0,0,0,0.18); }
</style>
