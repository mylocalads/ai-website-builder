---
import SmartImage from './SmartImage.astro';
import { getEntry } from 'astro:content';
const site = (await getEntry('site', 'config')).data as any;
const partners = site.partners ?? [];
---
{partners.length > 0 && (
  <section class="partners" aria-label="Trusted partners">
    <div class="container">
      <ul>
        {partners.map((p: any) => (
          <li>
            {p.link_url ? (
              <a href={p.link_url} rel="noopener" target="_blank"><SmartImage src={p.logo_url} alt={p.name} /></a>
            ) : (
              <SmartImage src={p.logo_url} alt={p.name} />
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
  .partners { padding: var(--space-3) 0; border-top: 1px solid var(--color-surface); border-bottom: 1px solid var(--color-surface); }
  ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-4); justify-content: center; align-items: center; }
  img { max-height: 48px; width: auto; opacity: 0.8; filter: grayscale(0.2); }
  a:hover img, a:focus-visible img { opacity: 1; filter: none; }
</style>
