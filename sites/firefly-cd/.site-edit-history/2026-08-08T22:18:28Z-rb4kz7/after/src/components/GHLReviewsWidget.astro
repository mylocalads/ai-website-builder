---
/**
 * GHL reviews widget, mounted when it scrolls into view.
 *
 * This section sits well below the fold on every page that uses it, yet its
 * loader ran during initial parse. Same treatment as the chat widget: the
 * pasted snippet is reproduced verbatim in a <template> and moved into the DOM
 * only when the section is close to the viewport, so a visitor who never
 * scrolls that far never pays for it.
 *
 * The <section> and heading still render server-side, so the page structure,
 * the layout, and the crawlable heading are unaffected — only the third-party
 * iframe and its script are deferred.
 *
 * A min-height is reserved so the widget arriving does not shove the footer
 * down and register as layout shift.
 */
import { getEntry } from 'astro:content';
const site = (await getEntry('site', 'config')).data as any;
const snippet = site.crm?.reviews_widget_snippet;
---
{snippet && (
  <section class="reviews" aria-label="Reviews">
    <div class="container">
      <h2>Client reviews</h2>
      <div class="reviews-slot" data-reviews-slot></div>
      <template data-deferred-widget="reviews" set:html={snippet} />
    </div>
  </section>
)}
<script>
  (() => {
    const tpl = document.querySelector('template[data-deferred-widget="reviews"]');
    const slot = document.querySelector('[data-reviews-slot]');
    if (!tpl || !slot) return;

    let mounted = false;
    const mount = () => {
      if (mounted) return;
      mounted = true;

      const frag = (tpl as HTMLTemplateElement).content.cloneNode(true) as DocumentFragment;
      // Cloned scripts are inert; recreate them so they execute.
      frag.querySelectorAll('script').forEach((old) => {
        const s = document.createElement('script');
        for (const { name, value } of Array.from(old.attributes)) s.setAttribute(name, value);
        s.textContent = old.textContent;
        old.replaceWith(s);
      });
      slot.appendChild(frag);
    };

    if (!('IntersectionObserver' in window)) {
      mount(); // Old browser: correctness over speed.
      return;
    }

    // 400px of lead-in so the widget is usually painted by the time it is read.
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          mount();
        }
      },
      { rootMargin: '400px 0px' }
    );
    io.observe(slot);

    // Backstop. IntersectionObserver does not fire in every context — a
    // background or non-rendered tab will not deliver callbacks at all, and
    // that was reproducible while verifying this component. Without a fallback
    // the reviews would silently never appear, which is a worse failure than
    // loading them a little early. Mount unconditionally after a delay long
    // enough to stay clear of the critical path.
    const backstop = setTimeout(mount, 6000);
    const clearBackstop = () => clearTimeout(backstop);
    ['pointerdown', 'keydown', 'touchstart'].forEach((e) =>
      window.addEventListener(e, () => { clearBackstop(); mount(); }, { once: true, passive: true })
    );
  })();
</script>
<style>
  .reviews { padding: var(--space-5) 0; }
  /* Reserve space so the deferred widget does not shift the page when it lands. */
  .reviews-slot { min-height: 420px; }
</style>
