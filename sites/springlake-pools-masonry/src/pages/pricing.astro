---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import HeroOwl from '../components/HeroOwl.astro';
import PricingTable from '../components/PricingTable.astro';
import Financing from '../components/Financing.astro';
import FAQ from '../components/FAQ.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import GHLChatWidget from '../components/GHLChatWidget.astro';

const site = (await getEntry('site', 'config')).data as any;
const pricingEntry = await getEntry('site', 'pricing').catch(() => null);
const pricing = (pricingEntry?.data as any) ?? { intro: 'Straightforward pricing.', packages: [], notes: undefined };
const homeEntry = await getEntry('site', 'home').catch(() => null);
const faqs = (homeEntry?.data as any)?.faqs ?? [];
const calendarSnippet = site.crm?.calendar_embed_snippet;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Pricing', href: '/pricing' }];

// Deliberately NOT a price table. Publishing a dollar range for a custom
// concrete pool would be a fabricated number — the figure moves too much with
// soil, access, decking and features. These are the real variables instead.
const costFactors = [
  { type: 'Size, depth and shape', detail: 'Surface area and depth drive material and excavation volume. A curved or multi-level shell costs more to form than a rectangle.' },
  { type: 'Soil and site access', detail: 'Rocky ledge, clay and hillside grades all change the dig. So does whether an excavator can actually reach the backyard.' },
  { type: 'Decking and masonry', detail: 'Coping, pavers, retaining walls, fire pits and outdoor kitchens are frequently a larger line than people expect — and often the biggest visual return.' },
  { type: 'Features and equipment', detail: 'Integrated spas, water features, sun ledges, automation, heaters and lighting each add scope. Saltwater and chlorine systems price differently.' },
];
---
<BaseLayout
  title={`Pricing — ${site.business_name}`}
  description={`How custom concrete pools, renovations, repairs and seasonal service are quoted by ${site.business_name} in ${site.address.city}, ${site.address.state}.`}
  breadcrumbs={crumbs}
  pagePath="/pricing"
>
  <HeroOwl
    eyebrow="Transparent Pricing"
    headline="Pricing"
    subheadline={pricing.intro}
    cta_text="Get My Free Consultation!"
    cta_href="/book"
    photo={site.default_hero_photo}
    show_form
    form_heading="Get a price for your project"
  />

  <section class="cost-factors">
    <div class="container">
      <h2>What actually moves the number</h2>
      <p class="lede">We do not publish pool prices, because a figure on a web page for a custom concrete pool is a guess. Here is what we are measuring when we quote yours.</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Factor</th><th>Why it matters</th></tr>
          </thead>
          <tbody>
            {costFactors.map((r) => (
              <tr><td>{r.type}</td><td>{r.detail}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="factors"><strong>Renovation, repair and service are quoted the same way:</strong> we look at the pool first, then price it. Resurfacing, tile, coping, leak detection and seasonal service all depend on what condition the shell and equipment are actually in.</p>
    </div>
  </section>

  {pricing.packages.length > 0 && <PricingTable packages={pricing.packages} />}
  {pricing.notes && (
    <section class="pricing-notes">
      <div class="container"><p>{pricing.notes}</p></div>
    </section>
  )}

  {calendarSnippet && (
    <section class="book">
      <div class="container">
        <h2>Book your free on-site estimate</h2>
        <p class="lede">Pick a time that works — we come out, walk the property, take real measurements and give you a written estimate.</p>
        <div class="calendar-wrap"><Fragment set:html={calendarSnippet} /></div>
      </div>
    </section>
  )}

  <Financing />
  <FAQ items={faqs} />
  <ClosingCTA />
  <GHLChatWidget />
</BaseLayout>
<style>
  .pricing-hero { padding: var(--space-5) 0; background-size: cover; background-position: center; background-repeat: no-repeat; color: white; }
  .pricing-hero h1 { color: white; font-size: clamp(2rem, 4vw, 3rem); text-shadow: 0 2px 8px rgba(0,0,0,0.3); }
  .pricing-hero p { color: rgba(255,255,255,0.9); font-size: 1.15rem; max-width: 45rem; }
  .cost-factors { padding: var(--space-5) 0; background: var(--color-surface); }
  .cost-factors h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); }
  .cost-factors .lede { color: var(--color-muted); max-width: 45rem; margin: 0 0 var(--space-3); }
  .table-wrap { overflow-x: auto; margin: var(--space-2) 0; }
  .cost-factors table { width: 100%; border-collapse: collapse; background: var(--color-bg); border-radius: var(--radius-md); overflow: hidden; }
  .cost-factors th, .cost-factors td { padding: var(--space-2); text-align: left; border-bottom: 1px solid var(--color-surface); }
  .cost-factors th { background: var(--color-text); color: white; font-family: var(--font-display); font-weight: 600; }
  .cost-factors tbody tr:last-child td { border-bottom: 0; }
  .cost-factors .factors { margin-top: var(--space-3); color: var(--color-muted); }
  .pricing-notes { padding: var(--space-3) 0; color: var(--color-muted); font-size: 0.95rem; }
  .book { padding: var(--space-5) 0; }
  .book h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); }
  .book .lede { color: var(--color-muted); max-width: 45rem; margin: 0 0 var(--space-3); }
  .calendar-wrap iframe { width: 100%; min-height: 700px; border: 0; }
</style>
