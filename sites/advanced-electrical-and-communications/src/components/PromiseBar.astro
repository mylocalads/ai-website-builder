---
import { getIcon } from '../lib/icons';

type Item = string | { text: string; icon?: string };
export interface Props { items?: Item[]; }
const { items = [] } = Astro.props;

// Accepts plain strings (legacy content) or { text, icon } objects.
const normalized = items.map((i) => (typeof i === 'string' ? { text: i, icon: undefined } : i));
---
{normalized.length > 0 && (
  <section class="promise-bar" aria-label="What sets us apart">
    <div class="container">
      <ul>
        {normalized.map((item) => {
          const svg = getIcon(item.icon);
          return (
            <li>
              {svg && (
                <span class="icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor" set:html={svg} />
                </span>
              )}
              <span class="label">{item.text}</span>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}
<style>
  .promise-bar { background: var(--color-primary); color: var(--color-on-primary); padding: var(--space-3) 0; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-2) var(--space-3); }
  li { display: flex; align-items: center; justify-content: center; gap: 0.75rem; text-align: left; }
  .icon { display: inline-flex; align-items: center; justify-content: center; width: 2.75rem; height: 2.75rem; flex-shrink: 0; border-radius: 50%; background: var(--color-accent); color: var(--color-on-accent); }
  .icon svg { width: 1.5rem; height: 1.5rem; }
  .label { font-weight: 600; letter-spacing: 0.02em; font-size: clamp(0.95rem, 1.5vw, 1.1rem); line-height: 1.3; text-transform: capitalize; }
  @media (max-width: 700px) { li { justify-content: flex-start; } }
</style>
