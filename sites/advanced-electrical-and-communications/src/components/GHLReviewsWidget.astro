---
import { getEntry } from 'astro:content';
const site = (await getEntry('site', 'config')).data as any;
const snippet = site.crm?.reviews_widget_snippet;
---
{snippet && (
  <section class="reviews" aria-label="Reviews">
    <div class="container">
      <h2>Client reviews</h2>
      <Fragment set:html={snippet} />
    </div>
  </section>
)}
<style>
  .reviews { padding: var(--space-5) 0; }
</style>
