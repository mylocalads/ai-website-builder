---
export interface Props {
  data?: {
    eyebrow?: string;
    headline: string;
    intro?: string;
    blocks?: Array<{ title: string; body: string; icon?: string; image?: string }>;
    steps_title?: string;
    steps_icon?: string;
    steps?: Array<{ title: string; body: string }>;
    guarantee?: {
      title: string;
      body: string;
      cta_text?: string;
      cta_href?: string;
      badge_image?: string;
      badge_alt?: string;
    };
  };
}
const { data } = Astro.props;
const blocks = data?.blocks ?? [];
const steps = data?.steps ?? [];

import { getIcon } from '../lib/icons';
const hasIcon = (k?: string) => getIcon(k) !== null;

/**
 * SITE OVERRIDE — GreenTree Inc.
 *
 * GO GREENTREE is an ACROSTIC: the nine block titles begin G, R, E, E, N, T, R,
 * E, E. The template's generic three-up (block, steps, block) plus an icon
 * circle per card throws that away — it renders nine near-identical tiles whose
 * one distinguishing feature is a repeated shield/calendar glyph, and the
 * structure that makes the section mean anything is invisible.
 *
 * So the letter IS the visual anchor. It is DERIVED from each title's first
 * character rather than stored in content, because the schema has no `letter`
 * field (zod would strip it) and because a stored letter can silently drift out
 * of sync with the title it is supposed to spell. Deriving it means the acrostic
 * can never be wrong: if someone rewrites a title, the letter follows.
 *
 * This site has no `steps`, so the template's steps card never rendered and the
 * three-up degraded to a 2-then-7 split. Here every block is one tile in one
 * even grid. The steps card is kept for the case where a future edit adds steps.
 */
const acrostic = blocks.map((b) => ({ ...b, letter: (b.title ?? '').trim().charAt(0).toUpperCase() }));
const isAcrostic = blocks.length > 2 && steps.length === 0 && acrostic.every((b) => /^[A-Z]$/.test(b.letter));
---
{data && (
  <section class="signature" aria-label={data.headline}>
    <div class="container">
      <div class="head">
        {data.eyebrow && <p class="eyebrow">{data.eyebrow}</p>}
        <h2>{data.headline}</h2>
        {data.intro && <p class="intro">{data.intro}</p>}
      </div>

      {isAcrostic ? (
        <ol class="acrostic">
          {acrostic.map((b) => (
            <li class="letter-card">
              <span class="letter" aria-hidden="true">{b.letter}</span>
              <div class="letter-copy">
                <h3>{b.title}</h3>
                <p>{b.body}</p>
              </div>
            </li>
          ))}
        </ol>
      ) : (
      <>
      <div class="cards">
        {blocks[0] && (
          <article class="card">
            {blocks[0].image
              ? <img class="card-img" src={blocks[0].image} alt="" loading="lazy" />
              : hasIcon(blocks[0].icon) && (
                  <span class="icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor" set:html={getIcon(blocks[0].icon)!} />
                  </span>
                )}
            <h3>{blocks[0].title}</h3>
            <p>{blocks[0].body}</p>
          </article>
        )}

        {steps.length > 0 && (
          <article class="card steps-card">
            {hasIcon(data.steps_icon) && (
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor" set:html={getIcon(data.steps_icon)!} />
              </span>
            )}
            {data.steps_title && <h3 class="steps-title">{data.steps_title}</h3>}
            <ol>
              {steps.map((s) => (
                <li>
                  <h4>{s.title}</h4>
                  <p>{s.body}</p>
                </li>
              ))}
            </ol>
          </article>
        )}

        {blocks[1] && (
          <article class="card">
            {blocks[1].image
              ? <img class="card-img" src={blocks[1].image} alt="" loading="lazy" />
              : hasIcon(blocks[1].icon) && (
                  <span class="icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor" set:html={getIcon(blocks[1].icon)!} />
                  </span>
                )}
            <h3>{blocks[1].title}</h3>
            <p>{blocks[1].body}</p>
          </article>
        )}
      </div>

      {blocks.length > 2 && (
        <div class="cards extra">
          {blocks.slice(2).map((b) => (
            <article class="card">
              {b.image
                ? <img class="card-img" src={b.image} alt="" loading="lazy" />
                : hasIcon(b.icon) && (
                    <span class="icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="currentColor" set:html={getIcon(b.icon)!} />
                    </span>
                  )}
              <h3>{b.title}</h3>
              <p>{b.body}</p>
            </article>
          ))}
        </div>
      )}
      </>
      )}

      {data.guarantee && (
        <div class={`guarantee ${data.guarantee.badge_image ? 'has-badge' : ''}`}>
          {data.guarantee.badge_image && (
            <img class="badge" src={data.guarantee.badge_image} alt={data.guarantee.badge_alt ?? ''} loading="lazy" />
          )}
          <div class="guarantee-copy">
            <h3>{data.guarantee.title}</h3>
            <p>{data.guarantee.body}</p>
            {data.guarantee.cta_text && data.guarantee.cta_href && (
              <a class="btn" href={data.guarantee.cta_href}>{data.guarantee.cta_text}</a>
            )}
          </div>
        </div>
      )}
    </div>
  </section>
)}
<style>
  /* SITE OVERRIDE — the acrostic grid. See the script comment above for why the
     letter, not an icon, is the anchor. */
  .signature { padding: var(--space-5) 0; background: var(--color-bg); }

  .acrostic { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-3); }

  .letter-card {
    position: relative; display: grid; grid-template-columns: auto 1fr; gap: var(--space-3);
    align-items: start; background: var(--color-surface); border-radius: var(--radius-lg);
    padding: var(--space-3); overflow: hidden;
    box-shadow: 0 6px 18px rgba(15,20,25,0.07);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  /* A hairline of brand green down the leading edge, thickening on hover. Cheaper
     and calmer than a full coloured border, and it ties nine separate tiles into
     one system. */
  .letter-card::before {
    content: ''; position: absolute; inset: 0 auto 0 0; width: 4px;
    background: var(--color-accent); transition: width 0.25s ease;
  }
  .letter-card:hover { transform: translateY(-4px); box-shadow: 0 16px 34px rgba(15,20,25,0.16); }
  .letter-card:hover::before { width: 7px; }

  /* The letter is the tile's identity, so it gets display type at a size nothing
     else on the page uses. aria-hidden because "G" read aloud before the heading
     is noise — the heading already carries the meaning. */
  .letter {
    display: flex; align-items: center; justify-content: center;
    width: 3.6rem; height: 3.6rem; flex-shrink: 0; border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-accent) 16%, transparent);
    color: var(--color-accent-ink);
    font-family: var(--font-display); font-weight: 700; font-size: 2.1rem; line-height: 1;
    transition: background 0.25s ease, color 0.25s ease;
  }
  .letter-card:hover .letter { background: var(--color-accent); color: var(--color-on-accent); }

  .letter-copy { min-width: 0; }
  .letter-copy h3 { font-family: var(--font-display); font-size: 1.1rem; line-height: 1.3; margin: 0.25rem 0 0.5rem; color: var(--color-text); text-transform: none; }
  .letter-copy p { margin: 0; color: var(--color-muted); line-height: 1.65; font-size: 0.97rem; }

  @media (max-width: 480px) {
    .letter-card { grid-template-columns: 1fr; gap: var(--space-2); padding: var(--space-3) var(--space-3) var(--space-3) calc(var(--space-3) + 4px); }
    .letter { width: 3rem; height: 3rem; font-size: 1.8rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .letter-card, .letter-card::before, .letter { transition: none; }
    .letter-card:hover { transform: none; }
  }

  .head { max-width: 820px; margin: 0 auto var(--space-4); text-align: center; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.9rem; font-weight: 600; color: var(--color-accent-ink); margin: 0 0 var(--space-1); }
  h2 { font-family: var(--font-display); font-weight: 700; color: var(--color-text); font-size: clamp(1.85rem, 3.5vw, 3rem); line-height: 1.15; margin: 0 0 var(--space-2); text-transform: uppercase; letter-spacing: 0.01em; }
  .intro { color: var(--color-muted); font-size: 1.05rem; line-height: 1.7; margin: 0; }

  /* Three-up: explainer card, numbered steps, explainer card. */
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-3); align-items: start; }
  .cards.extra { margin-top: var(--space-3); }
  .card { background: var(--color-surface); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-3); box-shadow: 0 8px 22px rgba(15,20,25,0.08); height: 100%; }
  .card h3 { font-family: var(--font-display); font-size: 1.35rem; margin: 0 0 var(--space-2); color: var(--color-text); text-transform: capitalize; }
  .card p { margin: 0; color: var(--color-muted); line-height: 1.7; }
  .card-img { width: 100%; border-radius: var(--radius-md); aspect-ratio: 16/10; object-fit: cover; margin-bottom: var(--space-3); }

  .icon { display: inline-flex; align-items: center; justify-content: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; background: var(--color-accent); color: var(--color-on-accent); margin-bottom: var(--space-3); }
  .icon svg { width: 1.9rem; height: 1.9rem; }

  .steps-card { background: var(--color-bg); border: 1px solid rgba(0,0,0,0.10); }
  .steps-title { font-size: 1.35rem; margin: 0 0 var(--space-3); }
  .steps-card ol { list-style: none; counter-reset: step; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .steps-card li { counter-increment: step; display: grid; grid-template-columns: 2rem 1fr; gap: 0.85rem; align-items: start; }
  .steps-card li::before { content: counter(step); display: flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--color-accent); color: var(--color-on-accent); font-family: var(--font-display); font-weight: 700; font-size: 1rem; }
  /* The ::before counter occupies column 1; both h4 and p must be pinned to
     column 2 or auto-placement drops the <p> into the 2rem counter column. */
  .steps-card h4 { grid-column: 2; font-size: 1.02rem; margin: 0.15rem 0 0.25rem; color: var(--color-text); text-transform: capitalize; }
  .steps-card p { grid-column: 2; font-size: 0.95rem; line-height: 1.6; }

  .guarantee { margin-top: var(--space-4); background: var(--color-primary); color: var(--color-on-primary); border-radius: var(--radius-lg); padding: var(--space-4); }
  .guarantee.has-badge { display: grid; grid-template-columns: minmax(140px, 220px) 1fr; gap: var(--space-4); align-items: center; }
  @media (max-width: 720px) { .guarantee.has-badge { grid-template-columns: 1fr; justify-items: center; text-align: center; } }
  .badge { width: 100%; max-width: 220px; height: auto; }
  .guarantee h3 { font-family: var(--font-display); font-size: clamp(1.4rem, 2.6vw, 2rem); margin: 0 0 var(--space-2); color: var(--color-on-primary); text-transform: capitalize; }
  .guarantee p { margin: 0 0 var(--space-3); line-height: 1.7; }
  .btn { display: inline-block; background: var(--color-accent); color: var(--color-on-accent); padding: 0.9rem 1.75rem; border-radius: var(--radius-sm); font-weight: 700; font-size: 1.25rem; text-decoration: none; text-transform: uppercase; }
</style>
