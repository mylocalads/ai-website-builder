---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import HeroOwl from '../components/HeroOwl.astro';
import PricingTable from '../components/PricingTable.astro';
import Financing from '../components/Financing.astro';
import FAQ from '../components/FAQ.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import GHLChatWidget from '../components/GHLChatWidget.astro';

const site = (await getEntry('site', 'config')).data as any;
const pricingEntry = await getEntry('site', 'pricing').catch(() => null);
const pricing = (pricingEntry?.data as any) ?? { intro: 'Straightforward pricing.', packages: [], notes: undefined };
const homeEntry = await getEntry('site', 'home').catch(() => null);
const faqs = (homeEntry?.data as any)?.faqs ?? [];
const calendarSnippet = site.crm?.calendar_embed_snippet;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Pricing', href: '/pricing' }];

// No published price table. This client's work spans a deck over an existing
// slab through a whole-home remodel, and inventing a "typical" range for that
// spread would be a made-up number on a page whose entire promise is that we
// don't do that. What drives the number is real and useful, so that ships
// instead.
const costFactors = [
  {
    type: 'Decks, porches & pavilions',
    drivers: 'Size and height, footing depth and count, whether there is a tear-off first, decking material (pressure-treated vs. composite), railing system, stairs, and whether the structure is covered.',
  },
  {
    type: 'Concrete patios & sidewalks',
    drivers: 'Square footage, excavation and base prep, thickness and reinforcement, plain vs. stamped or decorative finish, color and sealer, and site access for the truck.',
  },
  {
    type: 'Remodels, additions & new construction',
    drivers: 'Scope and how much comes out before anything goes in, structural changes, whether mechanicals move, material and fixture selections, permit requirements, and what we find behind the walls in an older home.',
  },
  {
    type: 'Hardwood floor refinishing',
    drivers: 'Square footage, species and condition, how many rooms and stairs, whether there is carpet or adhesive to remove, stain color matching, and the number of top coats and sheen you choose.',
  },
];
---
<BaseLayout
  title={`Pricing — ${site.business_name}`}
  description={`How we price decks, patios, remodels and floor refinishing across ${site.marketing_city ?? site.address.city}, ${site.marketing_state ?? site.address.state} — free written estimates, no surprise line items.`}
  breadcrumbs={crumbs}
  pagePath="/pricing"
>
  <HeroOwl
    eyebrow="Transparent Pricing"
    headline="Pricing"
    subheadline={pricing.intro}
    cta_text="Get Your Free Estimate!"
    cta_href="/book"
    photo={site.default_hero_photo}
    show_form
    form_heading="Get a price for your project"
  />

  <section class="roof-cost">
    <div class="container">
      <h2>What actually drives the number</h2>
      <p class="lede">Two projects that look identical from the street can be thousands apart once you get underneath them. Here is exactly what we are looking at when we work out your number, so nothing on the estimate arrives as a surprise.</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Project type</th><th>What the price depends on</th></tr>
          </thead>
          <tbody>
            {costFactors.map((r) => (
              <tr><td>{r.type}</td><td>{r.drivers}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="factors"><strong>What you get either way:</strong> a free consultation, a written scope naming what is and isn't included, and a number you can compare against anyone else's — with any material choice that would change it called out before you decide.</p>
    </div>
  </section>

  {pricing.packages.length > 0 && <PricingTable packages={pricing.packages} />}
  {pricing.notes && (
    <section class="pricing-notes">
      <div class="container"><p>{pricing.notes}</p></div>
    </section>
  )}

  {calendarSnippet && (
    <section class="book">
      <div class="container">
        <h2>Book your free on-site estimate</h2>
        <p class="lede">Pick a time that works — we come out, walk the project with you, and put a written scope and number in your hand.</p>
        <div class="calendar-wrap"><Fragment set:html={calendarSnippet} /></div>
      </div>
    </section>
  )}

  <Financing />
  <FAQ items={faqs} />
  <ClosingCTA />
  <GHLChatWidget />
</BaseLayout>
<style>
  .pricing-hero { padding: var(--space-5) 0; background-size: cover; background-position: center; background-repeat: no-repeat; color: white; }
  .pricing-hero h1 { color: white; font-size: clamp(2rem, 4vw, 3rem); text-shadow: 0 2px 8px rgba(0,0,0,0.3); }
  .pricing-hero p { color: rgba(255,255,255,0.9); font-size: 1.15rem; max-width: 45rem; }
  .roof-cost { padding: var(--space-5) 0; background: var(--color-surface); }
  .roof-cost h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); }
  .roof-cost .lede { color: var(--color-muted); max-width: 45rem; margin: 0 0 var(--space-3); }
  .table-wrap { overflow-x: auto; margin: var(--space-2) 0; }
  .roof-cost table { width: 100%; border-collapse: collapse; background: var(--color-bg); border-radius: var(--radius-md); overflow: hidden; }
  .roof-cost th, .roof-cost td { padding: var(--space-2); text-align: left; border-bottom: 1px solid var(--color-surface); }
  .roof-cost th { background: var(--color-text); color: white; font-family: var(--font-display); font-weight: 600; }
  .roof-cost tbody tr:last-child td { border-bottom: 0; }
  .roof-cost .factors { margin-top: var(--space-3); color: var(--color-muted); }
  .pricing-notes { padding: var(--space-3) 0; color: var(--color-muted); font-size: 0.95rem; }
  .book { padding: var(--space-5) 0; }
  .book h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); }
  .book .lede { color: var(--color-muted); max-width: 45rem; margin: 0 0 var(--space-3); }
  .calendar-wrap iframe { width: 100%; min-height: 700px; border: 0; }
</style>
