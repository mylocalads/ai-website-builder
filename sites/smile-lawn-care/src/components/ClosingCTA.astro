---
export interface Props {
  headline?: string;
  body?: string;
  cta_text?: string;
  cta_href?: string;
  photo?: string;
}
// Defaults live here rather than at each call site. There are eleven of these
// across the template, and when every page passed its own strings the copy
// drifted — three different headlines and two different button labels for the
// same action. Pages with a genuinely different ask (a phone CTA on /book, the
// post-submission page) still override.
const {
  headline = 'Ready For A Free Estimate? Book Your Visit Now.',
  body = "A free on-site estimate, a written price before anything starts, and a crew that turns up on the day it said it would. Serving Wilkes-Barre and the Wyoming Valley.",
  cta_text = 'Get Free Estimate',
  cta_href = '/book',
  photo,
} = Astro.props;
---
<section
  class:list={['closing-cta', photo && 'has-photo']}
  aria-label={headline}
  style={photo ? `background-image: linear-gradient(rgba(15,20,25,0.72), rgba(15,20,25,0.72)), url(${photo});` : undefined}
>
  <div class="container inner">
    <h2>{headline}</h2>
    {body && <p class="body">{body}</p>}
    <a class="btn" href={cta_href}>{cta_text}</a>
  </div>
</section>
<style>
  .closing-cta { background-color: var(--color-primary); background-size: cover; background-position: center; color: var(--color-on-primary); padding: var(--space-5) 0; }
  .inner { text-align: center; display: grid; gap: var(--space-3); justify-items: center; }
  h2 { font-family: var(--font-display); font-weight: 700; color: var(--color-on-primary); font-size: clamp(1.85rem, 4.2vw, 3.25rem); line-height: 1.1; margin: 0; text-transform: uppercase; letter-spacing: 0.01em; max-width: 20ch; }
  .body { margin: 0; max-width: 60ch; color: var(--color-on-primary); opacity: 0.82; font-size: 1.05rem; line-height: 1.7; }
  .btn { display: inline-block; background: var(--color-accent); color: var(--color-on-accent); padding: 1rem 2.25rem; border-radius: var(--radius-sm); font-weight: 700; font-size: 1.25rem; letter-spacing: 0.02em; text-decoration: none; box-shadow: 0 4px 14px rgba(0,0,0,0.22); text-transform: uppercase; border: 2px solid var(--color-accent-edge); }

  /* Light primary: the no-photo band is yellow and takes --color-on-primary
     (near-black). The photo variant paints a dark scrim instead, where
     near-black would be unreadable — so that branch flips back to white.
     No call site passes a photo today; this keeps the prop from becoming a trap. */
  .closing-cta.has-photo { color: #ffffff; }
  .closing-cta.has-photo h2 { color: #ffffff; }
  .closing-cta.has-photo .body { color: #ffffff; opacity: 0.92; }
</style>
