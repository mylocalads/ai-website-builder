---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import HeroOwl from '../components/HeroOwl.astro';
import PromiseBar from '../components/PromiseBar.astro';
import ServicesGridOwl from '../components/ServicesGridOwl.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import PromiseBand from '../components/PromiseBand.astro';
import SignatureSystem from '../components/SignatureSystem.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import AboutOwl from '../components/AboutOwl.astro';
import VideoSection from '../components/VideoSection.astro';
import SocialEmbed from '../components/SocialEmbed.astro';
import FAQ from '../components/FAQ.astro';
import BlogCards from '../components/BlogCards.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import GHLChatWidget from '../components/GHLChatWidget.astro';

const site = (await getEntry('site', 'config')).data as any;
const home = (await getEntry('site', 'home')).data as any;

// One CTA string reused across every section so the page never drifts.
/* Pulled from config rather than hardcoded. "Get Your Free Estimate!" is right
   for a contractor and wrong for a wholesale food producer — the client does not
   quote estimates, they take supply enquiries. Falls back to the old literal so
   contractor sites are unchanged. */
const CTA_TEXT = site.closing_cta?.cta_text ?? 'Get My Free Estimate!';
const CTA_HREF = '/book';

const faqJsonLd = home.faqs && home.faqs.length > 0 ? {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: home.faqs.map((f: any) => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;
---
<!--
  FIXED section order for the owl template. Do not reorder or randomize.
  Stock owl order:
  hero → promise-bar → services-grid → testimonials → promise-band →
  signature-system → process-steps → about → seo-body → faq → blog-cards →
  closing-cta → footer

  THIS SITE deviates in four operator-directed ways. The relative order of
  everything else is unchanged:
    · video-band inserted between promise-bar and services-grid
    · testimonials REPLACED by PartnerBadges — this business has no reviews
      anywhere (no Google Business Profile, none on the old site), so the seven
      audited certifications carry that slot instead of an empty band
    · social-embed (Instagram feed) inserted after about
    · seo-body REMOVED

  hero → promise-bar → video-band → services-grid → partner-badges →
  promise-band → signature-system → process-steps → about → social-embed →
  faq → blog-cards → closing-cta → footer
-->
<BaseLayout
  title={`${site.business_name} — ${site.tagline}`}
  description={home.hero?.subheadline || site.tagline}
  jsonLd={faqJsonLd ? [faqJsonLd] : undefined}
  pagePath="/"
>
  <HeroOwl
    badge_logos
    photo_mobile="/img/hero-eggs-portrait.jpg"
    eyebrow={home.hero.eyebrow}
    headline={home.hero.headline}
    subheadline={home.hero.subheadline}
    cta_text={home.hero.cta_text}
    cta_href={home.hero.cta_href}
    photo={home.hero.photo ?? site.default_hero_photo}
    video={home.hero.video ?? site.default_hero_video}
    video_link_text={home.hero.video_link_text}
    video_link_href={home.hero.video_link_href}
    quote_card={home.hero.quote_card}
    trust_badges={home.hero.trust_badges}
    show_form
  />
  <PromiseBar items={home.promise_bar} />
  {home.video_section && (
    <VideoSection
      src={home.video_section.src}
      eyebrow={home.video_section.eyebrow}
      headline={home.video_section.headline}
      body={home.video_section.body}
      poster={home.video_section.poster}
    />
  )}
  <ServicesGridOwl cta_text={CTA_TEXT} cta_href={CTA_HREF} />
  {/* Trust badges stand in for testimonials here. Morning Star Fields has no
      reviews anywhere -- no Google Business Profile, no testimonials on the old
      site -- so the seven audited certifications carry the social-proof slot
      instead of an empty band or invented quotes. Operator-directed. */}
  <PartnerBadges
    eyebrow="Independently certified"
    headline="Seven marks, and somebody else checks every one"
    intro="A cage-free label is a claim the farm makes about itself. These are the ones an outside body inspects us against -- welfare, food safety, kosher supervision, space standards and Florida sourcing."
  />
  <PromiseBand data={home.promise_band} />
  <SignatureSystem data={home.signature_system} />
  <ProcessSteps data={home.process_steps} />
  <AboutOwl
    data={home.about_block}
    fallback_photo={site.about_photo ?? site.team_photo}
    business_name={site.business_name}
  />
  {home.social_embed && (
    <SocialEmbed
      snippet={home.social_embed.snippet}
      eyebrow={home.social_embed.eyebrow}
      headline={home.social_embed.headline}
    />
  )}
  <FAQ items={home.faqs ?? []} cta_text={CTA_TEXT} cta_href={CTA_HREF} />
  <BlogCards cta_text={CTA_TEXT} cta_href={CTA_HREF} />
  <ClosingCTA />
  <GHLChatWidget />
</BaseLayout>
