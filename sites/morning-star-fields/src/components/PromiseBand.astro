---
import { getIcon } from '../lib/icons';

export interface Props {
  data?: {
    eyebrow?: string;
    headline: string;
    body: string;
    cta_text?: string;
    cta_href?: string;
    icon?: string;
    image?: string;
    image_alt?: string;
    image_badge?: string;
    image_badge_alt?: string;
  };
}
const { data } = Astro.props;
const svg = getIcon(data?.icon);
---
{data && (
  <section class="promise-band" aria-label={data.headline}>
    <div class="container inner">
      {data.image
        ? (
            <figure class="band-figure">
              <img class="band-img" src={data.image} alt={data.image_alt ?? ''} loading="lazy" />
              {data.image_badge && (
                <img
                  class="band-badge"
                  src={data.image_badge}
                  alt={data.image_badge_alt ?? ''}
                  loading="lazy"
                />
              )}
            </figure>
          )
        : svg && (
            <span class="band-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor" set:html={svg} />
            </span>
          )}
      {data.eyebrow && <p class="eyebrow">{data.eyebrow}</p>}
      <h2>{data.headline}</h2>
      <p class="body">{data.body}</p>
      {data.cta_text && data.cta_href && (
        <a class="btn" href={data.cta_href}>{data.cta_text}</a>
      )}
    </div>
  </section>
)}
<style>
  .promise-band { background: var(--color-surface); padding: var(--space-5) 0; }
  .inner { max-width: 780px; text-align: center; }
  .band-icon { display: inline-flex; align-items: center; justify-content: center; width: 4.5rem; height: 4.5rem; border-radius: 50%; background: var(--color-accent); color: var(--color-on-accent); margin: 0 auto var(--space-3); }
  .band-icon svg { width: 2.4rem; height: 2.4rem; }
  /* The photo is a fixed-width plate so the overlaid mark has a predictable
     corner to sit in. A square crop rather than the source's 3:4 — a portrait
     thumbnail left the badge floating in dead space down one side. */
  .band-figure {
    position: relative; width: 100%; max-width: 240px;
    margin: 0 auto var(--space-3); padding: 0;
  }
  .band-img {
    width: 100%; height: auto; display: block;
    aspect-ratio: 1 / 1; object-fit: cover;
    border-radius: var(--radius-lg);
  }
  /* White plate behind the logo: these marks are drawn for print on white and
     lose their outline over a dark photo. */
  .band-badge {
    position: absolute; right: -10px; bottom: -10px;
    width: 84px; height: auto; display: block;
    background: #fff; padding: 7px;
    border-radius: var(--radius-md);
    box-shadow: 0 2px 10px rgba(24, 20, 60, 0.22);
  }
  @media (max-width: 560px) {
    .band-figure { max-width: 200px; }
    .band-badge { width: 70px; right: -6px; bottom: -6px; }
  }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.9rem; font-weight: 600; color: var(--color-accent-ink); margin: 0 0 var(--space-1); }
  h2 { font-family: var(--font-display); font-weight: 700; color: var(--color-text); font-size: clamp(1.85rem, 3.5vw, 3rem); line-height: 1.15; margin: 0 0 var(--space-2); text-transform: uppercase; letter-spacing: 0.01em; }
  .body { color: var(--color-muted); font-size: 1.05rem; line-height: 1.7; margin: 0 0 var(--space-3); }
  .btn { display: inline-block; background: var(--color-accent); color: var(--color-on-accent); padding: 0.9rem 1.75rem; border-radius: var(--radius-sm); font-weight: 700; font-size: 1.25rem; text-decoration: none; text-transform: uppercase; }
</style>
