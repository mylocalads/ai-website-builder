---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import HeroOwl from '../components/HeroOwl.astro';
import AboutSection from '../components/AboutSection.astro';
import TrustBadges from '../components/TrustBadges.astro';
import GHLReviewsWidget from '../components/GHLReviewsWidget.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import GHLChatWidget from '../components/GHLChatWidget.astro';

const site = (await getEntry('site', 'config')).data as any;
const aboutEntry = await getEntry('site', 'about').catch(() => null);
const story = (aboutEntry?.data as any)?.story ?? `${site.business_name} — locally owned and operated in ${site.address.city}, ${site.address.state}.`;
const teamMembers = site.team_members ?? [];
const teamHero = site.team_photo;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'About', href: '/about' }];
---
<BaseLayout
  title={`About ${site.business_name}`}
  description={`About ${site.business_name} — serving ${site.address.city}, ${site.address.state}.`}
  breadcrumbs={crumbs}
  pagePath="/about"
>

  <HeroOwl
    eyebrow={`About ${site.business_name}`}
    headline={`About ${site.business_name}`}
    subheadline={story.slice(0, 190)}
    cta_text="Get Your Free Estimate!"
    cta_href="/book"
    photo={site.about_photo ?? site.default_hero_photo}
    show_form
    form_heading="Get Your Free Estimate Today!"
  />

  {teamHero && (
    <section class="team-hero">
      <img src={teamHero} alt={`${site.business_name} team`} />
      <div class="team-hero-overlay">
        <div class="container">
          <h1>Meet the {site.business_name} team</h1>
        </div>
      </div>
    </section>
  )}

  <AboutSection eyebrow="About Us" heading="About us" body={story} photo={site.about_photo} photo_alt={`${site.business_name}`} photo_position="right" />

  {teamMembers.length > 0 && (
    <section class="team-grid" aria-label="Team members">
      <div class="container">
        <h2>Our team</h2>
        <div class="grid">
          {teamMembers.map((m: any) => (
            <figure class="member">
              <img src={m.photo} alt={m.name} loading="lazy" />
              <figcaption>
                <h3>{m.name}</h3>
                {m.role && <p class="role">{m.role}</p>}
                {m.bio && <p class="bio">{m.bio}</p>}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <TrustBadges />
  <GHLReviewsWidget />
  <ClosingCTA />
  <GHLChatWidget />
</BaseLayout>
<style>
  .team-hero { position: relative; height: 420px; overflow: hidden; }
  .team-hero img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .team-hero-overlay { position: absolute; inset: 0; background: linear-gradient(rgba(15,20,25,0.35), rgba(15,20,25,0.65)); display: flex; align-items: flex-end; padding: var(--space-4) 0; }
  .team-hero-overlay h1 { color: white; font-size: clamp(2rem, 4vw, 3rem); text-shadow: 0 2px 12px rgba(0,0,0,0.35); }
  .team-grid { padding: var(--space-5) 0; background: var(--color-surface); }
  .team-grid h2 { text-align: center; font-size: clamp(1.75rem, 3vw, 2.5rem); margin-bottom: var(--space-3); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-3); }
  .member { margin: 0; background: var(--color-bg); border-radius: var(--radius-md); overflow: hidden; }
  .member img { width: 100%; aspect-ratio: 4/5; object-fit: cover; display: block; }
  .member figcaption { padding: var(--space-2); }
  .member h3 { margin: 0 0 0.25rem; font-size: 1.1rem; }
  .role { color: var(--color-accent); font-size: 0.9rem; margin: 0 0 0.5rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; }
  .bio { color: var(--color-muted); font-size: 0.95rem; margin: 0; line-height: 1.5; }
</style>
