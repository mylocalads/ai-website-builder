---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import SectionHead from '../components/SectionHead.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import GHLChatWidget from '../components/GHLChatWidget.astro';

const site = (await getEntry('site', 'config')).data as any;
const pay = site.payments ?? {};
const clientId: string | undefined = pay.paypal_client_id;
const currency: string = pay.currency ?? 'USD';

// Built from config rather than pasted as raw HTML: the PayPal SDK URL is a
// documented, parameterised endpoint, so there is nothing to guess. (The
// paste-only rule in CLAUDE.md exists for GHL widget loaders, whose URLs are
// account-specific and unguessable — this is a different situation.)
const sdkParams = new URLSearchParams({ 'client-id': clientId ?? '', currency });
if (pay.enable_funding) sdkParams.set('enable-funding', pay.enable_funding);
const sdkUrl = `https://www.paypal.com/sdk/js?${sdkParams.toString()}`;

const social = site.social ?? {};
const socials = Object.entries(social).filter(([_, url]) => !!url);
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Online Payments', href: '/online-payments' }];
---
<BaseLayout
  title={`Online Payments — ${site.business_name}`}
  description={`Pay your ${site.business_name} bill online by credit card, debit card, Venmo, or PayPal. Enter your customer number and amount to pay securely.`}
  breadcrumbs={crumbs}
  pagePath="/online-payments"
>
  <section class="payments-page">
    <div class="container">
      <SectionHead eyebrow="Online Payments" heading="Pay your bill online" />
      <div class="payments-grid">
        <div class="form-col">
          {clientId ? (
            <div class="pay-card">
              <p class="lede">
                Enter your customer number and the amount you are paying, then choose how you
                would like to pay. You can pay by credit or debit card without a PayPal account.
              </p>

              <form id="pay-form" novalidate>
                <div class="row">
                  <label for="pay-customer">Customer or account number <span aria-hidden="true">*</span></label>
                  <input
                    id="pay-customer"
                    name="customer"
                    type="text"
                    maxlength="127"
                    autocomplete="off"
                    required
                    aria-describedby="pay-customer-error"
                  />
                  <p class="field-error" id="pay-customer-error" hidden>
                    Please enter the customer or account number from your invoice.
                  </p>
                </div>

                <div class="row">
                  <label for="pay-amount">Amount ({currency}) <span aria-hidden="true">*</span></label>
                  <div class="amount-wrap">
                    <span class="currency-mark" aria-hidden="true">$</span>
                    <input
                      id="pay-amount"
                      name="amount"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="0.00"
                      required
                      aria-describedby="pay-amount-error"
                    />
                  </div>
                  <p class="field-error" id="pay-amount-error" hidden>
                    Please enter an amount greater than zero, in dollars and cents.
                  </p>
                </div>
              </form>

              <div id="paypal-button-container" class="pp-buttons"></div>

              <p class="pay-status" id="pay-status" role="status" aria-live="polite"></p>

              <p class="fine">
                Payments are processed by PayPal. {site.business_name} never sees or stores your
                card details. Questions about an invoice? Call
                <a href={`tel:${site.phone}`}>{site.phone_display}</a>.
              </p>
            </div>
          ) : (
            <div class="pay-card pay-unconfigured">
              <h3>Online payments are not switched on yet</h3>
              <p>
                To take payments here, add a <code>payments.paypal_client_id</code> to
                <code>src/content/site/config.json</code>. Until then, please call
                <a href={`tel:${site.phone}`}>{site.phone_display}</a> to settle your invoice.
              </p>
            </div>
          )}
        </div>

        <aside class="info-col">
          <h3>Additional Info</h3>
          <p class="phone-large"><a href={`tel:${site.phone}`}>{site.phone_display}</a></p>
          <div class="row">
            <strong>Address:</strong>
            <address>
              {site.address.street && <>{site.address.street}<br /></>}
              {site.address.city}, {site.address.state}{site.address.postal ? ` ${site.address.postal}` : ''}
            </address>
          </div>
          {site.email && (
            <div class="row"><strong>Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></div>
          )}
          {site.hours && (
            <div class="row">
              <strong>Assistance Hours:</strong>
              <ul>{Object.entries(site.hours).map(([day, hrs]) => <li><span class="day">{day}</span> — {hrs}</li>)}</ul>
            </div>
          )}
          <div class="row">
            <strong>Ways to pay:</strong>
            <ul class="plain">
              <li>Credit or debit card</li>
              <li>PayPal balance</li>
              {pay.enable_funding?.includes('venmo') && <li>Venmo</li>}
            </ul>
          </div>
          <div class="row biz-info">
            <strong>{site.business_name}</strong>
            {site.legal_name && site.legal_name !== site.business_name && <><br />{site.legal_name}</>}
          </div>
          {socials.length > 0 && (
            <div class="socials">
              {socials.map(([platform, url]) => (
                <a href={url} rel="noopener" target="_blank" aria-label={platform} class="social-link">
                  {platform === 'facebook' && (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.7V3.6C16.5 3.6 15.5 3.5 14.4 3.5c-2.2 0-3.7 1.3-3.7 3.8v2.6H8v3.1h2.7V21h2.8z"/></svg>
                  )}
                </a>
              ))}
            </div>
          )}
        </aside>
      </div>
    </div>
  </section>

  <ClosingCTA headline="Questions about your invoice?" cta_text={site.phone_display} cta_href={`tel:${site.phone}`} />
  <GHLChatWidget />

  {clientId && (
    <Fragment>
      {/* is:inline on BOTH is load-bearing. Astro otherwise bundles these as
          deferred ES modules, which (a) breaks the ordering the SDK requires and
          (b) puts `paypal` out of scope for the init script. Classic inline
          scripts execute in document order, so the SDK is fully evaluated before
          the initialiser below runs. */}
      <script is:inline src={sdkUrl} data-sdk-integration-source="button-factory"></script>
      <script is:inline define:vars={{ currency }}>
        (function () {
          var form = document.getElementById('pay-form');
          if (!form || typeof paypal === 'undefined') return;

          var customer = document.getElementById('pay-customer');
          var amount = document.getElementById('pay-amount');
          var customerError = document.getElementById('pay-customer-error');
          var amountError = document.getElementById('pay-amount-error');
          var status = document.getElementById('pay-status');
          var container = document.getElementById('paypal-button-container');

          // The source page only checked `value.length > 0`, so "abc", "0" and
          // "-5" all passed the gate and were rejected later by PayPal with
          // nothing shown to the payer. Validate the number properly here.
          function parseAmount(raw) {
            var cleaned = String(raw).replace(/[$,\s]/g, '');
            if (!/^\d+(\.\d{1,2})?$/.test(cleaned)) return null;
            var n = parseFloat(cleaned);
            if (!isFinite(n) || n <= 0) return null;
            return n.toFixed(2);
          }

          function customerOk() { return customer.value.trim().length > 0; }
          function amountOk() { return parseAmount(amount.value) !== null; }
          function formOk() { return customerOk() && amountOk(); }

          function setError(el, msgEl, bad) {
            msgEl.hidden = !bad;
            el.setAttribute('aria-invalid', bad ? 'true' : 'false');
            el.classList.toggle('is-invalid', bad);
          }

          // Only complain about a field once the payer has left it, so the form
          // does not turn red while they are still typing the first character.
          customer.addEventListener('blur', function () { setError(customer, customerError, !customerOk()); });
          amount.addEventListener('blur', function () { setError(amount, amountError, !amountOk()); });

          paypal.Buttons({
            style: { color: 'gold', shape: 'rect', label: 'paypal', layout: 'vertical' },

            onInit: function (data, actions) {
              actions.disable();
              [customer, amount].forEach(function (el) {
                ['keyup', 'change', 'input'].forEach(function (evt) {
                  el.addEventListener(evt, function () {
                    if (formOk()) { actions.enable(); } else { actions.disable(); }
                  });
                });
              });
            },

            onClick: function () {
              setError(customer, customerError, !customerOk());
              setError(amount, amountError, !amountOk());
            },

            createOrder: function (data, actions) {
              var value = parseAmount(amount.value);
              status.textContent = '';
              status.className = 'pay-status';
              return actions.order.create({
                purchase_units: [{
                  description: customer.value.trim().slice(0, 127),
                  amount: { value: value, currency_code: currency },
                }],
              });
            },

            onApprove: function (data, actions) {
              return actions.order.capture().then(function (orderData) {
                var id = (orderData && orderData.id) || data.orderID || '';
                container.innerHTML = '';
                form.setAttribute('hidden', '');
                status.className = 'pay-status is-success';
                // Give the payer a reference they can quote back to the office.
                status.textContent = 'Thank you — your payment went through.'
                  + (id ? ' Your PayPal confirmation number is ' + id + '.' : '')
                  + ' A receipt has been emailed to you by PayPal.';
              });
            },

            onError: function (err) {
              // The source page only console.logged this, so a failed payment
              // looked to the payer like nothing had happened at all.
              status.className = 'pay-status is-error';
              status.textContent = 'Something went wrong taking that payment. You have not been charged.'
                + ' Please try again, or call us and we will take it over the phone.';
              if (window.console) console.error('[paypal]', err);
            },

            onCancel: function () {
              status.className = 'pay-status is-note';
              status.textContent = 'Payment cancelled — you have not been charged.';
            },
          }).render('#paypal-button-container');
        })();
      </script>
    </Fragment>
  )}
</BaseLayout>
<style>
  .payments-page { padding: var(--space-4) 0 var(--space-5); }
  .payments-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--space-4); align-items: start; }
  .form-col { min-width: 0; }

  .pay-card { background: var(--color-surface); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-3); box-shadow: 0 18px 42px rgba(15,20,25,0.12); }
  .pay-card .lede { color: var(--color-muted); line-height: 1.65; margin: 0 0 var(--space-3); }

  form { display: grid; gap: var(--space-2); }
  .row { display: grid; gap: 0.35rem; margin-bottom: var(--space-2); }
  label { font-weight: 600; font-size: 0.92rem; color: var(--color-text); }
  input[type="text"] {
    width: 100%; padding: 0.7rem 0.85rem; font: inherit; color: var(--color-text);
    background: var(--color-bg); border: 1px solid rgba(0,0,0,0.22); border-radius: var(--radius-sm);
  }
  input:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  input.is-invalid { border-color: #b3261e; }

  /* A leading $ inside the field, so the payer is never unsure of the unit. */
  .amount-wrap { position: relative; }
  .amount-wrap .currency-mark { position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--color-muted); font-weight: 600; }
  .amount-wrap input { padding-left: 1.9rem; }

  /* Not colour alone — the message text carries the meaning. */
  .field-error { margin: 0; font-size: 0.88rem; color: #b3261e; }

  .pp-buttons { margin-top: var(--space-3); min-height: 3rem; }

  .pay-status { margin: var(--space-2) 0 0; font-size: 0.95rem; line-height: 1.6; }
  .pay-status.is-success { color: var(--color-primary); font-weight: 600; background: rgba(11,72,1,0.07); border-left: 3px solid var(--color-primary); padding: var(--space-2); border-radius: var(--radius-sm); }
  .pay-status.is-error { color: #b3261e; font-weight: 600; background: rgba(179,38,30,0.07); border-left: 3px solid #b3261e; padding: var(--space-2); border-radius: var(--radius-sm); }
  .pay-status.is-note { color: var(--color-muted); }

  .fine { margin: var(--space-3) 0 0; font-size: 0.85rem; line-height: 1.6; color: var(--color-muted); }

  .pay-unconfigured h3 { margin: 0 0 var(--space-2); font-family: var(--font-display); }
  .pay-unconfigured code { background: var(--color-bg); padding: 0.1rem 0.35rem; border-radius: 3px; font-size: 0.9em; }

  /* Sidebar matches /contact exactly. */
  .info-col h3 { font-family: var(--font-display); font-size: 1.75rem; margin: 0 0 var(--space-2); text-transform: capitalize; }
  .phone-large { font-size: 1.35rem; font-weight: 600; margin: 0 0 var(--space-3); }
  .phone-large a { text-decoration: none; }
  .info-col .row { margin-bottom: var(--space-2); font-size: 0.95rem; line-height: 1.65; display: block; }
  .info-col .row strong { display: block; margin-bottom: 0.25rem; }
  .info-col .row address { font-style: normal; color: var(--color-muted); }
  .info-col .row ul { list-style: none; padding: 0; margin: 0.25rem 0 0; color: var(--color-muted); }
  .info-col .row ul li { padding: 0.1rem 0; }
  .info-col .row ul .day { text-transform: capitalize; color: var(--color-text); font-weight: 500; }
  .biz-info { margin-top: var(--space-3); padding-top: var(--space-2); border-top: 1px solid var(--color-surface); font-size: 0.95rem; color: var(--color-muted); }
  .socials { display: flex; gap: var(--space-1); margin-top: var(--space-3); }
  .social-link { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 8px; background: var(--color-accent); color: var(--color-on-accent); transition: transform 0.15s ease, filter 0.15s ease; }
  .social-link:hover, .social-link:focus-visible { transform: translateY(-2px); filter: brightness(1.1); }

  @media (max-width: 900px) {
    .payments-grid { grid-template-columns: 1fr; }
  }
</style>
