---
import { getEntry } from 'astro:content';
import SectionHead from './SectionHead.astro';
const site = (await getEntry('site', 'config')).data as any;
const items = site.why_choose_us ?? [];
// Owl renders these as a typographic tile grid. There is deliberately no icon
// slot: Owl's design language has no icon rows, and the roofing reference
// library bans them outright. The `icon` field on why_choose_us entries is
// ignored here — do not reintroduce it by printing the raw string, which is how
// values like "shield" and "clock" ended up rendering as literal words.
---
{items.length > 0 && (
  <section class="why-choose-us" aria-label="Why choose us">
    <div class="container">
      <SectionHead eyebrow="Why Choose Us" heading="Reasons homeowners pick us" />
      <ol class="grid">
        {items.map((i: any) => (
          <li class="tile">
            <h3>{i.title}</h3>
            <p>{i.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}
<style>
  /* Dark band: SectionHead's eyebrow needs the plain yellow here, not the ink
     variant it defaults to on light sections. */
  .why-choose-us { padding: var(--space-5) 0; background: var(--color-primary); color: var(--color-on-primary); --eyebrow-color: var(--color-accent); }
  .why-choose-us :global(.section-head h2) { color: var(--color-on-primary); }
  .why-choose-us :global(.section-head .subtitle) { color: var(--color-on-primary); opacity: 0.7; }
  .grid { list-style: none; counter-reset: reason; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-3); }
  .tile { counter-increment: reason; padding: var(--space-3); background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--radius-lg); transition: transform 0.2s ease, border-color 0.2s ease; }
  .tile::before { content: counter(reason, decimal-leading-zero); display: block; font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--color-accent); margin-bottom: var(--space-2); }
  .tile:hover { transform: translateY(-5px); border-color: var(--color-accent); }
  .tile h3 { margin: 0 0 var(--space-1); font-size: 1.15rem; color: var(--color-on-primary); text-transform: capitalize; }
  .tile p { color: var(--color-on-primary); opacity: 0.78; margin: 0; line-height: 1.6; }
</style>
