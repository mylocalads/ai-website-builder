---
export interface Props { eyebrow?: string; heading: string; subtitle?: string; align?: 'center' | 'left'; }
const { eyebrow, heading, subtitle, align = 'center' } = Astro.props;
---
<div class={`section-head ${align}`}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{heading}</h2>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</div>
<style>
  .section-head { max-width: 780px; margin: 0 auto var(--space-3); }
  .section-head.center { text-align: center; }
  .section-head.left { text-align: left; margin: 0 0 var(--space-3); }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.9rem; font-weight: 600; color: var(--color-accent); margin: 0 0 var(--space-1); }
  h2 { font-family: var(--font-display); font-weight: 700; color: var(--color-text); font-size: clamp(1.85rem, 3.5vw, 3rem); line-height: 1.15; margin: 0 0 var(--space-2); text-transform: uppercase; letter-spacing: 0.01em; }
  .subtitle { color: var(--color-muted); font-size: 1.05rem; margin: 0; }
</style>
