---
import { AREA_LIMIT, SERVICE_LIMIT } from '../lib/limits';
import { getIcon } from '../lib/icons';
import { getEntry, getCollection } from 'astro:content';
const site = (await getEntry('site', 'config')).data as any;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order).slice(0, SERVICE_LIMIT);
const areas = (await getCollection('service_areas')).sort((a, b) => a.data.order - b.data.order).slice(0, AREA_LIMIT);
---
<header class="site-header">
  <div class="container header-row">
    <a href="/" class="brand" aria-label={`${site.business_name} — Home`}>
      {site.logo_url ? <img src={site.logo_url} alt={site.business_name} class="brand-logo" /> : site.business_name}
    </a>
    <nav aria-label="Primary" class="primary-nav">
      <ul class="nav-list">
        <li class="has-menu">
          <a href="/services" aria-haspopup="true">Services <span aria-hidden="true">▾</span></a>
          <ul class="submenu">
            {services.map((s) => <li><a href={`/services/${s.slug}`}>{s.data.title}</a></li>)}
          </ul>
        </li>
        <li class="has-menu">
          <a href="/service-area" aria-haspopup="true">Service Areas <span aria-hidden="true">▾</span></a>
          <ul class="submenu">
            {areas.map((a) => <li><a href={`/service-area/${a.slug}`}>{a.data.name}</a></li>)}
          </ul>
        </li>
        <li><a href="/our-work">Our Work</a></li>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
        <li class="phone-cta-item"><a href={`tel:${site.phone}`} class="phone-cta"><span class="phone-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" set:html={getIcon("phone")!} /></span><span class="phone-copy"><span class="phone-label">Give Us A Call!</span><span class="phone-number">{site.phone_display}</span></span></a></li>
      </ul>
    </nav>
    <a href={`tel:${site.phone}`} class="phone-cta mobile-phone"><span class="phone-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" set:html={getIcon("phone")!} /></span><span class="phone-copy"><span class="phone-label">Give Us A Call!</span><span class="phone-number">{site.phone_display}</span></span></a>
    <details class="mobile-nav">
      <summary aria-label="Open menu">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" stroke="#111" stroke-width="2.25" stroke-linecap="round" />
        </svg>
      </summary>
      <nav aria-label="Mobile primary">
        <ul>
          <li class="group">
            <details class="mobile-submenu">
              <summary class="group-heading">
                <span>Services</span>
                <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <ul class="sub">
                {services.map((s) => <li><a href={`/services/${s.slug}`}>{s.data.title}</a></li>)}
              </ul>
            </details>
          </li>
          <li class="group">
            <details class="mobile-submenu">
              <summary class="group-heading">
                <span>Service Areas</span>
                <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <ul class="sub">
                {areas.map((a) => <li><a href={`/service-area/${a.slug}`}>{a.data.name}, {a.data.state}</a></li>)}
              </ul>
            </details>
          </li>
          <li><a href="/our-work">Our Work</a></li>
          <li><a href="/pricing">Pricing</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
<style>
  .site-header { border-bottom: 1px solid var(--color-surface); position: sticky; top: 0; background: var(--color-bg); z-index: 50; }
  .header-row { display: flex; align-items: center; justify-content: space-between; padding: var(--space-2) 0; gap: var(--space-3); }
  .brand { font-family: var(--font-display); font-size: 1.25rem; text-decoration: none; flex: 1; display: inline-flex; align-items: center; }
  /* 99px - 20%. The H4 wordmark is wide and short, so at 99px it set the header
     bar height and left a band of whitespace either side of the nav. */
  .brand-logo { max-height: 79px; width: auto; display: block; }
  .nav-list { list-style: none; padding: 0; margin: 0; display: flex; gap: var(--space-3); align-items: center; }
  .nav-list a { text-decoration: none; }
  .has-menu { position: relative; }
  .submenu {
    position: absolute; top: 100%; left: 0; min-width: 220px; background: var(--color-bg);
    border: 1px solid var(--color-surface); padding: var(--space-1) 0; margin: 0; list-style: none;
    display: none; box-shadow: 0 4px 14px rgba(0,0,0,0.08); border-radius: var(--radius-sm);
  }
  .has-menu:hover .submenu, .has-menu:focus-within .submenu { display: block; }
  .submenu li a { display: block; padding: 0.5rem var(--space-2); }
  /* Icon badge + stacked label/number, rather than a solid pill. The number is
     the emphasis; the badge carries the accent colour. */
  .phone-cta { display: inline-flex; align-items: center; gap: 0.6rem; background: none; padding: 0; border-radius: 0; text-decoration: none; color: var(--color-text); }
  /* Derived from the client's accent with color-mix rather than a hardcoded
     rgba(). The literal here used to be Gilroy's orange, which every subsequent
     client had to find and replace by hand. */
  .phone-icon { display: inline-flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.5rem; flex-shrink: 0; border-radius: 50%; background: color-mix(in srgb, var(--color-accent) 16%, transparent); color: var(--color-accent-ink); }
  .phone-icon svg { width: 1.35rem; height: 1.35rem; }
  .phone-copy { display: flex; flex-direction: column; line-height: 1.15; }
  .phone-label { font-size: 0.72rem; font-weight: 600; color: var(--color-muted); }
  .phone-number { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; color: var(--color-text); white-space: nowrap; }
  .phone-cta:hover .phone-number, .phone-cta:focus-visible .phone-number { color: var(--color-accent-ink); }
  .mobile-nav, .mobile-phone { display: none; }
  .mobile-nav summary { cursor: pointer; list-style: none; padding: 0.25rem; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); }
  .mobile-nav summary:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav[open] > nav { position: absolute; top: 100%; right: var(--space-3); left: var(--space-3); background: var(--color-bg); border: 1px solid var(--color-surface); border-radius: var(--radius-sm); padding: var(--space-2); box-shadow: 0 4px 14px rgba(0,0,0,0.08); max-height: calc(100vh - 96px); overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
  .mobile-nav nav ul { list-style: none; padding: 0; margin: 0; }
  .mobile-nav nav ul li a { display: block; padding: 0.35rem 0; text-decoration: none; line-height: 1.3; }
  .mobile-nav .mobile-submenu { border-bottom: 1px solid var(--color-surface); }
  .mobile-nav .mobile-submenu:last-of-type { border-bottom: 0; }
  .mobile-nav .mobile-submenu > .group-heading { font-weight: 700; padding: 0.6rem 0; cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; }
  .mobile-nav .mobile-submenu > .group-heading::-webkit-details-marker { display: none; }
  .mobile-nav .mobile-submenu > .group-heading .chev { color: var(--color-muted); transition: transform 0.2s ease; flex-shrink: 0; }
  .mobile-nav .mobile-submenu[open] > .group-heading .chev { transform: rotate(180deg); color: var(--color-accent-ink); }
  .mobile-nav .sub { padding: 0.25rem 0 0.5rem; margin: 0 0 0.5rem 0.6rem; border-left: 2px solid var(--color-surface); }
  .mobile-nav .sub li a { padding: 0.25rem 0 0.25rem 0.6rem; font-size: 0.95rem; color: var(--color-muted); line-height: 1.3; }
  .mobile-nav .sub .all { font-weight: 600; color: var(--color-text); }

  @keyframes phone-glow {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 55%, transparent); }
    70%  { box-shadow: 0 0 0 12px color-mix(in srgb, var(--color-accent) 0%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 0%, transparent); }
  }

  @media (max-width: 900px) {
    .primary-nav { display: none; }
    .mobile-nav { display: inline-flex; }
    .mobile-phone { display: inline-flex; margin: 0 auto; }
    /* The pulse rides the circular badge now — on the transparent layout a
       box-shadow on the link itself would throb as a rectangle around the text. */
    .mobile-phone .phone-icon { animation: phone-glow 1.8s ease-out infinite; }
    .mobile-phone .phone-label { display: none; }
    .brand { flex: 0 1 auto; }
    .brand-logo { max-height: 55px; }   /* 69px - 20%, matching the desktop reduction */
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-phone .phone-icon { animation: none; }
  }
</style>
