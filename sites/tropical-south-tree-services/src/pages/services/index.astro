---
import { SERVICE_LIMIT } from '../../lib/limits';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, getCollection } from 'astro:content';
import ClosingCTA from '../../components/ClosingCTA.astro';
import { groupServicesByCategory } from '../../lib/taxonomy';
import { serviceHref } from '../../lib/urls';

const site = (await getEntry('site', 'config')).data as any;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order).slice(0, SERVICE_LIMIT);
// This is the hub page for EVERY service, so it uses SERVICE_LIMIT (not
// the featured subset the homepage grid uses) and groups by line of business —
// a couple of dozen ungrouped cards is a wall, and grouping also gives the page
// a real heading outline for search engines rather than one h1 over a flat list.
const groups = groupServicesByCategory(services);
const marketCity = site.marketing_city ?? site.address.city;
const marketState = site.marketing_state ?? site.address.state;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Services', href: '/services' }];
---
<BaseLayout
  title={`Tree & Landscaping Services in ${marketCity}, ${marketState} — ${site.business_name}`}
  description={`All ${services.length} services from ${site.business_name}: tree removal, trimming, stump grinding, emergency storm response, land clearing, ISA-certified arborist reports, landscape maintenance and sod across ${marketCity}-Dade County.`}
  breadcrumbs={crumbs}
  pagePath="/services"
>
  <section class="services-hero" style={site.default_hero_photo && `background-image: linear-gradient(rgba(15,20,25,0.55), rgba(15,20,25,0.55)), url(${site.default_hero_photo});`}>
    <div class="container">
      <h1>Tree & Landscaping Services in {marketCity}-Dade County</h1>
      <p>{services.length} services, one licensed and insured crew — from a single palm trim to full lot clearing, county permit reports and the weekly landscape round.</p>
    </div>
  </section>
  {groups.map((g) => (
    <section class="services-index">
      <div class="container">
        <h2 class="group-title">{g.title}</h2>
        <div class="grid">
          {g.services.map((s) => (
            <a href={serviceHref(s.slug)} class="card">
              <h3>{s.data.title}</h3>
              <p>{s.data.short_description}</p>
              <span class="more" aria-hidden="true">Learn more →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
  <ClosingCTA />
</BaseLayout>
<style>
  /* The dark gradient below is applied inline and ONLY when the client has a
     default_hero_photo, but `color: white` is unconditional — so without a photo
     the copy was white on whatever the page background is. This fallback keeps
     white text legible either way. It is a fixed dark neutral rather than
     --color-primary on purpose: a client whose secondary background is light
     (e.g. a yellow brand) would fail here. Matches HeroOwl's scrim colour. */
  .services-hero { padding: var(--space-5) 0; background-color: #0f1419; background-size: cover; background-position: center; background-repeat: no-repeat; color: white; }
  .services-hero h1 { color: white; font-size: clamp(2rem, 4vw, 3rem); text-shadow: 0 2px 8px rgba(0,0,0,0.3); margin-bottom: var(--space-1); }
  .services-hero p { color: rgba(255,255,255,0.9); font-size: 1.15rem; }
  /* Groups stack directly, so the first gets the full top gap and the rest only
     need separation from the group above. */
  .services-index { padding: var(--space-4) 0 0; }
  .services-index:last-of-type { padding-bottom: var(--space-5); }
  .group-title {
    font-family: var(--font-display); font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    text-transform: uppercase; letter-spacing: 0.01em;
    margin: 0 0 var(--space-3); padding-bottom: var(--space-1);
    border-bottom: 3px solid var(--color-accent);
    display: inline-block;
  }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-3); }
  .card {
    display: flex; flex-direction: column; padding: var(--space-3);
    background: var(--color-surface); border-radius: var(--radius-md);
    text-decoration: none; border: 1px solid transparent;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .card:hover, .card:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 10px 26px rgba(15,32,47,0.12);
    border-color: var(--color-accent);
  }
  .card h3 { margin: 0 0 var(--space-1); font-size: 1.2rem; font-family: var(--font-display); }
  .card p { color: var(--color-muted); margin: 0 0 var(--space-2); flex: 1; }
  .more { font-weight: 700; font-size: 0.9rem; color: var(--color-accent-ink); }
</style>
