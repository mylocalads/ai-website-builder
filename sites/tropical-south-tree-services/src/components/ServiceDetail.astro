---
/**
 * The full service detail page, extracted from what used to be
 * src/pages/services/[slug].astro.
 *
 * It lives here rather than in the page because services and service areas now
 * share ONE route — src/pages/[slug].astro — so that both resolve at the root
 * (`/tree-removal`, `/pinecrest-fl`). Astro cannot have two `[slug].astro` files
 * at the same level, so the page became a dispatcher and the two bodies became
 * components. Nothing about the rendered output changed in the move.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import HeroOwl from './HeroOwl.astro';
import PartnerBadges from './PartnerBadges.astro';
import AboutSection from './AboutSection.astro';
import Gallery from './Gallery.astro';
import WhyChooseUs from './WhyChooseUs.astro';
import ServicesGridOwl from './ServicesGridOwl.astro';
import GHLReviewsWidget from './GHLReviewsWidget.astro';
import Financing from './Financing.astro';
import ServiceAreaGrid from './ServiceAreaGrid.astro';
import FAQ from './FAQ.astro';
import ClosingCTA from './ClosingCTA.astro';
import GHLChatWidget from './GHLChatWidget.astro';
import { serviceHref, SERVICES_HUB } from '../lib/urls';

export interface Props { service: any }
const { service } = Astro.props;

const site = (await getEntry('site', 'config')).data as any;

const heroFormUrl = site.crm?.estimate_form_embed_url ?? site.crm?.contact_form_embed_url;
const marketCity = site.marketing_city ?? site.address.city;
const marketState = site.marketing_state ?? site.address.state;

const path = serviceHref(service.slug);
const title = `${service.data.title} in ${marketCity}, ${marketState} | ${site.business_name}`;
const description = service.data.short_description;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: SERVICES_HUB },
  { name: service.data.title, href: path },
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: service.data.title,
  provider: { '@type': 'LocalBusiness', name: site.business_name },
  areaServed: { '@type': 'AdministrativeArea', name: `${site.address.city}, ${site.address.state}` },
  description: service.data.long_description,
};

const faqLd = service.data.faqs.length > 0 ? {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: service.data.faqs.map((f: any) => ({
    '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;
---
<BaseLayout
  title={title}
  description={description}
  breadcrumbs={crumbs}
  jsonLd={faqLd ? [serviceLd, faqLd] : [serviceLd]}
  pagePath={path}
>
  <HeroOwl
    eyebrow={`${marketCity}, ${marketState}`}
    headline={service.data.seo_h1 ?? `${service.data.title} in ${marketCity}, ${marketState}`}
    subheadline={service.data.short_description}
    cta_text="Get Your Free Estimate!"
    cta_href="/book"
    photo={service.data.hero_photo ?? site.default_hero_photo}
    form_embed_url={heroFormUrl}
    form_title={`${service.data.title} estimate`}
    show_form
    form_heading={`Free ${service.data.title.toLowerCase()} estimate`}
  />
  <PartnerBadges />
  <AboutSection
    eyebrow="Our Service"
    heading={service.data.about_heading ?? `About our ${service.data.title.toLowerCase()} services`}
    body={service.data.long_description}
    photo={service.data.about_photo}
    photo_alt={service.data.about_photo_alt ?? `${service.data.title} — ${site.business_name}`}
    photo_position="left"
    bullets={service.data.sub_services ?? []}
    bullet_ids
  />
  <Gallery items={service.data.gallery ?? []} heading={`${service.data.title} gallery`} />
  <WhyChooseUs />
  <ServicesGridOwl />
  <GHLReviewsWidget />
  <Financing />
  <ServiceAreaGrid />
  <FAQ items={service.data.faqs ?? []} />
  <ClosingCTA />
  <GHLChatWidget />
</BaseLayout>
