---
import SectionHead from './SectionHead.astro';
export interface FAQItem { q: string; a: string; }
export interface Props { items: FAQItem[]; cta_text?: string; cta_href?: string; }
const { items, cta_text, cta_href } = Astro.props;
---
{items.length > 0 && (
  <section class="faq" aria-label="Frequently asked questions">
    <div class="container">
      <SectionHead eyebrow="FAQs" heading="Frequently asked" />
      <div class="list">
        {items.map((i) => (
          <details class="faq-item">
            <summary>
              <span class="q">{i.q}</span>
              <span class="chev" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </summary>
            <div class="a"><p>{i.a}</p></div>
          </details>
        ))}
      </div>
      {cta_text && cta_href && (
        <div class="section-cta"><a class="btn" href={cta_href}>{cta_text}</a></div>
      )}
    </div>
  </section>
)}
<style>
  .section-cta { text-align: center; margin-top: var(--space-4); }
  .section-cta .btn { display: inline-block; background: var(--color-accent); color: var(--color-on-accent); padding: 0.9rem 1.75rem; border-radius: var(--radius-sm); font-weight: 700; font-size: 1.25rem; letter-spacing: 0.02em; text-transform: uppercase; text-decoration: none; }

  .faq { padding: var(--space-5) 0; background: var(--color-surface); }
  .list { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--space-2); }
  .faq-item { background: var(--color-bg); border: 1px solid rgba(15,20,25,0.08); border-radius: 12px; box-shadow: 0 2px 10px rgba(15,20,25,0.04); overflow: hidden; transition: box-shadow 0.2s ease, border-color 0.2s ease; }
  .faq-item:hover { box-shadow: 0 6px 20px rgba(15,20,25,0.08); border-color: rgba(15,20,25,0.14); }
  .faq-item[open] { box-shadow: 0 6px 20px rgba(15,20,25,0.10); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); padding: 1.1rem 1.5rem; cursor: pointer; font-weight: 600; font-size: 1.05rem; list-style: none; color: var(--color-text); }
  summary::-webkit-details-marker { display: none; }
  summary::marker { display: none; }
  .chev { color: var(--color-muted); transition: transform 0.2s ease; display: inline-flex; }
  .faq-item[open] .chev { transform: rotate(180deg); color: var(--color-accent-ink); }
  .a { padding: 0 1.5rem 1.25rem; color: var(--color-muted); line-height: 1.65; }
  .a p { margin: 0; }
</style>
