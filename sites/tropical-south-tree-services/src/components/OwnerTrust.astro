---
/**
 * Owner-trust block: who actually shows up, and why that matters in this trade.
 *
 * Sits above the services grid on the homepage. The proof points are rendered
 * as a stat row rather than prose because they are the numbers a homeowner is
 * actually comparing (years, rating, review count, response) and prose buries
 * them.
 */
export interface Stat { value: string; label: string }
export interface Props {
  data?: {
    eyebrow?: string;
    headline: string;
    lede?: string;
    body?: string[];
    stats?: Stat[];
    checklist?: string[];
    photo?: string;
    photo_alt?: string;
    review?: {
      text: string;
      author: string;
      avatar?: string;
      date?: string;
      rating?: number;
      source_url?: string;
    };
    /** Set when the portrait already carries its own frame/shadow. */
    photo_framed?: boolean;
    cta_text?: string;
    cta_href?: string;
  };
}
const { data } = Astro.props;
---
{data && (
  <section class="owner" aria-labelledby="owner-heading">
    <div class="container">
      <div class="grid">
        <div class="copy">
          {data.eyebrow && <p class="eyebrow">{data.eyebrow}</p>}
          <h2 id="owner-heading">{data.headline}</h2>
          {data.lede && <p class="lede">{data.lede}</p>}
          {(data.body ?? []).map((p) => <p>{p}</p>)}

          {(data.checklist ?? []).length > 0 && (
            <ul class="checklist">
              {data.checklist!.map((c) => (
                <li>
                  <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
                    <circle cx="12" cy="12" r="11" fill="currentColor" opacity="0.16" />
                    <path d="M7 12.5l3.5 3.5L17 9.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{c}</span>
                </li>
              ))}
            </ul>
          )}

          {data.cta_text && data.cta_href && (
            <a class="cta" href={data.cta_href}>{data.cta_text}</a>
          )}
        </div>

        <aside class="side">
          {data.photo && (
            <figure class={`shot ${data.photo_framed ? 'framed' : ''}`}>
              <img src={data.photo} alt={data.photo_alt ?? ''} loading="lazy" decoding="async" />
            </figure>
          )}
          {data.review && (
            <figure class="greview">
              <div class="gr-head">
                {data.review.avatar
                  ? <img class="gr-avatar" src={data.review.avatar} alt="" loading="lazy" decoding="async" width="96" height="96" />
                  : <span class="gr-avatar gr-initial" aria-hidden="true">{data.review.author.trim().charAt(0)}</span>}
                <div class="gr-who">
                  <span class="gr-name">{data.review.author}</span>
                  {data.review.date && <span class="gr-date">{data.review.date}</span>}
                </div>
                {/* Google's own mark, used to attribute a genuine Google review. */}
                <svg class="gr-g" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                  <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.4a5.5 5.5 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.6-5.2 3.6-8.8z"/>
                  <path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3a7.2 7.2 0 0 1-10.7-3.8h-4v3.1A12 12 0 0 0 12 24z"/>
                  <path fill="#FBBC05" d="M5.3 14.3a7.1 7.1 0 0 1 0-4.6V6.6h-4a12 12 0 0 0 0 10.8l4-3.1z"/>
                  <path fill="#EA4335" d="M12 4.8c1.8 0 3.4.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1A7.2 7.2 0 0 1 12 4.8z"/>
                </svg>
              </div>
              <div class="gr-stars" role="img" aria-label={`${data.review.rating ?? 5} out of 5 stars`}>
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"
                       fill={i < (data.review!.rating ?? 5) ? '#FBBC04' : '#DADCE0'}>
                    <path d="M12 17.3l-6.2 3.7 1.6-7L2 9.2l7.1-.6L12 2l2.9 6.6 7.1.6-5.4 4.8 1.6 7z"/>
                  </svg>
                ))}
              </div>
              <blockquote>{data.review.text}</blockquote>
              <figcaption>
                {data.review.source_url
                  ? <a href={data.review.source_url} rel="noopener noreferrer" target="_blank">Read our Google reviews →</a>
                  : 'Posted on Google'}
              </figcaption>
            </figure>
          )}
        </aside>
      </div>

      {(data.stats ?? []).length > 0 && (
        <ul class="stats">
          {data.stats!.map((s) => (
            <li><span class="value">{s.value}</span><span class="label">{s.label}</span></li>
          ))}
        </ul>
      )}
    </div>
  </section>
)}
<style>
  .owner { padding: var(--space-5) 0; background: var(--color-bg); }
  .grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: var(--space-4); align-items: start; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }

  .eyebrow { text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.85rem; font-weight: 700; color: var(--color-accent-ink); margin: 0 0 var(--space-1); }
  h2 { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.6rem, 3vw, 2.5rem); line-height: 1.15; text-transform: uppercase; margin: 0 0 var(--space-2); color: var(--color-text); }
  .lede { font-size: 1.15rem; font-weight: 600; color: var(--color-text); margin: 0 0 var(--space-2); }
  .copy p { color: var(--color-muted); margin: 0 0 var(--space-2); line-height: 1.6; }

  .checklist { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; gap: 0.6rem; }
  .checklist li { display: flex; gap: 0.7rem; align-items: flex-start; color: var(--color-text); }
  .checklist svg { color: var(--color-accent-ink); flex-shrink: 0; margin-top: 0.15rem; }

  .cta {
    display: inline-block; margin-top: var(--space-3);
    background: var(--color-accent); color: var(--color-on-accent);
    padding: 0.85rem 1.6rem; border-radius: var(--radius-sm);
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; text-decoration: none;
  }
  .cta:hover, .cta:focus-visible { filter: brightness(1.06); }

  .side { display: grid; gap: var(--space-3); }
  .shot { margin: 0; border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 14px 34px rgba(6,34,61,0.16); }
  .shot img { display: block; width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4 / 3; }
  /* The owner portrait ships with its own rounded white frame and drop shadow
     baked into the PNG. Wrapping it in a second one double-frames it, so the
     framed variant drops the container's chrome and shows the image whole
     instead of cropping it to 4:3. */
  .shot.framed { border-radius: 0; box-shadow: none; overflow: visible; }
  .shot.framed img { aspect-ratio: auto; height: auto; object-fit: contain; }

  /* Styled to read as an actual Google review card rather than a pull-quote:
     avatar, name, date, the Google mark, and Google's own amber stars (#FBBC04)
     rather than the site accent — the whole point is that it looks like it came
     from Google, so borrowing the brand yellow here would undercut it. */
  .greview {
    margin: 0; padding: var(--space-3);
    background: var(--color-surface);
    border: 1px solid #dadce0;
    border-radius: var(--radius-md);
    box-shadow: 0 1px 3px rgba(60,64,67,0.16);
  }
  .gr-head { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.6rem; }
  .gr-avatar { width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0; object-fit: cover; display: block; }
  .gr-initial {
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--color-primary); color: var(--color-on-primary);
    font-family: var(--font-display); font-weight: 700; font-size: 1.1rem;
  }
  .gr-who { display: flex; flex-direction: column; line-height: 1.25; flex: 1; min-width: 0; }
  .gr-name { font-weight: 700; color: var(--color-text); font-size: 0.95rem; }
  .gr-date { font-size: 0.8rem; color: #70757a; }
  .gr-g { flex-shrink: 0; }
  .gr-stars { display: flex; gap: 1px; margin-bottom: 0.5rem; }
  .greview blockquote { margin: 0 0 var(--space-2); font-size: 0.98rem; line-height: 1.6; color: var(--color-text); }
  .greview figcaption { font-size: 0.8rem; color: #70757a; }
  .greview figcaption a { color: var(--color-accent-ink); font-weight: 700; text-decoration: none; }
  .greview figcaption a:hover, .greview figcaption a:focus-visible { text-decoration: underline; }

  .stats {
    list-style: none; margin: var(--space-4) 0 0; padding: var(--space-3) 0 0;
    border-top: 1px solid color-mix(in srgb, var(--color-primary) 14%, transparent);
    display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-3);
    text-align: center;
  }
  @media (max-width: 700px) { .stats { grid-template-columns: repeat(2, 1fr); gap: var(--space-4) var(--space-2); } }
  .stats li { display: flex; flex-direction: column; gap: 0.15rem; }
  .stats .value { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.6rem, 3.4vw, 2.3rem); color: var(--color-primary); line-height: 1; }
  .stats .label { font-size: 0.85rem; color: var(--color-muted); font-weight: 600; }
</style>
