---
import { AREA_LIMIT, SERVICE_LIMIT } from '../lib/limits';
import { getIcon } from '../lib/icons';
import { getEntry, getCollection } from 'astro:content';
import { TREE_MENU_CATEGORIES, LANDSCAPING_MENU_CATEGORIES, groupServicesByCategory } from '../lib/taxonomy';
import { serviceHref, areaHref, subServiceId, SERVICES_HUB, AREAS_HUB } from '../lib/urls';
const site = (await getEntry('site', 'config')).data as any;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order).slice(0, SERVICE_LIMIT);
const areas = (await getCollection('service_areas')).sort((a, b) => a.data.order - b.data.order).slice(0, AREA_LIMIT);

// This client publishes twenty services. A flat twenty-item dropdown is a wall
// of links nobody reads, so the menu is grouped into the same three buckets the
// business itself uses. Grouping is presentation only — every service in
// `services` appears in exactly one column, so the menu still links to the same
// set of generated pages and the featured ⊆ generated invariant is untouched.
// Two menus, two disjoint category sets. `only` is what keeps them disjoint —
// without it each menu would render every service and the split would be
// cosmetic. Together the two cover every category, so nothing is unreachable.
const treeGroups = groupServicesByCategory(services, TREE_MENU_CATEGORIES);
const landscapingGroups = groupServicesByCategory(services, LANDSCAPING_MENU_CATEGORIES);
// Areas split into the operator's priority tier and the rest, mirroring the
// client's own "Primary" / "More" split.
const PRIMARY_AREA_COUNT = 7;
const primaryAreas = areas.slice(0, PRIMARY_AREA_COUNT);
const moreAreas = areas.slice(PRIMARY_AREA_COUNT);
---
<header class="site-header">
  <div class="container header-row">
    <a href="/" class="brand" aria-label={`${site.business_name} — Home`}>
      {site.logo_url ? <img src={site.logo_url} alt={site.business_name} class="brand-logo" /> : site.business_name}
    </a>
    <nav aria-label="Primary" class="primary-nav">
      <ul class="nav-list">
        <li class="has-menu has-mega">
          <a href={SERVICES_HUB} aria-haspopup="true">Tree Services <span aria-hidden="true">▾</span></a>
          <div class="submenu mega">
            <div class="mega-cols">
              {treeGroups.map((g) => (
                <div class="mega-col">
                  <p class="mega-heading">{g.title}</p>
                  <ul>
                    {g.services.map((s) => <li><a href={serviceHref(s.slug)}>{s.data.title}</a></li>)}
                  </ul>
                </div>
              ))}
            </div>
            <a class="mega-all" href={SERVICES_HUB}>View all services →</a>
          </div>
        </li>
        <li class="has-menu has-mega">
          <a href={SERVICES_HUB} aria-haspopup="true">Landscaping Services <span aria-hidden="true">▾</span></a>
          <div class="submenu mega">
            <div class="mega-cols">
              {landscapingGroups.flatMap((g) => g.services).map((s) => (
                <div class="mega-col">
                  {/* The SERVICE is the column heading here and it is a link,
                      unlike the Tree Services menu where the heading is a
                      category with no page of its own. The items beneath are
                      sub-services, which are sections of the parent page rather
                      than pages — so they deep-link into it by anchor. */}
                  <a class="mega-heading mega-heading-link" href={serviceHref(s.slug)}>{s.data.title}</a>
                  <ul>
                    {s.data.sub_services.map((sub: string) => (
                      <li><a href={`${serviceHref(s.slug)}#${subServiceId(sub)}`}>{sub}</a></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <a class="mega-all" href={SERVICES_HUB}>View all services →</a>
          </div>
        </li>
        <li class="has-menu has-mega">
          <a href={AREAS_HUB} aria-haspopup="true">Service Areas <span aria-hidden="true">▾</span></a>
          <div class="submenu mega">
            <div class="mega-cols">
              <div class="mega-col">
                <p class="mega-heading">Primary Service Areas</p>
                <ul>
                  {primaryAreas.map((a) => <li><a href={areaHref(a.slug)}>{a.data.name}</a></li>)}
                </ul>
              </div>
              {moreAreas.length > 0 && (
                <div class="mega-col">
                  <p class="mega-heading">More Service Areas</p>
                  <ul>
                    {moreAreas.map((a) => <li><a href={areaHref(a.slug)}>{a.data.name}</a></li>)}
                  </ul>
                </div>
              )}
            </div>
            <a class="mega-all" href={AREAS_HUB}>View all service areas →</a>
          </div>
        </li>
        <li><a href="/our-work">Our Work</a></li>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/faq">FAQ</a></li>
        <li><a href="/contact">Contact</a></li>
        <li class="phone-cta-item"><a href={`tel:${site.phone}`} class="phone-cta"><span class="phone-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" set:html={getIcon("phone")!} /></span><span class="phone-copy"><span class="phone-label">Give Us A Call!</span><span class="phone-number">{site.phone_display}</span></span></a></li>
      </ul>
    </nav>
    <a href={`tel:${site.phone}`} class="phone-cta mobile-phone"><span class="phone-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" set:html={getIcon("phone")!} /></span><span class="phone-copy"><span class="phone-label">Give Us A Call!</span><span class="phone-number">{site.phone_display}</span></span></a>
    <details class="mobile-nav">
      <summary aria-label="Open menu">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" />
        </svg>
      </summary>
      <nav aria-label="Mobile primary">
        <ul>
          <li class="group">
            <details class="mobile-submenu">
              <summary class="group-heading">
                <span>Tree Services</span>
                <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <ul class="sub">
                {treeGroups.map((g) => (
                  <>
                    <li class="sub-heading" aria-hidden="true">{g.title}</li>
                    {g.services.map((s) => <li><a href={serviceHref(s.slug)}>{s.data.title}</a></li>)}
                  </>
                ))}
                <li><a class="sub-all" href={SERVICES_HUB}>View all services →</a></li>
              </ul>
            </details>
          </li>
          <li class="group">
            <details class="mobile-submenu">
              <summary class="group-heading">
                <span>Landscaping Services</span>
                <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <ul class="sub">
                {landscapingGroups.flatMap((g) => g.services).map((s) => (
                  <>
                    <li><a class="sub-parent" href={serviceHref(s.slug)}>{s.data.title}</a></li>
                    {s.data.sub_services.map((sub: string) => (
                      <li class="sub-nested"><a href={`${serviceHref(s.slug)}#${subServiceId(sub)}`}>{sub}</a></li>
                    ))}
                  </>
                ))}
              </ul>
            </details>
          </li>
          <li class="group">
            <details class="mobile-submenu">
              <summary class="group-heading">
                <span>Service Areas</span>
                <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <ul class="sub">
                {areas.map((a) => <li><a href={areaHref(a.slug)}>{a.data.name}, {a.data.state}</a></li>)}
                <li><a class="sub-all" href={AREAS_HUB}>View all service areas →</a></li>
              </ul>
            </details>
          </li>
          <li><a href="/our-work">Our Work</a></li>
          <li><a href="/pricing">Pricing</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
<style>
  /* Brand blue header. It is sticky, so the background must stay fully opaque —
     a translucent one would smear the page content under it while scrolling.
     The light 1px border is replaced by a shadow: against blue it read as a
     grey seam. */
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--color-primary);
    box-shadow: 0 2px 12px rgba(6, 34, 61, 0.28);
  }
  /* Positioning context for the mega menus. They are anchored to this container
     rather than to their <li>, so a wide menu can never run off the right edge
     of the viewport — see .has-mega below. */
  .header-row { position: relative; display: flex; align-items: center; justify-content: space-between; padding: var(--space-2) 0; gap: var(--space-3); }
  .brand { font-family: var(--font-display); font-size: 1.25rem; text-decoration: none; flex: 1; display: inline-flex; align-items: center; }
  .brand-logo { max-height: 99px; width: auto; display: block; }
  /* Nav items STRETCH to the full height of the header row rather than being
     centred in it, so that a nav item's box actually touches the mega menu that
     opens beneath it.

     Centred, they did not: the logo makes .header-row 131px tall while a nav
     link is 24px, so the link sat at y=54–78 with the menu starting at y=131.
     That left a 54px dead zone. Moving the pointer from the link down to the
     menu crossed it, `:hover` on the <li> was lost, and the menu vanished before
     it could be clicked — every sub-page in both mega menus was unreachable by
     mouse.

     Stretching closes 38px of that; `top` on .submenu.mega below closes the
     remaining 16px of header padding. Hovering the menu itself keeps the <li>
     hovered because the menu is a DESCENDANT of it — the gap was the only
     problem, so no JS and no hover-bridge pseudo-element is needed. */
  .nav-list { list-style: none; padding: 0; margin: 0; display: flex; gap: var(--space-3); align-items: stretch; }
  /* align-self stretches the <nav> to the header row's full height, but the
     <ul> inside it is a normal block and would keep its 40px content height —
     so the <li> children had nothing tall to stretch against. Making the <nav>
     a flex container with stretch alignment passes the height down to the list,
     which passes it to the items. */
  .primary-nav { align-self: stretch; display: flex; align-items: stretch; }
  .nav-list > li { display: flex; align-items: center; }
  .nav-list a { text-decoration: none; }
  /* TOP-LEVEL items only — the `>` combinator is doing real work here. Sub-menu
     links live inside .submenu further down the tree and keep the blue-on-white
     treatment; without the child combinator this rule would repaint them too.
     .phone-cta is excluded because the phone block has its own colour split
     (white number, yellow icon) further down. */
  .nav-list > li > a:not(.phone-cta) {
    color: var(--color-accent);
    font-weight: 700;
    letter-spacing: 0.01em;
    padding: 0.35rem 0;
    position: relative;
  }
  /* Underline grows from the centre on hover and while the menu is open, so the
     top-level item stays visibly "active" the whole time its mega menu is
     down. */
  .nav-list > li > a:not(.phone-cta)::after {
    content: ''; position: absolute; left: 50%; right: 50%; bottom: 0; height: 2px;
    background: var(--color-on-primary); border-radius: 2px;
    transition: left 0.22s ease, right 0.22s ease;
  }
  .nav-list > li > a:not(.phone-cta):hover::after,
  .nav-list > li > a:not(.phone-cta):focus-visible::after,
  .nav-list > li:hover > a:not(.phone-cta)::after,
  .nav-list > li:focus-within > a:not(.phone-cta)::after { left: 0; right: 0; }
  /* #0057ff on #0f4d89 is nearly invisible; focus rings in the header use the
     brand yellow, which is 6.03:1 against the blue. */
  .site-header a:focus-visible, .site-header summary:focus-visible {
    outline: 2px solid var(--color-accent); outline-offset: 3px; border-radius: 2px;
  }
  .has-menu { position: relative; }
  /* White panel under the blue header, blue text inside. The panel is pure
     --color-surface rather than --color-bg so it separates cleanly from the
     page background when the menu overhangs the hero. */
  .submenu {
    position: absolute; top: 100%; left: 0; min-width: 220px;
    background: var(--color-surface);
    border: 0; border-bottom: 3px solid var(--color-accent);
    padding: var(--space-1) 0; margin: 0; list-style: none;
    display: none; box-shadow: 0 18px 36px rgba(6, 34, 61, 0.22); border-radius: 0 0 var(--radius-md) var(--radius-md);
  }
  .submenu a { color: var(--color-primary); }
  .has-menu:hover .submenu, .has-menu:focus-within .submenu { display: block; }
  .submenu li a { display: block; padding: 0.5rem var(--space-2); }

  /* Multi-column menu for the twenty-service / sixteen-area menus. A flat list
     that long runs off the bottom of the viewport; columns keep it on screen.
     `right: 0` is NOT used — these menus are wide and the Service Areas item
     sits left of centre, so anchoring left keeps them inside the page. The
     max-width + right-edge clamp below stops the widest one overflowing on
     narrow desktop widths. */
  /* The Services menu carries twenty links in three columns and is ~845px wide.
     Anchored to its <li> (which sits ~495px from the left at 1280) it ran 60px
     past the right edge of the viewport. `position: static` on the parent hands
     the positioning job to .header-row instead, so the menu spans the same
     max-width container as the rest of the page and is clamped by definition
     rather than by a guessed max-width. */
  .has-mega { position: static; }
  .submenu.mega {
    padding: var(--space-3);
    left: 0;
    right: 0;
    width: auto;
    /* Flush with the bottom of the stretched nav item rather than the bottom of
       the header's padding box, so there is no gap for the pointer to cross.
       .header-row's bottom padding is var(--space-2); absolutely positioned
       children resolve percentages against the padding box, so subtracting it
       lands exactly on the nav item's bottom edge. */
    top: calc(100% - var(--space-2));
  }
  .mega-cols { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-4); align-items: flex-start; }
  .mega-col { min-width: 190px; }
  .mega-col ul { list-style: none; margin: 0; padding: 0; }
  .mega-heading {
    margin: 0 0 0.35rem; padding: 0 var(--space-2);
    font-family: var(--font-display); font-size: 0.72rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-accent-ink);
    white-space: nowrap;
  }
  /* Hover: a brand-yellow bar wipes in from the left while the row nudges right
     and takes a soft blue wash. Three cheap properties, all brand colours, and
     the yellow bar is the same accent as the CTAs — so running the pointer down
     a twenty-item column reads as one continuous motion rather than twenty
     separate background flashes.

     transform + a pseudo-element are used instead of animating padding or
     border-width so the whole effect stays on the compositor and the text never
     reflows as it highlights. */
  .mega-col li a {
    position: relative; display: block; white-space: nowrap;
    padding: 0.4rem var(--space-2) 0.4rem calc(var(--space-2) + 4px);
    border-radius: var(--radius-sm);
    color: var(--color-primary);
    transition: background 0.18s ease, transform 0.18s ease, color 0.18s ease;
  }
  .mega-col li a::before {
    content: ''; position: absolute; left: 4px; top: 6px; bottom: 6px; width: 3px;
    background: var(--color-accent); border-radius: 3px;
    transform: scaleY(0); transform-origin: top;
    transition: transform 0.18s ease;
  }
  .mega-col li a:hover, .mega-col li a:focus-visible {
    background: color-mix(in srgb, var(--color-primary) 7%, transparent);
    transform: translateX(4px);
    color: color-mix(in srgb, var(--color-primary) 88%, #000);
  }
  .mega-col li a:hover::before, .mega-col li a:focus-visible::before { transform: scaleY(1); }
  .mega-all {
    display: inline-block; margin: var(--space-2) var(--space-2) 0;
    font-weight: 700; font-size: 0.85rem; color: var(--color-accent-ink) !important;
    border-bottom: 2px solid transparent; transition: border-color 0.18s ease;
  }
  .mega-all:hover, .mega-all:focus-visible { border-bottom-color: var(--color-accent); }
  /* In the Landscaping menu the column heading IS the service page, so it has to
     look and behave like a link while keeping the visual weight of a heading. */
  a.mega-heading-link {
    display: block; text-decoration: none; border-radius: var(--radius-sm);
    padding: 0.25rem var(--space-2); margin-bottom: 0.35rem;
  }
  /* Gold, matching the category labels in the Tree Services menu. These two are
     links rather than plain labels, but consistency across the two menus is what
     the operator wants — a column heading reads as a column heading in both. The
     hover state is what signals they are clickable. */
  a.mega-heading-link {
    color: var(--color-accent-ink);
    transition: background 0.18s ease, color 0.18s ease;
  }
  a.mega-heading-link:hover, a.mega-heading-link:focus-visible {
    background: color-mix(in srgb, var(--color-accent) 26%, transparent);
    color: var(--color-primary);
    text-decoration: none;
  }
  /* Icon badge + stacked label/number, rather than a solid pill. The number is
     the emphasis; the badge carries the accent colour. */
  /* Framed as a button so it reads as tappable at a glance, rather than as a
     stray icon and a number floating in the header. */
  .phone-cta {
    display: inline-flex; align-items: center; gap: 0.6rem;
    background: color-mix(in srgb, var(--color-on-primary) 9%, transparent);
    border: 1.5px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    padding: 0.4rem 0.9rem 0.4rem 0.45rem;
    border-radius: 999px;
    text-decoration: none; color: var(--color-on-primary);
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .phone-cta:hover, .phone-cta:focus-visible {
    background: color-mix(in srgb, var(--color-on-primary) 15%, transparent);
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }
  /* Derived from the client's accent with color-mix rather than a hardcoded
     rgba(). The literal here used to be Gilroy's orange, which every subsequent
     client had to find and replace by hand. */
  /* Yellow glyph in a yellow-tinted disc, on the blue header. --color-accent-ink
     is the LIGHT-background variant of the accent and would go nearly black
     here, so the glyph uses the raw brand yellow — 6.03:1 on the blue. */
  .phone-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.5rem; height: 2.5rem; flex-shrink: 0; border-radius: 50%;
    /* A low-opacity yellow fill cannot hold its hue over this blue — it comes
       out grey-green. The RING is what actually reads as yellow, so the badge
       is a faint wash plus a solid 2px accent ring. */
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    box-shadow: inset 0 0 0 2px var(--color-accent);
    color: var(--color-accent);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }
  /* Hover fills the badge solid yellow with the dark ink glyph and throws a soft
     yellow halo — same accent, just turned up. */
  .phone-cta:hover .phone-icon, .phone-cta:focus-visible .phone-icon {
    background: var(--color-accent);
    color: var(--color-on-accent);
    transform: scale(1.06);
    box-shadow: inset 0 0 0 2px var(--color-accent), 0 0 0 6px color-mix(in srgb, var(--color-accent) 26%, transparent);
  }
  .phone-icon svg { width: 1.35rem; height: 1.35rem; }
  .phone-copy { display: flex; flex-direction: column; line-height: 1.15; }
  .phone-label { font-size: 0.72rem; font-weight: 600; color: color-mix(in srgb, var(--color-on-primary) 78%, transparent); }
  /* Underlined so it is unambiguously a link and not just a printed number.
     The offset keeps the rule clear of the digits' baseline. */
  .phone-number {
    font-family: var(--font-display); font-weight: 700; font-size: 1.05rem;
    color: var(--color-on-primary); white-space: nowrap;
    text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 80%, transparent);
  }
  .phone-cta:hover .phone-number, .phone-cta:focus-visible .phone-number { color: var(--color-accent); text-decoration-color: var(--color-accent); }
  .mobile-nav, .mobile-phone { display: none; }
  /* Hamburger inherits currentColor now — it was hardcoded #111, which is all
     but invisible against the blue header. */
  .mobile-nav { color: var(--color-accent); }
  .mobile-nav summary { cursor: pointer; list-style: none; padding: 0.25rem; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); }
  .mobile-nav summary:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  /* The panel is a white sheet with blue text, matching the desktop mega menus
     rather than the blue header it drops out of. */
  .mobile-nav[open] > nav { position: absolute; top: 100%; right: var(--space-3); left: var(--space-3); background: var(--color-surface); color: var(--color-primary); border: 0; border-bottom: 3px solid var(--color-accent); border-radius: 0 0 var(--radius-md) var(--radius-md); padding: var(--space-2); box-shadow: 0 18px 36px rgba(6,34,61,0.22); max-height: calc(100vh - 96px); overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
  .mobile-nav nav a { color: var(--color-primary); }
  .mobile-nav nav .group-heading { color: var(--color-primary); }
  .mobile-nav nav ul { list-style: none; padding: 0; margin: 0; }
  .mobile-nav nav ul li a { display: block; padding: 0.35rem 0; text-decoration: none; line-height: 1.3; }
  .mobile-nav .mobile-submenu { border-bottom: 1px solid color-mix(in srgb, var(--color-primary) 14%, transparent); }
  .mobile-nav .mobile-submenu:last-of-type { border-bottom: 0; }
  .mobile-nav .mobile-submenu > .group-heading { font-weight: 700; padding: 0.6rem 0; cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; }
  .mobile-nav .mobile-submenu > .group-heading::-webkit-details-marker { display: none; }
  .mobile-nav .mobile-submenu > .group-heading .chev { color: color-mix(in srgb, var(--color-primary) 60%, transparent); transition: transform 0.2s ease; flex-shrink: 0; }
  .mobile-nav .mobile-submenu[open] > .group-heading .chev { transform: rotate(180deg); color: var(--color-accent-ink); }
  .mobile-nav .sub { padding: 0.25rem 0 0.5rem; margin: 0 0 0.5rem 0.6rem; border-left: 2px solid color-mix(in srgb, var(--color-primary) 18%, transparent); }
  .mobile-nav .sub li a { padding: 0.25rem 0 0.25rem 0.6rem; font-size: 0.95rem; color: color-mix(in srgb, var(--color-primary) 82%, transparent); line-height: 1.3; }
  .mobile-nav .sub .all { font-weight: 600; color: var(--color-text); }
  /* Group labels inside the twenty-item mobile services list. aria-hidden on the
     markup because these are visual grouping only — the links below them already
     name the service in full, so announcing "Tree Care Services" as a list item
     would just add noise for a screen-reader user walking the list. */
  .mobile-nav .sub .sub-heading {
    padding: 0.6rem 0 0.2rem 0.6rem; font-family: var(--font-display);
    font-size: 0.68rem; font-weight: 700; text-transform: uppercase;
