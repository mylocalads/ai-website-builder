---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import HeroOwl from '../components/HeroOwl.astro';
import PricingTable from '../components/PricingTable.astro';
import Financing from '../components/Financing.astro';
import FAQ from '../components/FAQ.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import GHLChatWidget from '../components/GHLChatWidget.astro';

const site = (await getEntry('site', 'config')).data as any;
const pricingEntry = await getEntry('site', 'pricing').catch(() => null);
const pricing = (pricingEntry?.data as any) ?? { intro: 'Straightforward pricing.', packages: [], notes: undefined };
const homeEntry = await getEntry('site', 'home').catch(() => null);
const faqs = (homeEntry?.data as any)?.faqs ?? [];
const calendarSnippet = site.crm?.calendar_embed_snippet;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Pricing', href: '/pricing' }];

// What every GBM proposal spells out. Deliberately no dollar figures: the
// number depends entirely on metered volume, and publishing a fake range
// would be the exact thing this page argues against.
const quoteLineItems = [
  { item: 'The device', shown: 'Model, speed, colour or mono, finishing options', why: 'Sized to the metered volume of the area it serves, not to a sales sheet' },
  { item: 'Term and renewal', shown: 'Length of agreement and the exact notice window', why: 'So a renewal is a decision you make, never one that happens by default' },
  { item: 'Included page allowance', shown: 'Pages included per month, black and colour separately', why: 'Set against your real metered volume rather than an estimate' },
  { item: 'Cost per page', shown: 'Black rate, colour rate, and what can change them mid-term', why: 'The number that decides what the fleet actually costs over the term' },
  { item: 'Service and supplies', shown: 'What is covered, response time, how toner is triggered', why: 'Automatic toner and preventative maintenance rather than reactive callouts' },
  { item: 'End of term', shown: 'Return, renewal or purchase, and who pays for what', why: 'The costs that usually surface late are written down at the start' },
];
---
<BaseLayout
  title={`Pricing — ${site.business_name}`}
  description={`How Golden Business Machines quotes copiers, managed print and IT support for businesses across ${site.address.city}, ${site.address.state} and Northeastern Pennsylvania.`}
  breadcrumbs={crumbs}
  pagePath="/pricing"
>
  <HeroOwl
    eyebrow="Transparent Pricing"
    headline="How We Quote"
    subheadline={pricing.intro}
    cta_text="Get My Free Consultation!"
    cta_href="/book"
    photo={site.default_hero_photo}
    show_form
    form_heading="Get a proposal for your office"
  />

  <section class="quote-anatomy">
    <div class="container">
      <h2>What every GBM proposal shows you</h2>
      <p class="lede">The hero above says why we will not put a price list on a web page. Here is what we will commit to instead — every line below appears on your proposal with its assumptions shown, so you can compare us against anyone else on the same terms.</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Line</th><th>What you see</th><th>Why it is there</th></tr>
          </thead>
          <tbody>
            {quoteLineItems.map((r) => (
              <tr><td>{r.item}</td><td>{r.shown}</td><td>{r.why}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="factors"><strong>What changes the number:</strong> metered monthly volume and the black-to-colour split, how many devices and locations are covered, the finishing and software you need, the length of the agreement, and whether managed IT is bundled with the print fleet.</p>
    </div>
  </section>

  {pricing.packages.length > 0 && <PricingTable packages={pricing.packages} />}
  {pricing.notes && (
    <section class="pricing-notes">
      <div class="container"><p>{pricing.notes}</p></div>
    </section>
  )}

  {calendarSnippet && (
    <section class="book">
      <div class="container">
        <h2>Book your free on-site consultation</h2>
        <p class="lede">Pick a time that works — we come out, inventory your devices, pull your real volumes, and put a written proposal together from there.</p>
        <div class="calendar-wrap"><Fragment set:html={calendarSnippet} /></div>
      </div>
    </section>
  )}

  <Financing />
  <FAQ items={faqs} />
  <ClosingCTA />
  <GHLChatWidget />
</BaseLayout>
<style>
  .pricing-hero { padding: var(--space-5) 0; background-size: cover; background-position: center; background-repeat: no-repeat; color: white; }
  .pricing-hero h1 { color: white; font-size: clamp(2rem, 4vw, 3rem); text-shadow: 0 2px 8px rgba(0,0,0,0.3); }
  .pricing-hero p { color: rgba(255,255,255,0.9); font-size: 1.15rem; max-width: 45rem; }
  .quote-anatomy { padding: var(--space-5) 0; background: var(--color-surface); }
  .quote-anatomy h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); }
  .quote-anatomy .lede { color: var(--color-muted); max-width: 45rem; margin: 0 0 var(--space-3); }
  .table-wrap { overflow-x: auto; margin: var(--space-2) 0; }
  .quote-anatomy table { width: 100%; border-collapse: collapse; background: var(--color-bg); border-radius: var(--radius-md); overflow: hidden; }
  .quote-anatomy th, .quote-anatomy td { padding: var(--space-2); text-align: left; border-bottom: 1px solid var(--color-surface); }
  .quote-anatomy th { background: var(--color-text); color: white; font-family: var(--font-display); font-weight: 600; }
  .quote-anatomy tbody tr:last-child td { border-bottom: 0; }
  .quote-anatomy .factors { margin-top: var(--space-3); color: var(--color-muted); }
  .pricing-notes { padding: var(--space-3) 0; color: var(--color-muted); font-size: 0.95rem; }
  .book { padding: var(--space-5) 0; }
  .book h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); }
  .book .lede { color: var(--color-muted); max-width: 45rem; margin: 0 0 var(--space-3); }
  .calendar-wrap iframe { width: 100%; min-height: 700px; border: 0; }
</style>
