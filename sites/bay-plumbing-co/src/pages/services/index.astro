---
import { SERVICE_NAV_LIMIT } from '../../lib/limits';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, getCollection } from 'astro:content';
import ServiceIndex from '../../components/ServiceIndex.astro';
import GHLChatWidget from '../../components/GHLChatWidget.astro';

const site = (await getEntry('site', 'config')).data as any;
const all = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const pick = (a: string) => all.filter((s) => s.data.audience === a).slice(0, SERVICE_NAV_LIMIT);
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Services', href: '/services' }];
---
<BaseLayout
  title={`Plumbing Services — ${site.business_name}`}
  description={`Residential and commercial plumbing, septic, drainfield and backflow services from ${site.business_name} across ${site.address.city}, ${site.address.state}.`}
  breadcrumbs={crumbs}
  pagePath="/services"
>
  <ServiceIndex
    eyebrow="What We Do"
    heading="Plumbing Services"
    lede={`Residential, commercial and industrial plumbing across Miami-Dade County — with the video, jetting and excavation equipment to finish the job ourselves. Same family, same shop, since 1968.`}
    groups={[
      {
        title: 'Residential Plumbing Services',
        blurb: 'For homeowners across Miami-Dade — emergencies at any hour, drains, septic systems and the everyday work of keeping an older Miami house running.',
        items: pick('residential'),
      },
      {
        title: 'Commercial Plumbing Services',
        blurb: 'For businesses, landlords, property managers and builders — County backflow compliance, grease traps, scheduled maintenance and new construction.',
        items: pick('commercial'),
      },
    ]}
  />
  <GHLChatWidget />
</BaseLayout>
