---
import { AREA_LIMIT, SERVICE_NAV_LIMIT } from '../lib/limits';
import { getIcon } from '../lib/icons';
import { getEntry, getCollection } from 'astro:content';
const site = (await getEntry('site', 'config')).data as any;
const allServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const byAudience = (a: 'residential' | 'commercial') =>
  allServices.filter((s) => s.data.audience === a).slice(0, SERVICE_NAV_LIMIT);
// Nav labels are shortened from the page titles ("Residential Plumbing" vs
// "Residential Plumbing Services") to keep the bar from crowding the two phone
// buttons. The full name is the H1 on each index page and the accessible name
// here, so nothing is lost to a screen reader or to search.
const serviceMenus = [
  { key: 'residential', label: 'Residential Plumbing', full: 'Residential Plumbing Services', href: '/services/residential', items: byAudience('residential') },
  { key: 'commercial', label: 'Commercial Plumbing', full: 'Commercial Plumbing Services', href: '/services/commercial', items: byAudience('commercial') },
].filter((m) => m.items.length > 0);
const areas = (await getCollection('service_areas')).sort((a, b) => a.data.order - b.data.order).slice(0, AREA_LIMIT);

// Built once and rendered in both the desktop nav and the mobile bar, so the
// two can never drift. The secondary entry drops out cleanly when a client has
// only one number — the stack then renders exactly as the single CTA did.
const phones = [
  { tel: site.phone, display: site.phone_display, label: site.phone_label ?? 'Give Us A Call!' },
  ...(site.phone_secondary && site.phone_secondary_display
    ? [{ tel: site.phone_secondary, display: site.phone_secondary_display, label: site.phone_secondary_label ?? '' }]
    : []),
];
---
<header class="site-header">
  <div class="container header-row">
    <a href="/" class="brand" aria-label={`${site.business_name} — Home`}>
      {site.logo_url || site.logo_url_inverse
        ? <img src={site.logo_url_inverse ?? site.logo_url} alt={site.business_name} class="brand-logo" />
        : site.business_name}
    </a>
    <nav aria-label="Primary" class="primary-nav">
      <ul class="nav-list">
        {serviceMenus.map((m) => (
          <li class="has-menu">
            <a href={m.href} aria-haspopup="true" aria-label={m.full}>{m.label} <span aria-hidden="true">▾</span></a>
            <ul class="submenu">
              {m.items.map((s) => <li><a href={`/services/${s.slug}`}>{s.data.title}</a></li>)}
              <li class="all"><a href={m.href}>All {m.label}</a></li>
            </ul>
          </li>
        ))}
        <li class="has-menu">
          <a href="/service-area" aria-haspopup="true">Service Areas <span aria-hidden="true">▾</span></a>
          <ul class="submenu">
            {areas.map((a) => <li><a href={`/service-area/${a.slug}`}>{a.data.name}</a></li>)}
          </ul>
        </li>
        <li><a href="/our-work">Our Work</a></li>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
        <li class="phone-cta-item">
          <div class="phone-stack">
            {phones.map((ph) => (
              <a href={`tel:${ph.tel}`} class="phone-cta" aria-label={`Call our ${ph.label} line on ${ph.display}`}>
                <span class="phone-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" set:html={getIcon("phone")!} /></span>
                <span class="phone-copy"><span class="phone-label">{ph.label}</span><span class="phone-number">{ph.display}</span></span>
              </a>
            ))}
          </div>
        </li>
      </ul>
    </nav>
    <div class="phone-stack mobile-phone">
      {phones.map((ph) => (
        <a href={`tel:${ph.tel}`} class="phone-cta" aria-label={`Call our ${ph.label} line on ${ph.display}`}>
          <span class="phone-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" set:html={getIcon("phone")!} /></span>
          <span class="phone-copy"><span class="phone-label">{ph.label}</span><span class="phone-number">{ph.display}</span></span>
        </a>
      ))}
    </div>
    <details class="mobile-nav">
      <summary aria-label="Open menu">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" />
        </svg>
      </summary>
      <nav aria-label="Mobile primary">
        <ul>
          {serviceMenus.map((m) => (
            <li class="group">
              <details class="mobile-submenu">
                <summary class="group-heading">
                  <span>{m.label}</span>
                  <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </summary>
                <ul class="sub">
                  {m.items.map((s) => <li><a href={`/services/${s.slug}`}>{s.data.title}</a></li>)}
                  <li><a class="all" href={m.href}>All {m.label}</a></li>
                </ul>
              </details>
            </li>
          ))}
          <li class="group">
            <details class="mobile-submenu">
              <summary class="group-heading">
                <span>Service Areas</span>
                <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <ul class="sub">
                {areas.map((a) => <li><a href={`/service-area/${a.slug}`}>{a.data.name}, {a.data.state}</a></li>)}
              </ul>
            </details>
          </li>
          <li><a href="/our-work">Our Work</a></li>
          <li><a href="/pricing">Pricing</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
<style>
  /* Inverted header: the brand red carries the bar, and everything on it —
     nav, logo, phone icon and number — is white. White on #d10909 measures
     5.59:1, so it clears AA at the 0.72rem "Give Us A Call!" label as well as
     at nav size.

     The bar colour is set here rather than read from --color-accent because
     --color-accent is the BUTTON fill token: buttons sitting on this bar would
     then be invisible. The two are near-identical by design but independent —
     changing the button red must not silently repaint the header.

     Everything below scopes off .site-header, so the footer keeps the red logo
     on its light background and no other surface is affected. */
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: #d10909;
    border-bottom: 1px solid rgba(0, 0, 0, 0.16);
    color: #ffffff;
  }
  .site-header a { color: #ffffff; }
  /* The blue --color-focus is near-invisible against the red bar. */
  .site-header a:focus-visible,
  .site-header summary:focus-visible { outline: 2px solid #ffffff; outline-offset: 2px; }
  .header-row { display: flex; align-items: center; justify-content: space-between; padding: var(--space-2) 0; gap: var(--space-3); }
  .brand { font-family: var(--font-display); font-size: 1.25rem; text-decoration: none; flex: 1; display: inline-flex; align-items: center; }
  .brand-logo { max-height: 99px; width: auto; display: block; }
  .nav-list { list-style: none; padding: 0; margin: 0; display: flex; gap: var(--space-3); align-items: center; }
  .nav-list a { text-decoration: none; }
  .has-menu { position: relative; }
  /* A darker red so the panel reads as a distinct surface hanging off the bar
     rather than a floating rectangle of the same colour. White on #b30808 is
     7.10:1. */
  .submenu {
    position: absolute; top: 100%; left: 0; min-width: 220px; background: #b30808;
    border: 1px solid rgba(255, 255, 255, 0.22); padding: var(--space-1) 0; margin: 0; list-style: none;
    display: none; box-shadow: 0 6px 18px rgba(0,0,0,0.28); border-radius: var(--radius-sm);
  }
  .submenu li a:hover { background: rgba(255, 255, 255, 0.14); }
  .has-menu:hover .submenu, .has-menu:focus-within .submenu { display: block; }
  .submenu li a { display: block; padding: 0.5rem var(--space-2); }
  /* Icon badge + stacked label/number, rather than a solid pill. The number is
     the emphasis; the badge carries the accent colour. */
  /* Two numbers stacked. Everything below is scaled down from the single-CTA
     sizing so the pair occupies roughly the height one used to — the bar does
     not grow, and the logo still sets the header height. */
  .phone-stack { display: flex; flex-direction: column; gap: 0.3rem; }
  .phone-cta { display: inline-flex; align-items: center; gap: 0.55rem; background: none; padding: 0; border-radius: 0; text-decoration: none; color: #ffffff; }
  /* The badge was a 16% tint of --color-accent with an accent-ink glyph — both
     disappear against a red bar.

     A translucent white disc alone reads as a washed-out pink smudge, so the
     circle is defined by a bright white RING rather than by the fill. The fill
     stays low (22%) on purpose: the glyph is white, and pushing the disc much
     lighter starts eating the glyph's own contrast against it. At 22% the disc
     blends to ~#db3f3f, leaving the white glyph at 4.38:1 — comfortably over
     the 3:1 that non-text UI needs, while the 85% ring is what actually makes
     the badge pop. */
  .phone-icon {
    position: relative;
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.05rem; height: 2.05rem; flex-shrink: 0; border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.85);
    color: #ffffff;
    transition: background 0.18s ease, box-shadow 0.18s ease;
  }
  .phone-icon svg { width: 1.1rem; height: 1.1rem; position: relative; z-index: 1; }

  /* Owl's signature call-button pulse, matched to owlroofing.com: TWO concentric
     rings that fade in and out on a stagger, not one halo growing outward.
     Each ring is a pseudo-element carrying a fixed-spread box-shadow, and it is
     the OPACITY that animates — which is why the rings appear to ripple rather
     than inflate.
     Reference: .btn--phone .icon::before / ::after, 2s ease-in-out infinite. */
  .phone-icon::before,
  .phone-icon::after {
    content: ""; position: absolute; inset: 0; border-radius: 50%;
    pointer-events: none; opacity: 0;
  }
  .phone-icon::before {
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.5);
    animation: pulseffect 2s ease-in-out infinite;
  }
  .phone-icon::after {
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.25), 0 0 0 6px rgba(255, 255, 255, 0.5);
    animation: pulseffect2 2s ease-in-out infinite;
  }
  .phone-copy { display: flex; flex-direction: column; line-height: 1.1; }
  /* The label now carries the LOCATION, which is the only thing distinguishing
     the two buttons — so unlike the old "Give Us A Call!" it is load-bearing and
     is never hidden, including on mobile. */
  .phone-label { font-size: 0.66rem; font-weight: 600; letter-spacing: 0.02em; color: #ffffff; }
  .phone-number { font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; color: #ffffff; white-space: nowrap; }
  /* Hover used to darken to accent-ink; on red that is barely a change and
     fails contrast. Underline the number and lift the badge instead. */
  .phone-cta:hover .phone-number, .phone-cta:focus-visible .phone-number { text-decoration: underline; }
  .phone-cta:hover .phone-icon, .phone-cta:focus-visible .phone-icon { background: rgba(255, 255, 255, 0.34); box-shadow: inset 0 0 0 2px #ffffff; }
  .mobile-nav, .mobile-phone { display: none; }
  .mobile-nav summary { cursor: pointer; list-style: none; padding: 0.25rem; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); }
  .mobile-nav summary:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav[open] > nav { position: absolute; top: 100%; right: var(--space-3); left: var(--space-3); background: #b30808; border: 1px solid rgba(255, 255, 255, 0.22); border-radius: var(--radius-sm); padding: var(--space-2); box-shadow: 0 6px 18px rgba(0,0,0,0.28); max-height: calc(100vh - 96px); overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
  .mobile-nav nav ul { list-style: none; padding: 0; margin: 0; }
  .mobile-nav nav ul li a { display: block; padding: 0.35rem 0; text-decoration: none; line-height: 1.3; }
  .mobile-nav .mobile-submenu { border-bottom: 1px solid rgba(255, 255, 255, 0.22); }
  .mobile-nav .mobile-submenu:last-of-type { border-bottom: 0; }
  .mobile-nav .mobile-submenu > .group-heading { font-weight: 700; padding: 0.6rem 0; cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; color: #ffffff; }
  .mobile-nav .mobile-submenu > .group-heading::-webkit-details-marker { display: none; }
  .mobile-nav .mobile-submenu > .group-heading .chev { color: #ffffff; transition: transform 0.2s ease; flex-shrink: 0; }
  .mobile-nav .mobile-submenu[open] > .group-heading .chev { transform: rotate(180deg); color: #ffffff; }
  .mobile-nav .sub { padding: 0.25rem 0 0.5rem; margin: 0 0 0.5rem 0.6rem; border-left: 2px solid rgba(255, 255, 255, 0.3); }
  /* Sub-items were --color-muted to sit back from their parent. On red the only
     safe way to keep that hierarchy is size and weight — a dimmed white would
     drop under AA. */
  .mobile-nav .sub li a { padding: 0.25rem 0 0.25rem 0.6rem; font-size: 0.95rem; color: #ffffff; line-height: 1.3; }
  .mobile-nav .sub .all { font-weight: 600; color: #ffffff; }

  /* Inner ring: holds full opacity through the middle of the cycle. */
  @keyframes pulseffect {
    0%   { opacity: 0; }
    30%  { opacity: 1; }
    70%  { opacity: 1; }
    100% { opacity: 0; }
  }
  /* Outer ring: peaks at 50%, after the inner one has already arrived. That
     offset is the whole effect — the two rings read as a ripple travelling
     outward even though neither one moves. */
  @keyframes pulseffect2 {
    0%   { opacity: 0; }
    30%  { opacity: 0; }
    50%  { opacity: 1; }
    70%  { opacity: 0; }
    100% { opacity: 0; }
  }

  @media (max-width: 900px) {
    .primary-nav { display: none; }
    .mobile-nav { display: inline-flex; }
    .mobile-phone { display: flex; margin: 0 auto; }
    /* The pulse used to be declared HERE, inside max-width:900px, so desktop
       had no animation at all — only a hover state. It now lives on
       .phone-icon itself and runs at every breakpoint, matching owlroofing.com,
       where .btn--phone .icon pulses unconditionally.

       The old rule hid .phone-label on mobile, which was right when it read
       "Give Us A Call!" and wrong now that it reads "Miami" / "Key Biscayne" —
       hiding it would leave two identical-looking buttons. */
    .brand { flex: 0 1 auto; }
    .brand-logo { max-height: 69px; }   /* 81px - 15%, trims the mobile header bar */
  }
  @media (prefers-reduced-motion: reduce) {
    /* Hold the rings hidden rather than just stopping the animation — paused
       mid-cycle they would freeze as a permanent static double outline. */
    .phone-icon::before, .phone-icon::after { animation: none; opacity: 0; }
  }
</style>
