---
export interface Props { eyebrow?: string; heading: string; subtitle?: string; align?: 'center' | 'left'; }
const { eyebrow, heading, subtitle, align = 'center' } = Astro.props;
---
<div class={`section-head ${align}`}>
  {eyebrow && (
    <p class="eyebrow"><span class="claw claw-tick" aria-hidden="true"></span>{eyebrow}</p>
  )}
  <h2>{heading}</h2>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</div>
<style>
  .section-head { max-width: 780px; margin: 0 auto var(--space-3); }
  .section-head.center { text-align: center; }
  .section-head.left { text-align: left; margin: 0 0 var(--space-3); }
  /* The claw glyph replaces the usual rule or bullet above a section title. */
  .eyebrow { display: flex; align-items: center; gap: 0.55rem; text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.9rem; font-weight: 700; color: var(--color-accent-ink); margin: 0 0 var(--space-1); }
  .section-head.center .eyebrow { justify-content: center; }
  h2 { font-family: var(--font-display); font-weight: 900; color: var(--color-text); font-size: clamp(1.85rem, 3.5vw, 3rem); line-height: 1.12; margin: 0 0 var(--space-2); text-transform: uppercase; letter-spacing: -0.02em; }
  .subtitle { color: var(--color-muted); font-size: 1.05rem; margin: 0; }
</style>
