---
import { AREA_LIMIT, SERVICE_LIMIT } from '../lib/limits';
import { getEntry, getCollection } from 'astro:content';
const site = (await getEntry('site', 'config')).data as any;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order).slice(0, SERVICE_LIMIT);
const areas = (await getCollection('service_areas')).sort((a, b) => a.data.order - b.data.order).slice(0, AREA_LIMIT);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <span class="claw footer-claw" aria-hidden="true"></span>
  <div class="container">
    <div class="footer-grid">
      <div>
        {/* The footer band is black, so it takes the reversed lockup rather
            than config.logo_url (the dark-text mark the header uses). */}
        <img src="/img/logo-white.png" alt={site.business_name} class="footer-logo" width="162" height="119" />
        <p class="tagline">{site.tagline}</p>
        <address>
          <strong>{site.business_name}</strong><br />
          {site.address.street && <>{site.address.street}<br /></>}
          {site.address.city}, {site.address.state}{site.address.postal ? ` ${site.address.postal}` : ''}
        </address>
        <p><a href={`tel:${site.phone}`}>{site.phone_display}</a></p>
        {site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
        {site.hours && (
          <div class="hours">
            <strong>Hours</strong>
            <ul>{Object.entries(site.hours).map(([day, hrs]) => <li><span class="day">{day}:</span> {hrs}</li>)}</ul>
          </div>
        )}
        {site.social && Object.entries(site.social).filter(([_, v]) => !!v).length > 0 && (
          <div class="footer-socials">
            {Object.entries(site.social).filter(([_, v]) => !!v).map(([platform, url]) => (
              <a href={url as string} rel="noopener" target="_blank" aria-label={platform} class="social-link">
                {platform === 'facebook' && <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.7V3.6C16.5 3.6 15.5 3.5 14.4 3.5c-2.2 0-3.7 1.3-3.7 3.8v2.6H8v3.1h2.7V21h2.8z"/></svg>}
                {platform === 'youtube' && <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 7.2c-.2-.9-.9-1.6-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4c-.9.2-1.6.9-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8c.2.9.9 1.6 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4c.9-.2 1.6-.9 1.8-1.8.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5 3-5 3z"/></svg>}
                {platform === 'instagram' && <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4 1 .5.5.7.9 1 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9 0 3.2 0 3.6-.1 4.9-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-1 1.4-.5.5-.9.7-1.4 1-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1-3.2 0-3.6 0-4.9-.1-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-1-.5-.5-.7-.9-1-1.4-.2-.4-.4-1-.4-2.2-.1-1.3-.1-1.7-.1-4.9 0-3.2 0-3.6.1-4.9.1-1.2.3-1.8.4-2.2.2-.6.5-1 1-1.4.5-.5.9-.7 1.4-1 .4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 5.4c-2.4 0-4.4 2-4.4 4.4s2 4.4 4.4 4.4 4.4-2 4.4-4.4-2-4.4-4.4-4.4zm0 7.2c-1.5 0-2.8-1.3-2.8-2.8s1.3-2.8 2.8-2.8 2.8 1.3 2.8 2.8-1.3 2.8-2.8 2.8zm5.7-7.4c0 .6-.5 1-1 1s-1-.5-1-1 .5-1 1-1 1 .5 1 1z"/></svg>}
                {/* google_maps is in social{} for the JSON-LD sameAs list and the
                    footer link, but the template had no mark for it — the tile
                    rendered as an empty red square. A map pin, not a
                    reproduction of the Google logo. */}
                {platform === 'google_maps' && <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2a6.9 6.9 0 0 0-6.9 6.9c0 5 6.2 12.1 6.5 12.4a.55.55 0 0 0 .8 0c.3-.3 6.5-7.4 6.5-12.4A6.9 6.9 0 0 0 12 2.2Zm0 9.6a2.7 2.7 0 1 1 0-5.4 2.7 2.7 0 0 1 0 5.4Z"/></svg>}
              </a>
            ))}
          </div>
        )}
      </div>
      <div>
        <h3>Services</h3>
        <ul>{services.map((s) => <li><a href={`/services/${s.slug}`}>{s.data.title}</a></li>)}</ul>
      </div>
      <div>
        <h3>Service Areas</h3>
        <ul>{areas.map((a) => <li><a href={`/service-area/${a.slug}`}>{a.data.name}, {a.data.state}</a></li>)}</ul>
      </div>
      <div>
        <h3>Company</h3>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/our-work">Our Work</a></li>
          <li><a href="/pricing">Pricing</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-legal">
      <ul>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/terms">Terms of Service</a></li>
        <li><a href="/accessibility">Accessibility Statement</a></li>
      </ul>
      <p>© {year} {site.legal_name ?? site.business_name}. All rights reserved. Website Developed By <a href="https://mylocalads.co" rel="noopener" target="_blank">Mylocalads.co</a>.</p>
    </div>
  </div>
</footer>
<style>
  .site-footer { position: relative; overflow: hidden; background: var(--color-primary); color: var(--color-on-primary); padding: var(--space-5) 0 var(--space-3); margin-top: var(--space-5); }
  /* Oversized claw watermark bleeding off the right edge. Sign-off mark for the
     page — 0.12 opacity so it never touches the legibility of the columns. */
  .footer-claw { position: absolute; right: -4%; bottom: -30%; width: 34%; height: 150%; color: var(--color-accent); opacity: 0.12; pointer-events: none; }
  @media (max-width: 780px) { .footer-claw { width: 62%; right: -20%; opacity: 0.1; } }
  .footer-grid { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); }
  .brand { font-family: var(--font-display); font-size: 1.15rem; }
  .footer-logo { max-height: 76px; width: auto; display: block; margin-bottom: var(--space-2); }
  /* Reversed out on the black band: 4.5:1 or better for every text tier.
     rgba(255,255,255,0.72) on #101012 measures 9.6:1. */
  .tagline { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.95rem; color: var(--color-accent-on-dark); margin: 0 0 var(--space-2); }
  h3 { font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: var(--space-1); color: var(--color-on-primary); }
  ul { list-style: none; padding: 0; }
  ul li { padding: 0.25rem 0; }
  .footer-grid a { color: rgba(255,255,255,0.78); text-decoration: none; }
  .footer-grid a:hover, .footer-grid a:focus-visible { color: var(--color-accent-on-dark); text-decoration: underline; }
  address { font-style: normal; color: rgba(255,255,255,0.78); }
  address strong { color: var(--color-on-primary); }
  .footer-legal { position: relative; border-top: 1px solid rgba(255,255,255,0.16); padding-top: var(--space-2); margin-top: var(--space-3); display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--space-2); font-size: 0.875rem; color: rgba(255,255,255,0.72); }
  .footer-legal a { color: rgba(255,255,255,0.82); }
  .footer-legal a:hover, .footer-legal a:focus-visible { color: var(--color-accent-on-dark); }
  .footer-legal ul { display: flex; gap: var(--space-3); }
  .hours { margin-top: var(--space-2); }
  .hours ul { list-style: none; padding: 0; margin: var(--space-1) 0 0; font-size: 0.9rem; }
  .hours li { padding: 0.15rem 0; color: rgba(255,255,255,0.72); }
  .hours .day { text-transform: capitalize; color: var(--color-on-primary); font-weight: 600; }
  .footer-socials { display: flex; gap: 0.5rem; margin-top: var(--space-2); }
  .footer-socials .social-link { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 8px; background: var(--color-accent); color: var(--color-on-accent); transition: transform 0.15s ease, filter 0.15s ease; }
  .footer-socials .social-link:hover, .footer-socials .social-link:focus-visible { transform: translateY(-2px); filter: brightness(1.1); }
  @media (max-width: 780px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
