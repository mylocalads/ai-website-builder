---
import { getIcon } from '../lib/icons';

export interface Props {
  data?: {
    eyebrow?: string;
    headline: string;
    body: string;
    cta_text?: string;
    cta_href?: string;
    icon?: string;
    image?: string;
  };
}
const { data } = Astro.props;
const svg = getIcon(data?.icon);
---
{data && (
  <section class="promise-band" aria-label={data.headline}>
    {/* Two claws raked in from either edge. This is the single loudest band on
        the page — the guarantee — so it gets the mark at full size. */}
    <span class="claw band-claw left" aria-hidden="true"></span>
    <span class="claw band-claw right" aria-hidden="true"></span>
    <div class="container inner">
      {data.image
        ? <img class="band-img" src={data.image} alt="" loading="lazy" />
        : svg && (
            <span class="band-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor" set:html={svg} />
            </span>
          )}
      {data.eyebrow && <p class="eyebrow">{data.eyebrow}</p>}
      <h2>{data.headline}</h2>
      <p class="body">{data.body}</p>
      {data.cta_text && data.cta_href && (
        <a class="btn" href={data.cta_href}>{data.cta_text}</a>
      )}
    </div>
  </section>
)}
<style>
  /* Wolfpack: the guarantee band is the one full-crimson moment on the page.
     White on #EA0A2A measures 4.59:1 — AA for body copy, comfortably clear for
     the display sizes. Every other section keeps the accent to fills and marks
     so this one lands. */
  .promise-band { position: relative; overflow: hidden; background: var(--color-accent); color: var(--color-on-accent); padding: var(--space-5) 0; }
  /* Darker claws cut into the crimson, mirrored so the band reads as clawed
     from both sides. color-mix keeps them derived from the accent rather than
     a hardcoded second red that drifts if the brand colour ever changes. */
  .band-claw { position: absolute; top: -18%; width: 30%; height: 136%; color: color-mix(in srgb, var(--color-accent) 55%, #000000); opacity: 0.55; pointer-events: none; }
  .band-claw.left { left: -8%; }
  .band-claw.right { right: -8%; transform: scaleX(-1); }
  @media (max-width: 900px) { .band-claw { width: 52%; opacity: 0.4; } }

  .inner { position: relative; max-width: 780px; text-align: center; }
  .band-icon { display: inline-flex; align-items: center; justify-content: center; width: 4.5rem; height: 4.5rem; border-radius: 0; background: var(--color-on-accent); color: var(--color-accent); margin: 0 auto var(--space-3); transform: skewX(-11deg); }
  .band-icon svg { width: 2.4rem; height: 2.4rem; transform: skewX(11deg); }
  .band-img { width: 100%; max-width: 220px; height: auto; margin: 0 auto var(--space-3); display: block; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.2em; font-size: 0.95rem; font-weight: 800; color: var(--color-on-accent); margin: 0 0 var(--space-1); }
  h2 { font-family: var(--font-display); font-weight: 900; color: var(--color-on-accent); font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.08; margin: 0 0 var(--space-2); text-transform: uppercase; letter-spacing: -0.02em; }
  .body { color: var(--color-on-accent); font-size: 1.08rem; line-height: 1.7; margin: 0 0 var(--space-3); }
  /* Reversed button: black on crimson is 4.14:1 for the fill pair, so the
     button takes the wordmark black as the surface and white as the label —
     19:1, and it reads as a hard stamp rather than a tint of the band. */
  .btn { display: inline-block; background: var(--color-primary); color: var(--color-on-primary); padding: 0.9rem 1.75rem; border-radius: var(--radius-sm); font-weight: 800; font-size: 1.25rem; letter-spacing: 0.02em; text-decoration: none; text-transform: uppercase; }
  .btn:hover, .btn:focus-visible { background: #000000; }
</style>
