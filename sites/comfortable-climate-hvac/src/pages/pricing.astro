---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import HeroOwl from '../components/HeroOwl.astro';
import PricingTable from '../components/PricingTable.astro';
import Financing from '../components/Financing.astro';
import FAQ from '../components/FAQ.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import GHLChatWidget from '../components/GHLChatWidget.astro';

const site = (await getEntry('site', 'config')).data as any;
const pricingEntry = await getEntry('site', 'pricing').catch(() => null);
const pricing = (pricingEntry?.data as any) ?? { intro: 'Straightforward pricing.', packages: [], notes: undefined };
const homeEntry = await getEntry('site', 'home').catch(() => null);
const faqs = (homeEntry?.data as any)?.faqs ?? [];
const calendarSnippet = site.crm?.calendar_embed_snippet;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Pricing', href: '/pricing' }];

// Broad national installed-cost ranges for orientation only. These are NOT
// quotes and are deliberately wide — Comfortable Climate prices every job after
// an on-site diagnosis. Do not narrow these into something that reads as a
// price list.
const costRows = [
  { type: 'Gas furnace replacement', range: '$4,500–$9,000', note: 'Varies with efficiency rating, venting and duct condition' },
  { type: 'Central air conditioner replacement', range: '$5,000–$10,000', note: 'Driven by tonnage, SEER2 rating and line-set condition' },
  { type: 'Ductless mini-split (single zone)', range: '$4,000–$7,500', note: 'Multi-zone systems price per additional indoor head' },
  { type: 'Boiler replacement', range: '$7,000–$14,000', note: 'Steam, hydronic and condensing systems differ substantially' },
  { type: 'Water heater replacement', range: '$1,500–$3,500', note: 'Gas vs. electric, tank size, and venting requirements' },
  { type: 'Repairs and diagnostics', range: 'Quoted per visit', note: 'Most no-heat and no-cool calls are a repair, not a replacement' },
];
---
<BaseLayout
  title={`Pricing — ${site.business_name}`}
  description={`How Comfortable Climate prices heating, cooling and plumbing work across ${site.address.city}, ${site.address.state} — free estimates, written before any work starts.`}
  breadcrumbs={crumbs}
  pagePath="/pricing"
>
  <HeroOwl
    eyebrow="Transparent Pricing"
    headline="Pricing"
    subheadline={pricing.intro}
    cta_text="Get Your Free Estimate!"
    cta_href="/book"
    photo={site.default_hero_photo}
    show_form
    form_heading="Get a price for your system"
  />

  <section class="roof-cost">
    <div class="container">
      <h2>What HVAC work typically costs in {site.address.city}, {site.address.state}</h2>
      <p class="lede">These are broad installed-cost ranges for orientation, not quotes. Your number depends on the equipment you have, the condition of the ductwork or piping around it, and whether the job is genuinely a replacement at all — most calls turn out to be a repair. The only way to get a real figure is a free on-site diagnosis.</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Job</th><th>Typical installed range</th><th>What moves the number</th></tr>
          </thead>
          <tbody>
            {costRows.map((r) => (
              <tr><td>{r.type}</td><td>{r.range}</td><td>{r.note}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="factors"><strong>What we commit to:</strong> the estimate is free, it is written down before any work starts, and it is what you pay. If your system can be repaired rather than replaced, we tell you so.</p>
    </div>
  </section>

  {pricing.packages.length > 0 && <PricingTable packages={pricing.packages} />}
  {pricing.notes && (
    <section class="pricing-notes">
      <div class="container"><p>{pricing.notes}</p></div>
    </section>
  )}

  {calendarSnippet && (
    <section class="book">
      <div class="container">
        <h2>Book your free on-site estimate</h2>
        <p class="lede">Pick a time that works — we come out, diagnose the system, and give you a written quote on the spot.</p>
        <div class="calendar-wrap"><Fragment set:html={calendarSnippet} /></div>
      </div>
    </section>
  )}

  <Financing />
  <FAQ items={faqs} />
  <ClosingCTA />
  <GHLChatWidget />
</BaseLayout>
<style>
  .pricing-hero { padding: var(--space-5) 0; background-size: cover; background-position: center; background-repeat: no-repeat; color: white; }
  .pricing-hero h1 { color: white; font-size: clamp(2rem, 4vw, 3rem); text-shadow: 0 2px 8px rgba(0,0,0,0.3); }
  .pricing-hero p { color: rgba(255,255,255,0.9); font-size: 1.15rem; max-width: 45rem; }
  .roof-cost { padding: var(--space-5) 0; background: var(--color-surface); }
  .roof-cost h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); }
  .roof-cost .lede { color: var(--color-muted); max-width: 45rem; margin: 0 0 var(--space-3); }
  .table-wrap { overflow-x: auto; margin: var(--space-2) 0; }
  .roof-cost table { width: 100%; border-collapse: collapse; background: var(--color-bg); border-radius: var(--radius-md); overflow: hidden; }
  .roof-cost th, .roof-cost td { padding: var(--space-2); text-align: left; border-bottom: 1px solid var(--color-surface); }
  .roof-cost th { background: var(--color-text); color: white; font-family: var(--font-display); font-weight: 600; }
  .roof-cost tbody tr:last-child td { border-bottom: 0; }
  .roof-cost .factors { margin-top: var(--space-3); color: var(--color-muted); }
  .pricing-notes { padding: var(--space-3) 0; color: var(--color-muted); font-size: 0.95rem; }
  .book { padding: var(--space-5) 0; }
  .book h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); }
  .book .lede { color: var(--color-muted); max-width: 45rem; margin: 0 0 var(--space-3); }
  .calendar-wrap iframe { width: 100%; min-height: 700px; border: 0; }
</style>
