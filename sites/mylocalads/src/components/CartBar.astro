---
// Cart summary rendered directly below the add-on grid. Hidden until the cart
// holds at least one item.
//
// Recurring and one-time subtotals are shown separately rather than summed —
// adding "$397/mo" to "$500 once" would misstate what the customer owes. With
// the current all-recurring catalog only the monthly half renders.
---
<div class="cart-bar" data-cart-bar hidden>
  <div class="cart-bar-left">
    <span class="cart-bar-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" />
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
      </svg>
    </span>
    <div>
      <div class="cart-bar-total" data-cart-total></div>
      <div class="cart-bar-items" data-cart-items></div>
    </div>
  </div>
  <div class="cart-bar-right">
    <a href="/cart" class="cart-bar-review">Review</a>
    <span class="cart-bar-count" data-cart-count></span>
    <button type="button" class="btn btn-primary btn-sm" data-cart-checkout>Get Started →</button>
  </div>
</div>
<p class="cart-bar-error" data-cart-bar-error hidden></p>

<style>
  .cart-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin: var(--space-3) auto 0;
    max-width: 1100px;
    padding: var(--space-3);
    background: var(--color-bg-elev);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
  }
  .cart-bar[hidden] { display: none; }
  .cart-bar-left { display: flex; align-items: center; gap: var(--space-2); }
  .cart-bar-icon { color: #faf24c; display: inline-flex; }
  .cart-bar-total {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    color: #fff;
    line-height: 1.2;
  }
  .cart-bar-items {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin-top: 0.15rem;
  }
  .cart-bar-right { display: flex; align-items: center; gap: var(--space-2); }
  .cart-bar-count {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .cart-bar-review {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    text-decoration: underline;
    white-space: nowrap;
  }
  .cart-bar-review:hover { color: #fff; }
  .cart-bar-error {
    max-width: 1100px;
    margin: var(--space-2) auto 0;
    color: var(--color-orange);
    font-size: 0.85rem;
    text-align: center;
  }
  .cart-bar-error[hidden] { display: none; }
  @media (max-width: 560px) {
    .cart-bar { flex-direction: column; align-items: stretch; }
    .cart-bar-right { justify-content: space-between; }
  }
</style>
