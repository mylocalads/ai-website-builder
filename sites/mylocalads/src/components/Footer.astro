---
const logo = 'https://assets.cdn.filesafe.space/HAFfXMpiLRzX1mJeWK5g/media/646f73501647a84ed22f6a8d.png';
const year = new Date().getFullYear();

const socials = [
  { name: 'Facebook', href: 'https://www.facebook.com/MyLocalAds.Co' },
  { name: 'Instagram', href: 'https://www.instagram.com/mylocalads/' },
  { name: 'X', href: 'https://twitter.com/mylocalads_co' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/company/my-local-ads/' },
  { name: 'YouTube', href: 'https://www.youtube.com/channel/UCY5ZP4nrdWAp18OTy4JjU9g' },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col brand-col">
        <img src={logo} alt="My Local Ads" class="footer-logo" />
        <p class="tagline">Helping home service providers in America grow their business with Ads, AI, and more!</p>
        <div class="footer-portal-cta">
          <a href="https://app.mylocalads.co/" class="btn btn-primary btn-sm" rel="noopener">CRM Login</a>
          <a href="https://support.mylocalads.co/" class="btn btn-secondary btn-sm" rel="noopener">Support Portal</a>
        </div>
        <div class="footer-socials">
          {socials.map((s) => (
            <a href={s.href} rel="noopener" target="_blank" aria-label={s.name} class="social-link">
              {s.name === 'Facebook' && <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.7V3.6C16.5 3.6 15.5 3.5 14.4 3.5c-2.2 0-3.7 1.3-3.7 3.8v2.6H8v3.1h2.7V21h2.8z"/></svg>}
              {s.name === 'Instagram' && <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4 1 .5.5.7.9 1 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9 0 3.2 0 3.6-.1 4.9-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-1 1.4-.5.5-.9.7-1.4 1-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1-3.2 0-3.6 0-4.9-.1-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-1-.5-.5-.7-.9-1-1.4-.2-.4-.4-1-.4-2.2-.1-1.3-.1-1.7-.1-4.9 0-3.2 0-3.6.1-4.9.1-1.2.3-1.8.4-2.2.2-.6.5-1 1-1.4.5-.5.9-.7 1.4-1 .4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 5.4c-2.4 0-4.4 2-4.4 4.4s2 4.4 4.4 4.4 4.4-2 4.4-4.4-2-4.4-4.4-4.4zm0 7.2c-1.5 0-2.8-1.3-2.8-2.8s1.3-2.8 2.8-2.8 2.8 1.3 2.8 2.8-1.3 2.8-2.8 2.8zm5.7-7.4c0 .6-.5 1-1 1s-1-.5-1-1 .5-1 1-1 1 .5 1 1z"/></svg>}
              {s.name === 'X' && <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>}
              {s.name === 'LinkedIn' && <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 2h-17A1.5 1.5 0 0 0 2 3.5v17A1.5 1.5 0 0 0 3.5 22h17a1.5 1.5 0 0 0 1.5-1.5v-17A1.5 1.5 0 0 0 20.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 1 1 8.3 6.5a1.78 1.78 0 0 1-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0 0 13 14.19a.66.66 0 0 0 0 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 0 1 2.7-1.4c1.55 0 3.36.86 3.36 3.66z"/></svg>}
              {s.name === 'YouTube' && <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 7.2c-.2-.9-.9-1.6-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4c-.9.2-1.6.9-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8c.2.9.9 1.6 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4c.9-.2 1.6-.9 1.8-1.8.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5 3-5 3z"/></svg>}
            </a>
          ))}
        </div>
      </div>
      <div class="footer-col">
        <h3>Quick Links</h3>
        <ul>
          <li><a href="/planner">Campaign Planner</a></li>
          <li><a href="/#pricing">Pricing</a></li>
          <li><a href="/results">Results</a></li>
          <li><a href="/team">Team</a></li>
          <li><a href="/#faqs">FAQs</a></li>
          <li><a href="/contact-us">Contact Us</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h3>Contact Us</h3>
        <ul class="unstyled">
          <li><a href="tel:+18664511915">(866) 451-1915</a></li>
          <li><a href="mailto:support@mylocalads.co">support@mylocalads.co</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h3>Legal</h3>
        <ul>
          <li><a href="https://start.mylocalads.co/privacy-policy" rel="noopener">Privacy Policy</a></li>
          <li><a href="https://start.mylocalads.co/terms-of-service" rel="noopener">Terms Of Service</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-partners" aria-label="Advertising partner accreditations">
      <div class="footer-partner-badge">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M12 2.04C6.5 2.04 2 6.53 2 12.06c0 5 3.66 9.15 8.44 9.9v-7H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.89 3.77-3.89 1.09 0 2.23.19 2.23.19v2.47H15.19c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.9h-2.33v7A10 10 0 0 0 22 12.06c0-5.53-4.5-10.02-10-10.02Z"/>
        </svg>
        <div class="footer-partner-body">
          <span class="footer-partner-name">Meta</span>
          <span class="footer-partner-role">Business Partner</span>
        </div>
      </div>
      <div class="footer-partner-badge">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M21.35 11.1H12.18v2.84h5.24c-.24 1.44-1.71 4.22-5.24 4.22-3.15 0-5.72-2.61-5.72-5.83s2.57-5.83 5.72-5.83c1.8 0 3 .77 3.68 1.42l2.5-2.42C16.63 3.9 14.6 3 12.18 3 6.85 3 2.55 7.3 2.55 12.63s4.3 9.63 9.63 9.63c5.55 0 9.24-3.9 9.24-9.4 0-.63-.07-1.11-.17-1.76Z"/>
        </svg>
        <div class="footer-partner-body">
          <span class="footer-partner-name">Google</span>
          <span class="footer-partner-role">Business Partner</span>
        </div>
      </div>
    </div>

    <div class="footer-legal">
      <p class="disclaimer">
        My Local Ads LLC does not guarantee specific results or earnings from using our services or products. The examples and testimonials presented are for illustrative purposes only and do not guarantee similar results. Results may vary based on your individual business and market conditions. We make no warranties, express or implied, regarding the accuracy or performance of our services and tools. To the fullest extent permitted by law, we disclaim all implied warranties, including those of merchantability and fitness for a particular purpose.
      </p>
      <p class="disclaimer">
        My Local Ads LLC is an independent company and is not affiliated with or endorsed by Facebook, Google, or any other third-party platforms we may use for advertising and marketing services.
      </p>
      <p class="copyright">© My Local Ads {year} All Rights Reserved.</p>
    </div>
  </div>
</footer>
<style>
  .site-footer {
    background: #000000; color: #fff;
    padding: var(--space-5) 0 var(--space-3); margin-top: 0;
    border-top: 1px solid var(--color-border);
  }
  .site-footer a:not(.btn) { color: #fff; text-decoration: none; }
  .site-footer a:not(.btn):hover, .site-footer a:not(.btn):focus-visible { color: var(--color-accent-soft); text-decoration: underline; }
  .footer-grid {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-4);
  }
  .footer-col h3 {
    color: #fff; font-size: 0.9rem;
    text-transform: uppercase; letter-spacing: 0.12em;
    margin: 0 0 var(--space-2); font-weight: 700;
  }
  .footer-logo { max-height: 72px; width: auto; margin-bottom: var(--space-2); }
  .tagline { color: #C9D8E0; margin-bottom: var(--space-2); }
  .footer-portal-cta { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: var(--space-2) 0; }
  .footer-portal-cta .btn { text-decoration: none; }
  .footer-col ul { list-style: none; padding: 0; margin: 0; }
  .footer-col ul li { padding: 0.3rem 0; }
  .footer-socials { display: flex; gap: 0.5rem; margin-top: var(--space-2); }
  .social-link {
    display: inline-flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; border-radius: var(--radius-sm);
    background: var(--color-accent); color: #fff !important;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .social-link:hover, .social-link:focus-visible {
    transform: translateY(-2px); background: var(--color-accent-hover);
    text-decoration: none !important;
  }
  .footer-partners {
    display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  .footer-partner-badge {
    display: inline-flex; align-items: center; gap: 0.7rem;
    padding: 0.6rem 1rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: #fff;
  }
  .footer-partner-badge svg { flex-shrink: 0; opacity: 0.9; }
  .footer-partner-body { display: flex; flex-direction: column; line-height: 1.15; }
  .footer-partner-name { font-family: var(--font-display); font-weight: 800; font-size: 0.95rem; }
  .footer-partner-role {
    font-family: var(--font-body); font-weight: 500;
    color: var(--color-text-muted); font-size: 0.75rem;
  }

  .footer-legal {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: var(--space-3); margin-top: var(--space-3);
  }
  .footer-legal .disclaimer { color: #AFB8BC; font-size: 0.78rem; margin-bottom: var(--space-1); }
  .copyright { color: #8893A8; font-size: 0.85rem; margin: var(--space-2) 0 0; }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
