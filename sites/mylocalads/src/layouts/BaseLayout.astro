---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
}

const { title, description, canonical, ogImage } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const defaultOg = ogImage ?? 'https://assets.cdn.filesafe.space/HAFfXMpiLRzX1mJeWK5g/media/646f73501647a84ed22f6a8d.png';

// One @graph rather than separate blocks, so Organization and WebSite are
// linked by @id and search engines resolve them as the same entity. Pages add
// their own schema (FAQPage, Service/Offer) through the `head` slot below.
const siteLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://mylocalads.co/#organization',
      name: 'My Local Ads',
      legalName: 'My Local Ads LLC',
      url: 'https://mylocalads.co',
      logo: 'https://assets.cdn.filesafe.space/HAFfXMpiLRzX1mJeWK5g/media/646f73501647a84ed22f6a8d.png',
      image: 'https://assets.cdn.filesafe.space/HAFfXMpiLRzX1mJeWK5g/media/646f73501647a84ed22f6a8d.png',
      telephone: '+18664511915',
      email: 'support@mylocalads.co',
      description:
        'Marketing supplier for home service contractors — exclusive pay-per-lead advertising, local SEO, websites, CRM, and AI agents.',
      areaServed: { '@type': 'Country', name: 'United States' },
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+18664511915',
        email: 'support@mylocalads.co',
        contactType: 'sales',
        areaServed: 'US',
        availableLanguage: 'en',
      },
      sameAs: [
        'https://www.facebook.com/MyLocalAds.Co',
        'https://www.instagram.com/mylocalads/',
        'https://twitter.com/mylocalads_co',
        'https://www.linkedin.com/company/my-local-ads/',
        'https://www.youtube.com/channel/UCY5ZP4nrdWAp18OTy4JjU9g',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://mylocalads.co/#website',
      url: 'https://mylocalads.co',
      name: 'My Local Ads',
      inLanguage: 'en-US',
      publisher: { '@id': 'https://mylocalads.co/#organization' },
    },
  ],
};
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="content-language" content="en-us" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="My Local Ads" />
    <meta property="og:image" content={defaultOg} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={defaultOg} />

    <link rel="icon" type="image/png" href="https://assets.cdn.filesafe.space/HAFfXMpiLRzX1mJeWK5g/media/646f73501647a84ed22f6a8d.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&family=Montserrat:wght@400;600;700;800&display=swap" />

    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />

    {/* Pages inject their own structured data and agent summaries here. */}
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-nav">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />

    <script>
      // Keeps the header cart badge in sync on every page, so the cart is
      // visible wherever the visitor navigates.
      import { cart } from '../lib/cart-store.js';
      cart.subscribe((items) => {
        document.querySelectorAll('[data-cart-badge]').forEach((el) => {
          el.hidden = items.length === 0;
        });
        document.querySelectorAll('[data-cart-badge-count]').forEach((el) => {
          el.textContent = String(items.length);
        });
      });
    </script>
  </body>
</html>
