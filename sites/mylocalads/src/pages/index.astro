---
import BaseLayout from '../layouts/BaseLayout.astro';
import BottomCTA from '../components/BottomCTA.astro';
import AddOnCard from '../components/AddOnCard.astro';
import CartBar from '../components/CartBar.astro';
import { addOns, bySection } from '../data/addOns.js';

const partners = [
  { name: 'Klaus Roofing Systems', logo: 'https://msgsndr-private.storage.googleapis.com/locationPhotos/39c82c0b-1eeb-477e-8070-19517afe234e.png' },
  { name: 'Partner', logo: 'https://images.leadconnectorhq.com/image/f_webp/q_80/r_1200/u_https://cdn.filesafe.space/locationPhotos%2FMbfynyuvfW7xQSprWY1K.png?alt=media&token=55af8d67-2148-461d-b9cc-13a681380f40' },
  { name: 'KRS Upstate NY', logo: 'https://cdn.treehouseinternetgroup.com/cms_images/3238/KRS-of-Upstate-New-York-Logo.svg' },
  { name: 'Partner', logo: 'https://images.leadconnectorhq.com/image/f_webp/q_80/r_1200/u_https://assets.cdn.filesafe.space/z3EkWHCfxj0adESFsfwp/media/665498a34215bcfe1820f7a8.png' },
  { name: 'Altitude Roofing NM', logo: 'https://www.altituderoofingnm.com/wp-content/uploads/2024/10/Untitled-design-28.png' },
  { name: 'Partner', logo: 'https://images.leadconnectorhq.com/image/f_webp/q_80/r_1200/u_https://assets.cdn.filesafe.space/6P6d6CTfyHPLuLt14aB9/media/66e2dd31e662a0b58077a2b6.png' },
];

const ppl_baseIncluded = [
  'Exclusive homeowner leads',
  'Project details included',
  'Lead nurturing sequences',
  '7 days to dispute a lead',
  '24/7 email support',
  'TCPA compliance certificate',
];

const pplTiers = [
  {
    name: '3-Month Commit',
    cartId: 'ppl-ads-3mo',
    subtitle: 'For testing the waters',
    priceBooked: '$85',
    priceForm: '$35',
    ctaLabel: 'Get Started',
    ctaHref: '/booking-page',
    ctaStyle: 'btn-secondary',
    included: ppl_baseIncluded,
  },
  {
    name: '6-Month Commit',
    cartId: 'ppl-ads-6mo',
    subtitle: 'Most popular',
    priceBooked: '$75',
    priceForm: '$25',
    ctaLabel: 'Get Started',
    ctaHref: '/booking-page',
    ctaStyle: 'btn-primary',
    included: ppl_baseIncluded,
    highlight: true,
    badge: 'Save $10/Lead',
  },
  {
    name: '12-Month Commit',
    cartId: 'ppl-ads-12mo',
    subtitle: 'Best value, biggest savings',
    priceBooked: '$65',
    priceForm: '$15',
    ctaLabel: 'Get Started',
    ctaHref: '/booking-page',
    ctaStyle: 'btn-secondary',
    included: ppl_baseIncluded,
    badge: 'Save $20/Lead',
  },
];


const howItWorks = [
  {
    step: '1',
    title: 'Book a call with our team!',
    body: 'Walk us through your business — we map your local market, competitor lead flow, and what you\'d need to hit your growth targets.',
  },
  {
    step: '2',
    title: 'Choose your path to grow!',
    options: ['Meta Ads', 'Google Ads', 'CRM', 'AI Receptionist', 'Website', 'Local SEO'],
    body: 'Real experts + AI Agents in the loop get to work.',
  },
  {
    step: '3',
    title: 'Grow your business!',
    body: 'Qualified and exclusive leads & cost-effective marketing that drives the needle.',
  },
];

// bgImage URLs are placeholders (loremflickr serves industry-keyword photos).
// Swap for licensed industry photography (Unsplash, Pexels, or client-owned) when ready.
// What a lead actually IS, stated once. Identical across every industry, so it
// lives here rather than being repeated five times in the data — it renders in
// the slot the old "Track:" line used to occupy.
const LEAD_TYPES =
  'Leads are in-person booked estimates and estimate inquiries (via form / call).';

// Categories we serve beyond the five tiles above.
const moreCategories = [
  'Plumbing',
  'Landscaping',
  'Tree Services',
  'Electricians',
  'Decking',
  'Siding',
];

const industries = [
  {
    slug: 'roofing',
    name: 'Roofing',
    tagline:
      'You will receive residential roof installation, replacement, and repair leads.',
    // Portrait source in a landscape tile, so `cover` crops top and bottom.
    // Biased upward to keep the exposed decking and shingle bundles in frame
    // rather than centring on the ground debris.
    bgPosition: 'center 35%',
    icon: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12l9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg>`,
    bgImage: '/industries/roofing.webp',
  },
  {
    slug: 'general-contractors',
    name: 'General Contractors',
    tagline:
      'You will receive multi-phase remodel, addition, and full-service build leads.',
    icon: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3l7 7-4 4-7-7z"/><path d="M10 7L3 14l4 4 7-7"/><path d="M8 19l-3 3"/></svg>`,
    bgImage: 'https://loremflickr.com/1200/800/construction,site,worker?lock=102',
  },
  {
    slug: 'concrete',
    name: 'Concrete',
    tagline: 'You will receive driveway, patio, walkway, and slab leads.',
    icon: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="10" rx="1"/><path d="M7 7v10"/><path d="M12 7v10"/><path d="M17 7v10"/></svg>`,
    bgImage: 'https://loremflickr.com/1200/800/concrete,driveway?lock=103',
  },
  {
    slug: 'kitchen-bath',
    name: 'Kitchen & Bath',
    tagline:
      'You will receive kitchen, bathroom, and whole-home remodel leads.',
    icon: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h16"/><path d="M4 8v10a2 2 0 002 2h12a2 2 0 002-2V8"/><path d="M9 4h6v4H9z"/></svg>`,
    bgImage: 'https://loremflickr.com/1200/800/kitchen,remodel?lock=104',
  },
];

const categories = [
  'General Contractors',
  'Roofers',
  'Concrete Contractors',
  'Kitchen Remodelers',
  'Bathroom Remodelers',
  '& Similar...',
];

const faqs = [
  { q: 'How do I get started?', a: 'Get started here by clicking \'Get More Leads\' and following the signup and onboarding process.' },
  { q: 'Do your prices include Ad budgets?', a: 'No, our pay-per-lead prices do not include the cost of the advertising budget. You pay for the ads separately.' },
  { q: 'How is your customer support?', a: 'We provide 24/7 email customer support and we usually resolve our tickets in less than 12 hrs if it\'s not a deep technical issue. Our support team is a mix of admins and advertising experts which enables us to support clients with the best expertise in the industry.' },
  { q: 'Can I buy your plans individually?', a: 'Yes, you can buy each of our plans individually.' },
  { q: 'Is there a commitment required?', a: 'We have 3-month (minimum), 6-month, and 12-month commitment offers. Terms of service apply.' },
  { q: 'Are the leads shared?', a: 'Never! All of our leads are generated directly from direct response campaigns, showing your brand, and we do not share lead information with multiple contractors at the same time. This creates high-intent leads for your business, and a much higher chance to close more jobs.' },
  { q: 'How are these leads generated?', a: 'Every lead we generate for you is generated with direct response campaigns across search engines and social media platforms. That means, a) these leads see your brand and offer in the ad, and b) they have decided to inquire about your services. We do not reactivate stale leads. We do not scrape & sell contact lists. We do not sell shared leads.' },
  { q: 'How will I receive new leads?', a: 'You will receive leads via email, and your leads will also be available in their CRM account if the access was purchased.' },
  { q: 'Do you qualify leads for us?', a: 'Yes, our leads are qualified before they reach your inbox. Phone numbers and Emails are also \'look-up\' verified, to make sure your team is not bogged down by spam leads. Lastly, we have human(s) in the loop to quality check each lead generated to ensure quality.' },
  { q: 'Are your leads TCPA compliant?', a: 'Yes! All of our leads come with a TCPA compliant certificate and full session recording of their sign-up to make sure that you can safely follow up with these leads.' },
  { q: 'Are your leads re-sold?', a: 'No! We only sell direct-response leads, meaning when our leads sign-up with you, they just converted from an ad online, and the lead wants to take action now! We do not re-sell or buy stale or old leads.' },
  { q: 'Can I dispute leads?', a: 'Absolutely. You can dispute any lead within 7 days if it doesn\'t meet our qualification standards described in our terms of service. If approved, you\'ll receive a credit toward future leads.' },
  { q: 'How long will it take for me to get leads?', a: 'Since we do not scrape leads, or re-sell old leads, we need about 5-20 business days after our initial setup to generate a consistent flow of leads for you.' },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title="My Local Ads | In Ads We Trust!"
  description="Our team spent $150MM+ on Facebook & Google Ads to understand what works and what doesn't for your home service business. Let's get you on the right path with our pay-per-lead model."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} slot="head" />

  {/* HERO */}
  <section class="hero">
    <div class="container hero-inner">
      <h1>The #1 Marketing Supplier For America's Top <span class="hl">Builders</span>!</h1>
      <p class="hero-sub">We're your AI-native marketing supplier handling lead generation, websites, SEO, and a custom CRM solution. Real marketing, done by <strong>real experts</strong> and AI agents in the loop. Not the other way around!</p>
      <div class="hero-ctas">
        <a href="/booking-page" class="btn btn-primary btn-lg">Get More Leads!</a>
        <a href="/booking-page" class="btn btn-secondary btn-lg">Book A Call</a>
      </div>

      <div class="hero-social-feed">
        <p class="hero-social-feed-label">Live from our Facebook — fresh campaign breakdowns</p>
        <div class="elfsight-embed">
          <script src="https://static.elfsight.com/platform/platform.js" async></script>
          <div class="elfsight-app-55b1cb14-add9-4f8a-8944-e7f14522a25c" data-elfsight-app-lazy></div>
        </div>
      </div>
    </div>
  </section>

  {/* PARTNERS — one horizontal line: title-left, logos flowing right */}
  <section class="partners-band">
    <div class="container partners-row">
      <div class="partners-title-block">
        <span class="partners-title-main">Trusted By</span>
        <span class="partners-title-sub">&amp; 100+ Other Contractors!</span>
      </div>
      <div class="partners-logos">
        <div class="partners-logos-track">
          {partners.map((p) => (
            <img src={p.logo} alt={p.name} loading="lazy" class="partner-logo" />
          ))}
          {partners.map((p) => (
            <img src={p.logo} alt="" aria-hidden="true" loading="lazy" class="partner-logo partner-logo-dup" />
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ABOUT MY LOCAL ADS — split-screen with founders photo + note */}
  <section class="section about-mla-section" id="about">
    <div class="container">
      <div class="about-mla">
        <div class="about-mla-photo">
          <img
            src="https://assets.cdn.filesafe.space/HAFfXMpiLRzX1mJeWK5g/media/6a67a229b7fe5a8e3108ce34.png"
            alt="Eric Meese and Marcellus Gaag — Co-founders of My Local Ads"
            class="about-mla-photo-img"
            width="1152"
            height="928"
          />
        </div>
        <div class="about-mla-body">
          <span class="eyebrow">About My Local Ads</span>
          <h2>Founder's Note</h2>
          <p class="about-mla-lede">Every roof replaced, every kitchen remodeled, every driveway poured — that's a family building the life they want, and a contractor building the business they've worked for.</p>
          <p>We started My Local Ads because too many great American contractors were losing that fight to opaque agency contracts, shared leads, and marketing that never quite turned into booked work. Since 2022 we've partnered with <strong>300+ home service businesses</strong> — from solo roofers to national brands like Klaus Roofing Systems — putting over <strong>$150MM+ into ad campaigns that actually book jobs</strong>.</p>
          <a href="/booking-page" class="btn btn-primary btn-lg about-mla-cta">Meet With Our Team!</a>
        </div>
      </div>
    </div>
  </section>

  {/* HOW IT WORKS — 3-step process */}
  <section class="section how-it-works-section" id="how-it-works">
    <div class="container">
      <div class="text-center section-heading">
        <span class="eyebrow">How It Works</span>
        <h2>Leverage Real Marketing Pros With AI Agents In The Loop</h2>
        <p class="section-lead">Simple, transparent, and built to move fast. No 90-day agency onboardings — your campaigns and setups go live in days.</p>
      </div>
      <div class="hiw-grid">
        {howItWorks.map((s) => (
          <div class="hiw-card">
            <div class="hiw-step">{s.step}</div>
            <h3 class="hiw-title">{s.title}</h3>
            {s.options && (
              <ul class="hiw-options">
                {s.options.map((o) => <li>{o}</li>)}
              </ul>
            )}
            <p class="hiw-body">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* CHOOSE YOUR INDUSTRY */}
  <section class="section section-alt industries-section" id="industries">
    <div class="container">
      <div class="text-center section-heading">
        <span class="eyebrow">Industries We Serve</span>
        <h2>Performance Marketing For Your Industry</h2>
        <p class="section-lead">Same playbook, tuned to how your specific corner of home services actually buys, closes, and scales.</p>
      </div>
      <div class="industries-grid">
        {industries.map((i, idx) => (
          /* An odd number of industries leaves the last one alone in a 2-col
             row with a hole beside it. Let it span the full width instead. */
          <div
            class={`industry-card${
              industries.length % 2 === 1 && idx === industries.length - 1
                ? ' industry-card-wide'
                : ''
            }`}
            style={[
              i.bgImage && `background-image: url('${i.bgImage}');`,
              // Real photos have different focal points, so each tile can aim
              // its own crop. Falls back to the stylesheet's `center`.
              i.bgPosition && `background-position: ${i.bgPosition};`,
            ]
              .filter(Boolean)
              .join(' ')}
          >
            <div class="industry-card-overlay" aria-hidden="true"></div>
            <div class="industry-card-content">
              <div class="industry-card-head">
                <div class="industry-icon" set:html={i.icon}></div>
              </div>
              <h3 class="industry-name">{i.name}</h3>
              <p class="industry-tagline">{i.tagline}</p>
              <p class="industry-leadtypes">{LEAD_TYPES}</p>
              <a href="/booking-page" class="btn btn-secondary btn-sm industry-cta">Book A Call</a>
            </div>
          </div>
        ))}

        {/* Spans the full grid width — the catch-all for everything not given
            its own tile above. */}
        <div class="industry-card industry-card-more">
          <div class="industry-card-content">
            <h3 class="industry-name">&amp; More Home Service Business Categories</h3>
            <ul class="more-category-list">
              {moreCategories.map((c) => (
                <li class="more-category">{c}</li>
              ))}
              <li class="more-category more-category-etc">&amp; More</li>
            </ul>
            <p class="industry-leadtypes">{LEAD_TYPES}</p>
            <a href="/booking-page" class="btn btn-secondary btn-sm industry-cta">Book A Call</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* PAY PER LEAD ADVERTISING — 3 commit-length tiles */}
  <section class="section" id="pricing">
    <div class="container">
      <div class="text-center section-heading">
        <span class="eyebrow">Pay Per Lead</span>
        <h2>Pay Per Lead Advertising</h2>
        <p class="section-lead">Every lead comes from a direct-response ad we run on <strong>Meta (Facebook &amp; Instagram)</strong> and <strong>Google (Search, YouTube, Local Services)</strong> — exclusive to you, never shared, always ready to book. Choose the commitment length that fits your growth plan.</p>
      </div>

      <div class="ppl-tiles">
        {pplTiers.map((t) => (
          <div class={`ppl-tile${t.highlight ? ' ppl-tile-highlight' : ''}`}>
            {t.highlight && <div class="ppl-tile-banner">Most Popular</div>}
            <div class="ppl-tile-head">
              <h3 class="ppl-tile-plan">Ads Plan</h3>
              <h4 class="ppl-tile-name">{t.name}</h4>
              <p class="ppl-tile-subtitle">{t.subtitle}</p>
            </div>

            <div class="ppl-tile-channels-label">Channels we run ads on:</div>
            <div class="ppl-tile-channels" aria-label="Advertising channels">
              <span class="channel-badge">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
                  <path d="M12 2.04C6.5 2.04 2 6.53 2 12.06c0 5 3.66 9.15 8.44 9.9v-7H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.89 3.77-3.89 1.09 0 2.23.19 2.23.19v2.47H15.19c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.9h-2.33v7A10 10 0 0 0 22 12.06c0-5.53-4.5-10.02-10-10.02Z"/>
                </svg>
                Meta
              </span>
              <span class="channel-badge">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
                  <path d="M21.35 11.1H12.18v2.84h5.24c-.24 1.44-1.71 4.22-5.24 4.22-3.15 0-5.72-2.61-5.72-5.83s2.57-5.83 5.72-5.83c1.8 0 3 .77 3.68 1.42l2.5-2.42C16.63 3.9 14.6 3 12.18 3 6.85 3 2.55 7.3 2.55 12.63s4.3 9.63 9.63 9.63c5.55 0 9.24-3.9 9.24-9.4 0-.63-.07-1.11-.17-1.76Z"/>
                </svg>
                Google
              </span>
            </div>

            <div class="ppl-tile-price">
              <div class="ppl-tile-price-row">
                <span class="ppl-tile-amount">{t.priceBooked}</span>
                <span class="ppl-tile-per">/ booked inspection lead</span>
              </div>
              <div class="ppl-tile-price-row ppl-tile-price-row-sub">
                <span class="ppl-tile-amount-sub">{t.priceForm}</span>
                <span class="ppl-tile-per">/ form or call lead</span>
              </div>
              {t.badge && <span class="ppl-tile-badge">{t.badge}</span>}
            </div>

            <div class="ppl-tile-features">
              <div class="ppl-tile-features-label">Everything included:</div>
              <ul>
                {t.included.map((f) => (
                  <li><span class="check">✓</span> {f}</li>
                ))}
              </ul>
            </div>

            <div class="ppl-tile-setup">
              <span class="ppl-tile-setup-was">$5,000</span>
              <span class="ppl-tile-setup-now">$2,500</span>
              <span class="ppl-tile-setup-label">one-time setup</span>
            </div>

            <div class="ppl-tile-actions">
              <a
                href={t.ctaHref}
                class="btn btn-primary btn-sm ppl-tile-cart"
                data-cart-toggle={t.cartId}
                rel="noopener"
              >Add to cart</a>
              <a href={t.ctaHref} class="ppl-tile-book" rel="noopener">or book a call</a>
            </div>
          </div>
        ))}
      </div>

      <CartBar />

      <p class="disclaimer text-center ppl-disclaimer">
        Prices do not include ad budget. Minimum $2,500 advertising budget required. Terms of Service apply.
      </p>
    </div>
  </section>

  {/* ADD-ONS */}
  <section class="section" id="add-ons">
    <div class="container">
      <div class="text-center section-heading">
        <span class="eyebrow">Add-Ons</span>
        <h2>Growth Add-Ons</h2>
        <p class="section-lead">Get better marketing results with our partner tools and custom white-glove services.</p>
      </div>
      <div class="addon-grid">
        {bySection('addons').map((a) => <AddOnCard addOn={a} />)}
      </div>
      <CartBar />
    </div>
  </section>

  {/* CASE STUDIES — DM Construction video */}
  <section class="section section-alt" id="case-studies">
    <div class="container container-narrow">
      <div class="text-center section-heading">
        <span class="eyebrow">Case Study</span>
        <h2>Breaking Down What Works In 2026!</h2>
        <p class="section-lead">Watch the full breakdown of what we did for DM Construction of SWFL (General Contractor) — start to finish, real numbers.</p>
      </div>
      <div class="case-video-frame">
        <video
          class="case-video"
          controls
          preload="none"
          playsinline
          poster="https://assets.cdn.filesafe.space/HAFfXMpiLRzX1mJeWK5g/media/67b73888c5b8394682c0233d.jpeg"
        >
          <source src="https://assets.cdn.filesafe.space/HAFfXMpiLRzX1mJeWK5g/media/67b73af381979580d9ecfdbf.mp4" type="video/mp4" />
          Your browser does not support embedded video.
          <a href="https://assets.cdn.filesafe.space/HAFfXMpiLRzX1mJeWK5g/media/67b73af381979580d9ecfdbf.mp4">Download the case study video</a>.
        </video>
      </div>
      <div class="text-center case-cta">
        <a href="/booking-page" class="btn btn-primary btn-lg">Get More Leads!</a>
      </div>
    </div>
  </section>

  {/* CATEGORIES — matches live: black bg, big blue-accented headline */}
  <section class="section categories-section">
    <div class="container text-center">
      <h2 class="categories-title">Let's Build <span class="hl">America</span> Together!</h2>
      <p class="section-lead muted">We work best with home service businesses in the following categories.</p>
      <div class="category-grid">
        {categories.map((c) => (
          <div class="category-chip">{c}</div>
        ))}
      </div>
      <p class="muted" style="max-width: 720px; margin: var(--space-3) auto;">
        If your business category is not listed here don't hesitate to contact us at <a href="mailto:support@mylocalads.co">support@mylocalads.co</a>. We've also had tremendous success with other business categories that are not listed here.
      </p>
      <div class="hero-ctas" style="justify-content: center;">
        <a href="/booking-page" class="btn btn-primary btn-lg">Get More Leads!</a>
        <a href="/#case-studies" class="btn btn-secondary btn-lg">Watch Case Study!</a>
      </div>
    </div>
  </section>

  {/* FAQs */}
  <section class="section section-alt" id="faqs">
    <div class="container container-narrow">
      <div class="text-center">
        <span class="eyebrow">FAQs</span>
        <h2>Still Got Questions?</h2>
        <a href="/booking-page" class="btn btn-primary">Book A Call!</a>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary><span class="faq-q">{f.q}</span><span class="faq-toggle" aria-hidden="true">+</span></summary>
            <div class="faq-a">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <BottomCTA />
</BaseLayout>

<script>
  // Upgrades the add-on tiles from plain product links into cart controls, and
  // keeps the cart bar in sync. Everything degrades to the fallback links if
  // this never runs.
  import { cart, addOns } from '../lib/cart-store.js';
  import { startCheckout } from '../lib/checkout-client.js';

  const money = (cents) => `$${(cents / 100).toLocaleString('en-US')}`;

  function summaryLine(t) {
    if (t.trialApplies) return `Free for 7 days, then ${money(t.recurringCents)}/mo`;
    const parts = [];
    if (t.recurringCents) parts.push(`${money(t.recurringCents)}/mo`);
    if (t.oneTimeCents) parts.push(`${money(t.oneTimeCents)} once`);
    return parts.join(' + ') || '$0';
  }

  const titleOf = (id) => addOns.find((a) => a.id === id)?.title ?? id;

  cart.subscribe((items) => {
    document.querySelectorAll('[data-cart-toggle]').forEach((el) => {
      const inCart = items.includes(el.getAttribute('data-cart-toggle'));
      el.dataset.inCart = String(inCart);
      el.textContent = inCart ? 'Added ✓' : 'Add to cart';
    });

    // Two bars on this page (Pay-Per-Lead and Growth Add-Ons). Both read the
    // same store, so they always show the same cart.
    const bars = document.querySelectorAll('[data-cart-bar]');
    const t = cart.totals();

    bars.forEach((bar) => {
      bar.hidden = items.length === 0;
      if (items.length === 0) return;
      bar.querySelector('[data-cart-total]').textContent = summaryLine(t);
      bar.querySelector('[data-cart-items]').textContent = items.map(titleOf).join(' · ');
      bar.querySelector('[data-cart-count]').textContent =
        `${t.count} item${t.count === 1 ? '' : 's'}`;
    });
  });

  document.querySelectorAll('[data-cart-toggle]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      const id = el.getAttribute('data-cart-toggle');

      // Removing a prerequisite takes its dependents with it — say so first.
      if (cart.has(id)) {
        const dependents = cart.dependents(id);
        if (dependents.length) {
          const names = dependents.map(titleOf).join(', ');
          if (!confirm(`Removing ${titleOf(id)} will also remove: ${names}. Continue?`)) return;
        }
      }
      cart.toggle(id);
    });
  });

  // Cart bar checkout: creates the Stripe session and leaves the site, with no
  // intermediate page. /cart remains available via the bar's Review link and
  // the header badge.
  document.querySelectorAll('[data-cart-checkout]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const err = btn.closest('.cart-bar')?.parentElement
        ?.querySelector('[data-cart-bar-error]');
      btn.disabled = true;
      btn.textContent = 'Starting checkout…';
      if (err) err.hidden = true;

      const result = await startCheckout();
      if (!result.ok && err) {
        err.innerHTML = result.html;
        err.hidden = false;
      }

      btn.disabled = false;
      btn.textContent = 'Get Started →';
    });
  });
</script>

