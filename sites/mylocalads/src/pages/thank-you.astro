---
// Kept as a real page, not a redirect: /thank-you existed on the GoHighLevel
// site at mylocalads.co and is the kind of URL a form's post-submit redirect
// points at. Bouncing someone to the homepage right after they submit reads as
// a failure, and any GHL form still configured to land here would look broken.
import BaseLayout from '../layouts/BaseLayout.astro';
import BottomCTA from '../components/BottomCTA.astro';
---
<BaseLayout
  title="Thank You! | My Local Ads"
  description="Thanks for reaching out to My Local Ads. Our team will be in touch within one business day."
>
  <section class="section">
    <div class="container container-narrow text-center">
      <span class="eyebrow">Thank You</span>
      <h1>We Got Your Message!</h1>
      <p class="lead">
        Thanks for reaching out. Our team will be in touch within one business day. Need us
        sooner? Call <a href="tel:+18664511915">(866) 451-1915</a>.
      </p>
      <div class="ty-ctas">
        <a href="/booking-page" class="btn btn-primary btn-lg">Book A Call</a>
        <a href="/" class="btn btn-secondary btn-lg">Back To Home</a>
      </div>
    </div>
  </section>

  <BottomCTA />
</BaseLayout>

<style>
  .lead { font-size: 1.2rem; color: var(--color-text-muted); margin: 0 auto var(--space-4); max-width: 620px; }
  .ty-ctas { display: flex; gap: var(--space-2); justify-content: center; flex-wrap: wrap; }
</style>
