---
import BaseLayout from '../layouts/BaseLayout.astro';
import BottomCTA from '../components/BottomCTA.astro';

// Two-column cart: line items on the left, a sticky order summary on the right
// that collapses under the items on mobile. Reachable from the header badge and
// the cart bar's Review link; the bar itself checks out directly.
//
// Terms of Service and Privacy acceptance happens on Stripe's hosted page.
---
<BaseLayout
  title="Your Cart | My Local Ads"
  description="Review your selected Growth Add-Ons and check out securely with Stripe."
>
  <section class="section cart-section">
    <div class="container">
      <div class="text-center section-heading">
        <span class="eyebrow">Your Cart</span>
        <h1>Review Your Order</h1>
      </div>

      <div class="cart-empty" data-cart-empty hidden>
        <div class="cart-empty-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" />
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
          </svg>
        </div>
        <h2 class="cart-empty-title">Your cart is empty</h2>
        <p class="cart-empty-body">Add a Growth Add-On to get started.</p>
        <a href="/#add-ons" class="btn btn-primary">Browse Growth Add-Ons</a>
      </div>

      <div class="cart-layout" data-cart-filled hidden>
        <div class="cart-main">
          <div class="cart-main-head">
            <h2 class="cart-col-title">Items</h2>
            <span class="cart-col-count" data-cart-count></span>
          </div>
          <ul class="cart-lines" data-cart-lines></ul>
          <a href="/#add-ons" class="cart-continue">← Add more add-ons</a>
        </div>

        <aside class="cart-aside">
          <div class="cart-summary">
            <h2 class="cart-summary-title">Order Summary</h2>

            <ul class="cart-breakdown" data-cart-breakdown></ul>

            <div class="cart-summary-rows">
              <div class="cart-summary-row">
                <span>Subtotal</span><span data-sum-subtotal></span>
              </div>
              <div class="cart-summary-row" data-row-trial hidden>
                <span>7-day free trial</span><span class="cart-credit" data-sum-trial></span>
              </div>
              <div class="cart-summary-row cart-summary-row-muted">
                <span>Taxes</span><span>Calculated at checkout</span>
              </div>
            </div>

            <div class="cart-due">
              <span>Due today</span>
              <span class="cart-due-amount" data-sum-due></span>
            </div>
            <p class="cart-recurring-note" data-recurring-note></p>

            <button type="button" class="btn btn-primary cart-checkout" data-checkout>
              Checkout →
            </button>
            <p class="cart-error" data-cart-error hidden></p>

            <p class="cart-terms">
              Terms of Service and Privacy Policy are presented at payment.
            </p>

            <p class="cart-secure">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
              </svg>
              Payments processed securely by Stripe
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <BottomCTA />
</BaseLayout>

<script>
  import { cart, addOns } from '../lib/cart-store.js';
  import { startCheckout } from '../lib/checkout-client.js';

  const money = (cents) => `$${(cents / 100).toLocaleString('en-US')}`;
  const $ = (sel) => document.querySelector(sel);
  const byId = (id) => addOns.find((a) => a.id === id);

  const checkoutBtn = $('[data-checkout]');

  cart.subscribe((items) => {
    const empty = items.length === 0;
    $('[data-cart-empty]').hidden = !empty;
    $('[data-cart-filled]').hidden = empty;
    if (empty) return;

    const t = cart.totals();

    // Line items
    const lines = $('[data-cart-lines]');
    lines.replaceChildren();

    for (const id of items) {
      const a = byId(id);
      if (!a) continue;

      const li = document.createElement('li');
      li.className = 'cart-line';

      const info = document.createElement('div');
      info.className = 'cart-line-info';
      const name = document.createElement('div');
      name.className = 'cart-line-name';
      name.textContent = a.title;
      const note = document.createElement('div');
      note.className = 'cart-line-note';
      note.textContent = a.priceNote;
      info.append(name, note);

      const right = document.createElement('div');
      right.className = 'cart-line-right';
      const price = document.createElement('div');
      price.className = 'cart-line-price';
      price.textContent = a.priceLabel;
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'cart-remove';
      remove.textContent = 'Remove';
      remove.setAttribute('aria-label', `Remove ${a.title}`);
      remove.addEventListener('click', () => {
        const deps = cart.dependents(a.id);
        if (deps.length) {
          const names = deps.map((d) => byId(d)?.title ?? d).join(', ');
          if (!confirm(`Removing ${a.title} will also remove: ${names}. Continue?`)) return;
        }
        cart.remove(a.id);
      });
      right.append(price, remove);

      li.append(info, right);
      lines.appendChild(li);
    }

    // Per-item breakdown in the summary
    const breakdown = $('[data-cart-breakdown]');
    breakdown.replaceChildren();
    for (const id of items) {
      const a = byId(id);
      if (!a) continue;
      const li = document.createElement('li');
      const label = document.createElement('span');
      label.textContent = a.title;
      const val = document.createElement('span');
      val.textContent = a.priceLabel;
      li.append(label, val);
      breakdown.appendChild(li);
    }

    const subtotal = t.recurringCents + t.oneTimeCents;
    $('[data-sum-subtotal]').textContent = money(subtotal);

    $('[data-row-trial]').hidden = !t.trialApplies;
    $('[data-sum-trial]').textContent = `−${money(subtotal)}`;

    $('[data-sum-due]').textContent = money(t.dueTodayCents);

    const note = $('[data-recurring-note]');
    if (t.trialApplies) {
      note.textContent = `Then ${money(t.recurringCents)}/mo starting in 7 days. Cancel anytime during the trial.`;
    } else if (t.recurringCents) {
      note.textContent = `${money(t.recurringCents)}/mo recurring. Billed monthly until cancelled.`;
    } else {
      note.textContent = '';
    }

    $('[data-cart-count]').textContent = `${t.count} item${t.count === 1 ? '' : 's'}`;
  });

  checkoutBtn.addEventListener('click', async () => {
    const err = $('[data-cart-error]');
    checkoutBtn.disabled = true;
    checkoutBtn.textContent = 'Starting checkout…';
    err.hidden = true;

    const result = await startCheckout();
    if (!result.ok) {
      err.innerHTML = result.html;
      err.hidden = false;
    }

    checkoutBtn.disabled = false;
    checkoutBtn.textContent = 'Checkout →';
  });
</script>

<style>
  .cart-section { padding-top: var(--space-4); }

  /* EMPTY STATE */
  .cart-empty {
    max-width: 460px;
    margin: 0 auto;
    text-align: center;
    padding: var(--space-5) var(--space-3);
    background: var(--color-bg-elev);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .cart-empty[hidden] { display: none; }
  .cart-empty-icon { color: var(--color-text-subtle); margin-bottom: var(--space-2); }
  .cart-empty-title { font-size: 1.35rem; margin: 0 0 0.4rem; color: #fff; }
  .cart-empty-body { color: var(--color-text-muted); margin: 0 0 var(--space-3); }

  /* LAYOUT */
  .cart-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-4);
    max-width: 1100px;
    margin: 0 auto;
    align-items: start;
  }
  .cart-layout[hidden] { display: none; }

  /* ITEMS */
  .cart-main-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }
  .cart-col-title { font-size: 1.1rem; margin: 0; color: #fff; }
  .cart-col-count { color: var(--color-text-muted); font-size: 0.85rem; }
  .cart-lines { list-style: none; padding: 0; margin: 0; }
  .cart-line {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .cart-line-name {
    font-family: var(--font-display);
    font-weight: 600;
    color: #fff;
    font-size: 1rem;
  }
  .cart-line-note {
    color: var(--color-text-subtle);
    font-size: 0.82rem;
    margin-top: 0.2rem;
    max-width: 42ch;
  }
  .cart-line-right { text-align: right; white-space: nowrap; }
  .cart-line-price {
    font-family: var(--font-display);
    font-weight: 700;
    color: #fff;
  }
  .cart-remove {
    background: none;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    font-size: 0.8rem;
    padding: 0.2rem 0;
    margin-top: 0.3rem;
    text-decoration: underline;
  }
  .cart-remove:hover, .cart-remove:focus-visible { color: var(--color-orange); }
  .cart-continue {
    display: inline-block;
    margin-top: var(--space-3);
    color: var(--color-accent-soft);
    font-size: 0.9rem;
    text-decoration: none;
  }
  .cart-continue:hover { text-decoration: underline; }

  /* SUMMARY */
  .cart-summary {
    position: sticky;
    top: calc(var(--space-5) + 40px);
    background: var(--color-bg-elev);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    padding: var(--space-3);
  }
  .cart-summary-title {
    font-size: 1.05rem;
    margin: 0 0 var(--space-2);
    color: #fff;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }
  .cart-breakdown { list-style: none; padding: 0; margin: 0 0 var(--space-2); }
  .cart-breakdown li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 0.3rem 0;
    font-size: 0.9rem;
    color: var(--color-text);
  }
  .cart-summary-rows {
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }
  .cart-summary-row {
    display: flex;
    justify-content: space-between;
    padding: 0.35rem 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .cart-summary-row[hidden] { display: none; }
  .cart-summary-row-muted { color: var(--color-text-subtle); font-size: 0.82rem; }
  .cart-credit { color: var(--color-green); }

  .cart-due {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border-strong);
    font-family: var(--font-display);
    font-weight: 800;
    color: #fff;
  }
  .cart-due-amount { font-size: 1.6rem; line-height: 1; }
  .cart-recurring-note {
    color: var(--color-text-muted);
    font-size: 0.82rem;
    margin: 0.5rem 0 0;
  }

  .cart-checkout { width: 100%; justify-content: center; }
  .cart-checkout:disabled { opacity: 0.45; cursor: not-allowed; transform: none; box-shadow: none; }
  .cart-terms {
    color: var(--color-text-subtle);
    font-size: 0.75rem;
    margin: 0.6rem 0 0;
    text-align: center;
  }
  .cart-error { color: var(--color-orange); font-size: 0.85rem; margin: 0.6rem 0 0; }
  .cart-error[hidden] { display: none; }
  .cart-secure {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    color: var(--color-text-subtle);
    font-size: 0.78rem;
    margin: var(--space-2) 0 0;
  }

  @media (max-width: 900px) {
    .cart-layout { grid-template-columns: 1fr; }
    .cart-summary { position: static; }
  }
</style>
