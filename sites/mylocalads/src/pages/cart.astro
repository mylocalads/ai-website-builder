---
import BaseLayout from '../layouts/BaseLayout.astro';
import BottomCTA from '../components/BottomCTA.astro';
---
<BaseLayout
  title="Your Cart | My Local Ads"
  description="Review your selected Growth Add-Ons and check out securely with Stripe."
>
  <section class="section">
    <div class="container container-narrow">
      <span class="eyebrow">Your Cart</span>
      <h1>Review Your Add-Ons</h1>

      <div data-cart-empty hidden>
        <p class="lead">Your cart is empty.</p>
        <a href="/#add-ons" class="btn btn-primary">Browse Growth Add-Ons</a>
      </div>

      <div data-cart-filled hidden>
        <ul class="cart-lines" data-cart-lines></ul>

        <div class="cart-summary">
          <div class="cart-summary-row" data-row-recurring>
            <span>Monthly</span><span data-sum-recurring></span>
          </div>
          <div class="cart-summary-row" data-row-onetime hidden>
            <span>One-time</span><span data-sum-onetime></span>
          </div>
          <div class="cart-summary-row cart-summary-due">
            <span>Due today</span><span data-sum-due></span>
          </div>
          <p class="cart-note" data-cart-note hidden></p>
        </div>

        <button type="button" class="btn btn-primary" data-checkout>Checkout →</button>
        <p class="cart-error" data-cart-error hidden></p>
        <p class="disclaimer cart-disclaimer">
          Payments are processed securely by Stripe. Terms of Service apply.
        </p>
      </div>
    </div>
  </section>

  <BottomCTA />
</BaseLayout>

<script>
  import { cart, addOns } from '../lib/cart-store.js';

  const money = (cents) => `$${(cents / 100).toLocaleString('en-US')}`;
  const $ = (sel) => document.querySelector(sel);
  const byId = (id) => addOns.find((a) => a.id === id);

  const SUPPORT_HTML =
    'Call <a href="tel:+18664511915">(866) 451-1915</a> or ' +
    '<a href="https://start.mylocalads.co/book-now-v2" rel="noopener">book a call</a>.';

  cart.subscribe((items) => {
    const empty = items.length === 0;
    $('[data-cart-empty]').hidden = !empty;
    $('[data-cart-filled]').hidden = empty;
    if (empty) return;

    const t = cart.totals();
    const lines = $('[data-cart-lines]');
    lines.replaceChildren();

    for (const id of items) {
      const a = byId(id);
      if (!a) continue;

      const li = document.createElement('li');
      li.className = 'cart-line';

      const left = document.createElement('div');
      const name = document.createElement('strong');
      name.textContent = a.title;
      const note = document.createElement('div');
      note.className = 'cart-line-note';
      note.textContent = a.priceNote;
      left.append(name, note);

      const right = document.createElement('div');
      right.className = 'cart-line-right';
      const price = document.createElement('span');
      price.textContent = a.priceLabel;
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'cart-remove';
      remove.textContent = '✕';
      remove.setAttribute('aria-label', `Remove ${a.title}`);
      remove.addEventListener('click', () => {
        const deps = cart.dependents(a.id);
        if (deps.length) {
          const names = deps.map((d) => byId(d)?.title ?? d).join(', ');
          if (!confirm(`Removing ${a.title} will also remove: ${names}. Continue?`)) return;
        }
        cart.remove(a.id);
      });
      right.append(price, remove);

      li.append(left, right);
      lines.appendChild(li);
    }

    $('[data-row-recurring]').hidden = t.recurringCents === 0;
    $('[data-sum-recurring]').textContent = `${money(t.recurringCents)}/mo`;
    $('[data-row-onetime]').hidden = t.oneTimeCents === 0;
    $('[data-sum-onetime]').textContent = money(t.oneTimeCents);
    $('[data-sum-due]').textContent = money(t.dueTodayCents);

    const noteEl = $('[data-cart-note]');
    noteEl.hidden = !t.trialApplies;
    noteEl.textContent = t.trialApplies
      ? 'Your 7-day free trial starts today. Billing begins on day 8.'
      : '';
  });

  $('[data-checkout]').addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    const err = $('[data-cart-error]');

    btn.disabled = true;
    btn.textContent = 'Starting checkout…';
    err.hidden = true;

    try {
      const res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: cart.items() }),
      });
      const data = await res.json().catch(() => ({}));

      if (res.ok && data.url) {
        window.location.href = data.url;
        return;
      }

      if (data.error === 'unknown_item') {
        cart.clear();
        err.textContent =
          'Some items are no longer available and have been removed from your cart.';
      } else if (data.fallback) {
        err.innerHTML = `Online checkout isn't available right now. ${SUPPORT_HTML}`;
      } else {
        err.innerHTML = `We couldn't start checkout. ${SUPPORT_HTML}`;
      }
      err.hidden = false;
    } catch {
      err.textContent = 'Network error. Please check your connection and try again.';
      err.hidden = false;
    } finally {
      btn.disabled = false;
      btn.textContent = 'Checkout →';
    }
  });
</script>

<style>
  .cart-lines { list-style: none; padding: 0; margin: var(--space-3) 0; }
  .cart-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .cart-line-note { color: var(--color-text-subtle); font-size: 0.82rem; margin-top: 0.15rem; }
  .cart-line-right { display: flex; align-items: center; gap: var(--space-2); white-space: nowrap; }
  .cart-remove {
    background: none;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    padding: 0.35rem 0.45rem;
    border-radius: var(--radius-sm);
  }
  .cart-remove:hover,
  .cart-remove:focus-visible { color: #fff; background: rgba(255, 255, 255, 0.08); }
  .cart-summary { margin: var(--space-3) 0; }
  .cart-summary-row {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0;
    color: var(--color-text-muted);
  }
  .cart-summary-row[hidden] { display: none; }
  .cart-summary-due {
    border-top: 1px solid var(--color-border-strong);
    margin-top: 0.4rem;
    padding-top: 0.8rem;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
  }
  .cart-note { color: var(--color-green); font-size: 0.9rem; margin: 0.5rem 0 0; }
  .cart-note[hidden] { display: none; }
  .cart-error { color: var(--color-orange); margin-top: var(--space-2); }
  .cart-error[hidden] { display: none; }
  .cart-disclaimer { margin-top: var(--space-2); }
</style>
