---
import BaseLayout from '../layouts/BaseLayout.astro';
import BottomCTA from '../components/BottomCTA.astro';

// Mirrors contact-us.astro: two-column grid with the copy on the left and the
// embedded GHL widget on the right, collapsing to one column below 900px.
//
// Unlike the contact form, the calendar sits directly on the page background —
// no elevated card, no border, no surrounding copy.
---
<BaseLayout
  title="Book A Call With Us! | My Local Ads"
  description="Book a free 30-minute call with our team. Learn about your business, discuss lead generation tactics, run numbers with our ROI calculator, and get free Local Falcon GBP scans."
>
  <section class="section">
    <div class="container">
      <div class="booking-grid">
        <div class="booking-info">
          <span class="eyebrow">Booking</span>
          <h1>Book A Free Call With Our Team!</h1>
          <p class="lead">Secure your spot now and experience why My Local Ads rolls differently than other agencies.</p>

          <ul class="perks">
            <li><span class="check">✓</span> <strong>Learn About Your Business!</strong></li>
            <li><span class="check">✓</span> <strong>Discuss Lead Generation Tactics!</strong></li>
            <li><span class="check">✓</span> <strong>Run Numbers With ROI Calculator!</strong></li>
            <li><span class="check">✓</span> <strong>Free Local Falcon GBP Scans!</strong></li>
          </ul>

          <ul class="contact-list">
            <li><strong>Sales (Phone):</strong> <a href="tel:+18664511915">(866) 451-1915</a></li>
            <li><strong>Email:</strong> <a href="mailto:support@mylocalads.co">support@mylocalads.co</a></li>
          </ul>

          <p class="muted">A 30-minute Google Meet to review your lead generation performance — ad spend, cost per lead, conversion rates — and the biggest opportunities to improve.</p>
        </div>

        {/* GHL booking widget — client-supplied snippet, do not modify the src
            or the loader URL. form_embed.js resizes the iframe via postMessage,
            so the min-height below only holds space until that runs. */}
        <div class="booking-embed">
          <iframe
            src="https://links.mylocalads.info/widget/booking/9YwDoBIAZ2A3kv7pRLTf"
            allow="payment"
            style="width: 100%;border:none;overflow: hidden;"
            scrolling="no"
            id="WCX5HNw00Qdat7OPxWBO_1785367833787"
            title="Book a call with My Local Ads"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <BottomCTA />
</BaseLayout>

{/* is:inline keeps Astro from bundling this — GHL's loader must be fetched
    from their domain at runtime to talk to the iframe. */}
<script src="https://links.mylocalads.info/js/form_embed.js" type="text/javascript" is:inline></script>

<style>
  .booking-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-5);
    align-items: start;
  }
  .lead { font-size: 1.2rem; color: var(--color-text-muted); margin: 0 0 var(--space-3); }
  .perks { list-style: none; padding: 0; margin: var(--space-3) 0; }
  .perks li { padding: 0.5rem 0; display: flex; gap: 0.75rem; align-items: center; font-size: 1.05rem; }
  .check { color: var(--color-green); font-weight: 900; flex-shrink: 0; }
  .contact-list {
    list-style: none;
    padding: var(--space-3) 0 0;
    margin: var(--space-3) 0 0;
    border-top: 1px solid var(--color-border);
  }
  .contact-list li { padding: 0.4rem 0; font-size: 1.05rem; }
  .muted { color: var(--color-text-muted); font-size: 0.95rem; margin-top: var(--space-3); }

  /* Bare on the page background — no card, no border. min-height only holds
     layout space until GHL's loader sizes the iframe. */
  .booking-embed {
    background: transparent;
    min-height: 700px;
  }
  .booking-embed iframe { min-height: 700px; display: block; }

  @media (max-width: 900px) {
    .booking-grid { grid-template-columns: 1fr; }
    .booking-embed, .booking-embed iframe { min-height: 900px; }
  }
</style>
