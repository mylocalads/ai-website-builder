---
import BaseLayout from '../layouts/BaseLayout.astro';
import BottomCTA from '../components/BottomCTA.astro';
---
<BaseLayout
  title="Book A Call With Us! | My Local Ads"
  description="Book a free 30-minute call with our team. Learn about your business, discuss lead generation tactics, run numbers with our ROI calculator, and get free Local Falcon GBP scans."
>
  <section class="section">
    <div class="container container-narrow text-center">
      <span class="eyebrow">Booking</span>
      <h1>Book A Free Call With Our Team!</h1>
      <p class="lead">Secure your spot now and experience why My Local Ads rolls differently than other agencies.</p>
      <ul class="perks">
        <li><span class="check">✓</span> <strong>Learn About Your Business!</strong></li>
        <li><span class="check">✓</span> <strong>Discuss Lead Generation Tactics!</strong></li>
        <li><span class="check">✓</span> <strong>Run Numbers With ROI Calculator!</strong></li>
        <li><span class="check">✓</span> <strong>Free Local Falcon GBP Scans!</strong></li>
      </ul>
      <div class="scheduler-frame">
        <p class="scheduler-note">A 30-minute Google Meet to review your current lead generation performance. We'll look at your ad spend, cost per lead, and conversion rates, then identify the biggest opportunities to improve your results, and what role we could play in that.</p>
        <a href="https://start.mylocalads.co/book-now-v2" class="btn btn-primary btn-lg" rel="noopener">Book Your Call Now →</a>
        <p class="disclaimer" style="margin-top: var(--space-2);">Opens our scheduling system in a new tab.</p>
      </div>
    </div>
  </section>

  <BottomCTA />
</BaseLayout>

<style>
  .lead { font-size: 1.2rem; color: var(--color-text-muted); max-width: 640px; margin: 0 auto var(--space-3); }
  .perks { list-style: none; padding: 0; margin: var(--space-3) auto; max-width: 480px; text-align: left; }
  .perks li { padding: 0.5rem 0; display: flex; gap: 0.75rem; align-items: center; font-size: 1.05rem; }
  .check { color: var(--color-green); font-weight: 900; }
  .scheduler-frame {
    background: var(--color-bg-elev); border: 1px solid var(--color-border);
    border-radius: var(--radius-xl); padding: var(--space-4);
    margin-top: var(--space-4); box-shadow: var(--shadow-md);
  }
  .scheduler-note { color: var(--color-text-muted); max-width: 560px; margin: 0 auto var(--space-3); }
</style>
