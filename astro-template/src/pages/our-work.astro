---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Gallery from '../components/Gallery.astro';
import CTA from '../components/CTA.astro';
import ContactBlock from '../components/ContactBlock.astro';
import GHLChatWidget from '../components/GHLChatWidget.astro';

const site = (await getEntry('site', 'config')).data as any;
const workEntry = await getEntry('site', 'our-work').catch(() => null);
const intro = (workEntry?.data as any)?.intro ?? `A sample of recent projects from ${site.business_name}.`;
const projects = (workEntry?.data as any)?.projects ?? site.gallery ?? [];
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Our Work', href: '/our-work' }];
---
<BaseLayout
  title={`Our Work — ${site.business_name}`}
  description={intro}
  breadcrumbs={crumbs}
  pagePath="/our-work"
>
  <div class="container"><Breadcrumbs items={crumbs} /></div>
  <section class="ow-hero">
    <div class="container">
      <h1>Our work</h1>
      <p>{intro}</p>
    </div>
  </section>
  <Gallery items={projects} heading="" />
  <CTA headline="Need a roof inspection? Book a free inspection now!" cta_text="Book a free inspection" cta_href="/contact" />
  <ContactBlock />
  <GHLChatWidget />
</BaseLayout>
<style>
  .ow-hero { padding: var(--space-4) 0 var(--space-2); }
  .ow-hero h1 { font-size: clamp(2rem, 4vw, 3rem); }
  .ow-hero p { color: var(--color-muted); font-size: 1.05rem; max-width: 45rem; }
</style>
