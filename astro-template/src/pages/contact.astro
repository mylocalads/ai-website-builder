---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import GHLChatWidget from '../components/GHLChatWidget.astro';

const site = (await getEntry('site', 'config')).data as any;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact' }];
---
<BaseLayout
  title={`Contact ${site.business_name}`}
  description={`Reach ${site.business_name} in ${site.address.city}, ${site.address.state}. Book a free inspection online or call ${site.phone_display}.`}
  breadcrumbs={crumbs}
  pagePath="/contact"
>
  <div class="container"><Breadcrumbs items={crumbs} /></div>
  <Hero
    eyebrow={`${site.address.city}, ${site.address.state}`}
    headline="Get in touch"
    subheadline="Book a free inspection online, or call us — we reply within one business day."
    cta_text={site.phone_display}
    cta_href={`tel:${site.phone}`}
  />
  <CTA headline="Prefer to talk right now?" cta_text={site.phone_display} cta_href={`tel:${site.phone}`} />
  <GHLChatWidget />
</BaseLayout>
