---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactBlock from '../components/ContactBlock.astro';
import GHLFormEmbed from '../components/GHLFormEmbed.astro';
import GHLChatWidget from '../components/GHLChatWidget.astro';
import SMSConsent from '../components/SMSConsent.astro';
import CTA from '../components/CTA.astro';

const site = (await getEntry('site', 'config')).data as any;
const contactForm = site.crm?.contact_form_embed_url;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact' }];
---
<BaseLayout
  title={`Contact ${site.business_name}`}
  description={`Reach ${site.business_name} in ${site.address.city}, ${site.address.state}.`}
  breadcrumbs={crumbs}
  pagePath="/contact"
>
  <div class="container"><Breadcrumbs items={crumbs} /></div>
  <section class="contact-hero">
    <div class="container">
      <h1>Get in touch</h1>
      <p>We reply within one business day, usually much faster.</p>
    </div>
  </section>
  {contactForm && (
    <section class="form-wrap">
      <div class="container">
        <SMSConsent />
        <GHLFormEmbed embed_url={contactForm} title={`Contact ${site.business_name}`} />
      </div>
    </section>
  )}
  <ContactBlock />
  <CTA headline="Prefer to talk right now?" />
  <GHLChatWidget />
</BaseLayout>
<style>
  .contact-hero { padding: var(--space-4) 0 var(--space-2); }
  .contact-hero h1 { font-size: clamp(2rem, 4vw, 3rem); }
  .contact-hero p { color: var(--color-muted); font-size: 1.05rem; }
  .form-wrap { padding: var(--space-3) 0 var(--space-5); }
</style>
