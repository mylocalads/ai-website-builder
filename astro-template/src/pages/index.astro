---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import Hero from '../components/Hero.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import AboutSection from '../components/AboutSection.astro';
import OurServices from '../components/OurServices.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Testimonials from '../components/Testimonials.astro';
import Financing from '../components/Financing.astro';
import UsVsThem from '../components/UsVsThem.astro';
import ServiceAreaGrid from '../components/ServiceAreaGrid.astro';
import Gallery from '../components/Gallery.astro';
import FAQ from '../components/FAQ.astro';
import ContactBlock from '../components/ContactBlock.astro';
import CTA from '../components/CTA.astro';
import GHLChatWidget from '../components/GHLChatWidget.astro';

const site = (await getEntry('site', 'config')).data as any;
const home = (await getEntry('site', 'home')).data as any;
const aboutEntry = await getEntry('site', 'about').catch(() => null);
const aboutStory = aboutEntry?.data?.story ?? site.tagline;

// Prefer estimate form on the hero if provided; fall back to contact form
const heroFormUrl = site.crm?.estimate_form_embed_url ?? site.crm?.contact_form_embed_url;

const faqJsonLd = home.faqs && home.faqs.length > 0 ? {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: home.faqs.map((f: any) => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;
---
<BaseLayout
  title={`${site.business_name} — ${site.tagline}`}
  description={home.hero?.subheadline || site.tagline}
  jsonLd={faqJsonLd ? [faqJsonLd] : undefined}
  pagePath="/"
>
  <Hero
    eyebrow={home.hero.eyebrow}
    headline={home.hero.headline}
    subheadline={home.hero.subheadline}
    cta_text={home.hero.cta_text}
    cta_href={home.hero.cta_href}
    photo={home.hero.photo}
    form_embed_url={heroFormUrl}
    form_title="Get a free estimate"
  />
  <PartnerBadges />
  <AboutSection heading="About us" body={aboutStory} />
  <OurServices />
  <WhyChooseUs />
  <Testimonials items={home.testimonials ?? []} />
  <Financing />
  <UsVsThem />
  <ServiceAreaGrid />
  <Gallery items={site.gallery ?? []} heading="Our work" />
  <FAQ items={home.faqs ?? []} />
  <ContactBlock />
  <CTA headline="Ready to get started?" />
  <GHLChatWidget />
</BaseLayout>
