---
import { getEntry } from 'astro:content';
export interface Props { headline: string; }
const { headline } = Astro.props;
const site = (await getEntry('site', 'config')).data as any;
---
<section class="cta">
  <div class="container">
    <h2>{headline}</h2>
    <a href={`tel:${site.phone}`} class="phone">{site.phone_display}</a>
  </div>
</section>
<style>
  .cta { padding: var(--space-5) 0; background: var(--color-accent); color: white; text-align: center; }
  .cta h2 { color: white; }
  .phone { display: inline-block; margin-top: var(--space-2); background: white; color: var(--color-accent); padding: 0.85rem 1.75rem; border-radius: var(--radius-sm); text-decoration: none; font-weight: 600; }
</style>
