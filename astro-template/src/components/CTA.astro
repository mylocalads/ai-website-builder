---
import { getEntry } from 'astro:content';
export interface Props { headline: string; cta_text?: string; cta_href?: string; }
const { headline, cta_text, cta_href } = Astro.props;
const site = (await getEntry('site', 'config')).data as any;
const href = cta_href ?? `tel:${site.phone}`;
const label = cta_text ?? site.phone_display;
---
<section class="cta">
  <div class="container">
    <h2>{headline}</h2>
    <a href={href} class="phone">{label}</a>
  </div>
</section>
<style>
  .cta { padding: var(--space-5) 0; background: var(--color-accent); color: white; text-align: center; }
  .cta h2 { color: white; font-size: clamp(1.75rem, 3vw, 2.5rem); }
  .phone { display: inline-block; margin-top: var(--space-2); background: white; color: var(--color-accent); padding: 1rem 2rem; border-radius: var(--radius-sm); text-decoration: none; font-weight: 700; font-size: 1.05rem; }
  .phone:hover { filter: brightness(0.95); }
</style>
