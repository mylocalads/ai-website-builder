---
export interface Props {
  heading: string;
  body: string;
  photo?: string;
  photo_alt?: string;
  photo_position?: 'left' | 'right';
}
const { heading, body, photo, photo_alt = '', photo_position = 'right' } = Astro.props;
---
<section class="about-section" aria-labelledby="about-heading">
  <div class="container">
    <div class={`about-grid ${photo_position === 'left' ? 'photo-left' : ''}`}>
      <div class="about-copy">
        <h2 id="about-heading">{heading}</h2>
        <p>{body}</p>
      </div>
      {photo && <img src={photo} alt={photo_alt} class="about-photo" loading="lazy" />}
    </div>
  </div>
</section>
<style>
  .about-section { padding: var(--space-5) 0; }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); align-items: center; }
  .about-grid.photo-left { grid-template-areas: 'photo copy'; }
  .about-grid.photo-left .about-copy { grid-area: copy; }
  .about-grid.photo-left .about-photo { grid-area: photo; }
  .about-photo { border-radius: var(--radius-md); aspect-ratio: 4/3; object-fit: cover; }
  h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); }
  p { font-size: 1.05rem; line-height: 1.65; color: var(--color-muted); }
  @media (max-width: 780px) { .about-grid, .about-grid.photo-left { grid-template-columns: 1fr; grid-template-areas: none; } }
</style>
