---
export interface GalleryItem { title?: string; location?: string; photo: string; alt: string; description?: string; }
export interface Props { items: GalleryItem[]; heading?: string; }
const { items, heading = 'Gallery' } = Astro.props;
---
{items.length > 0 && (
  <section class="gallery" aria-label="Gallery">
    <div class="container">
      <h2>{heading}</h2>
      <div class="grid">
        {items.map((p) => (
          <figure class="card">
            <img src={p.photo} alt={p.alt} loading="lazy" />
            <figcaption>
              {p.title && <h3>{p.title}</h3>}
              {p.location && <p class="loc">{p.location}</p>}
              {p.description && <p>{p.description}</p>}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .gallery { padding: var(--space-5) 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-3); }
  .card { margin: 0; }
  .card img { border-radius: var(--radius-md); aspect-ratio: 4/3; object-fit: cover; }
  h3 { margin: var(--space-1) 0 0; font-size: 1.1rem; }
  .loc { color: var(--color-muted); font-size: 0.9rem; margin: 0; }
</style>
