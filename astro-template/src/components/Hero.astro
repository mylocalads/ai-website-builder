---
import GHLFormEmbed from './GHLFormEmbed.astro';
import SMSConsent from './SMSConsent.astro';
export interface Props {
  eyebrow?: string;
  headline: string;
  subheadline: string;
  cta_text: string;
  cta_href: string;
  photo?: string;
  form_embed_url?: string;
  form_title?: string;
}
const { eyebrow, headline, subheadline, cta_text, cta_href, photo, form_embed_url, form_title = 'Get in touch' } = Astro.props;
---
<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{headline}</h1>
      <p class="sub">{subheadline}</p>
      <a href={cta_href} class="cta">{cta_text}</a>
    </div>
    {form_embed_url ? (
      <div class="hero-form">
        <SMSConsent />
        <GHLFormEmbed embed_url={form_embed_url} title={form_title} />
      </div>
    ) : photo && <img src={photo} alt="" class="hero-photo" loading="eager" />}
  </div>
</section>
<style>
  .hero { padding: var(--space-5) 0; }
  .hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); align-items: center; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.8rem; color: var(--color-muted); margin: 0 0 var(--space-1); }
  h1 { font-size: clamp(2rem, 4vw, 3.5rem); }
  .sub { font-size: 1.15rem; color: var(--color-muted); max-width: 32rem; }
  .cta { display: inline-block; margin-top: var(--space-2); background: var(--color-accent); color: white; padding: 0.85rem 1.5rem; border-radius: var(--radius-sm); text-decoration: none; }
  .hero-photo { border-radius: var(--radius-md); aspect-ratio: 4/3; object-fit: cover; }
  @media (max-width: 780px) { .hero-inner { grid-template-columns: 1fr; } }
</style>
