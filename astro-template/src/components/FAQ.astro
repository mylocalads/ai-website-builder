---
export interface FAQItem { q: string; a: string; }
export interface Props { items: FAQItem[]; }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="faq" aria-label="Frequently asked questions">
    <div class="container">
      <h2>Frequently asked</h2>
      <div class="list">
        {items.map((i) => (
          <details>
            <summary>{i.q}</summary>
            <p>{i.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .faq { padding: var(--space-5) 0; }
  details { border-bottom: 1px solid var(--color-surface); padding: var(--space-2) 0; }
  summary { font-weight: 600; cursor: pointer; }
  details[open] summary { margin-bottom: var(--space-1); }
</style>
