---
export interface Props {
  data?: {
    eyebrow?: string;
    headline: string;
    body: string;
    cta_text?: string;
    cta_href?: string;
  };
}
const { data } = Astro.props;
---
{data && (
  <section class="promise-band" aria-label={data.headline}>
    <div class="container inner">
      {data.eyebrow && <p class="eyebrow">{data.eyebrow}</p>}
      <h2>{data.headline}</h2>
      <p class="body">{data.body}</p>
      {data.cta_text && data.cta_href && (
        <a class="btn" href={data.cta_href}>{data.cta_text}</a>
      )}
    </div>
  </section>
)}
<style>
  .promise-band { background: var(--color-surface); padding: var(--space-5) 0; }
  .inner { max-width: 780px; text-align: center; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.9rem; font-weight: 600; color: var(--color-accent); margin: 0 0 var(--space-1); }
  h2 { font-family: var(--font-display); font-weight: 700; color: var(--color-text); font-size: clamp(1.85rem, 3.5vw, 3rem); line-height: 1.15; margin: 0 0 var(--space-2); }
  .body { color: var(--color-muted); font-size: 1.05rem; line-height: 1.7; margin: 0 0 var(--space-3); }
  .btn { display: inline-block; background: var(--color-accent); color: var(--color-on-accent); padding: 0.9rem 1.75rem; border-radius: var(--radius-sm); font-weight: 700; font-size: 1.25rem; text-decoration: none; }
</style>
