---
import { getCollection, getEntry } from 'astro:content';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order).slice(0, 5);
const site = (await getEntry('site', 'config')).data as any;
const section = site.services_section ?? { eyebrow: 'Our Services' };
const heading = section.heading_lead
  ? `${section.heading_lead} ${section.heading_rest ?? ''}`.trim()
  : 'Full-service roofing solutions';
---
<section id="services" class="services" aria-label="Services">
  <div class="container">
    <div class="head">
      <div>
        <p class="eyebrow">{section.eyebrow}</p>
        <h2>{heading}</h2>
        {section.subtitle && <p class="subtitle">{section.subtitle}</p>}
      </div>
      <a class="see-all" href="/services">See all services</a>
    </div>
    <ul class="grid">
      {services.map((s) => (
        <li class="card">
          {s.data.category && <p class="category">{s.data.category}</p>}
          {s.data.sub_services.length > 0 && (
            <ul class="subs">
              {s.data.sub_services.slice(0, 3).map((sub) => <li>{sub}</li>)}
            </ul>
          )}
          <p class="desc">{s.data.short_description}</p>
          <a class="learn" href={`/services/${s.slug}`}>
            Learn More<span class="visually-hidden"> about {s.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .services { padding: var(--space-5) 0; }
  .head { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: flex-end; justify-content: space-between; margin-bottom: var(--space-4); }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.9rem; font-weight: 600; color: var(--color-accent); margin: 0 0 var(--space-1); }
  h2 { font-family: var(--font-display); font-weight: 700; color: var(--color-text); font-size: clamp(1.85rem, 3.5vw, 3rem); line-height: 1.15; margin: 0; }
  .subtitle { color: var(--color-muted); margin: var(--space-1) 0 0; }
  .see-all { font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.85rem; color: var(--color-text); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-3); }
  .card { background: var(--color-surface); border-radius: var(--radius-lg); padding: var(--space-3); display: flex; flex-direction: column; box-shadow: 0 8px 22px rgba(15,20,25,0.08); }
  .category { margin: 0 0 var(--space-2); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-accent); }
  .subs { list-style: none; margin: 0 0 var(--space-2); padding: 0; }
  .subs li { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; color: var(--color-text); line-height: 1.3; }
  .desc { color: var(--color-muted); margin: 0 0 var(--space-3); flex: 1; }
  .learn { font-weight: 700; color: var(--color-text); text-decoration: underline; text-underline-offset: 4px; }
</style>
