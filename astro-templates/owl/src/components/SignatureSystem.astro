---
export interface Props {
  data?: {
    eyebrow?: string;
    headline: string;
    intro?: string;
    blocks?: Array<{ title: string; body: string }>;
    steps_title?: string;
    steps?: Array<{ title: string; body: string }>;
    guarantee?: { title: string; body: string; cta_text?: string; cta_href?: string };
  };
}
const { data } = Astro.props;
const blocks = data?.blocks ?? [];
const steps = data?.steps ?? [];
---
{data && (
  <section class="signature" aria-label={data.headline}>
    <div class="container">
      <div class="head">
        {data.eyebrow && <p class="eyebrow">{data.eyebrow}</p>}
        <h2>{data.headline}</h2>
        {data.intro && <p class="intro">{data.intro}</p>}
      </div>

      {blocks.length > 0 && (
        <ul class="blocks">
          {blocks.map((b) => (
            <li>
              <h3>{b.title}</h3>
              <p>{b.body}</p>
            </li>
          ))}
        </ul>
      )}

      {steps.length > 0 && (
        <div class="steps">
          {data.steps_title && <h3 class="steps-title">{data.steps_title}</h3>}
          <ol>
            {steps.map((s) => (
              <li>
                <h4>{s.title}</h4>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      )}

      {data.guarantee && (
        <div class="guarantee">
          <h3>{data.guarantee.title}</h3>
          <p>{data.guarantee.body}</p>
          {data.guarantee.cta_text && data.guarantee.cta_href && (
            <a class="btn" href={data.guarantee.cta_href}>{data.guarantee.cta_text}</a>
          )}
        </div>
      )}
    </div>
  </section>
)}
<style>
  .signature { padding: var(--space-5) 0; }
  .head { max-width: 780px; margin: 0 0 var(--space-4); }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.9rem; font-weight: 600; color: var(--color-accent); margin: 0 0 var(--space-1); }
  h2 { font-family: var(--font-display); font-weight: 700; color: var(--color-text); font-size: clamp(1.85rem, 3.5vw, 3rem); line-height: 1.15; margin: 0 0 var(--space-2); }
  .intro { color: var(--color-muted); font-size: 1.05rem; line-height: 1.7; margin: 0; }

  .blocks { list-style: none; margin: 0 0 var(--space-4); padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-3); }
  .blocks h3 { font-size: 1.3rem; margin: 0 0 var(--space-1); color: var(--color-text); }
  .blocks p { margin: 0; color: var(--color-muted); line-height: 1.7; }

  .steps { background: var(--color-surface); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-3); margin-bottom: var(--space-4); }
  .steps-title { font-size: 1.5rem; margin: 0 0 var(--space-3); color: var(--color-text); }
  .steps ol { list-style: none; counter-reset: step; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-3); }
  .steps li { counter-increment: step; }
  .steps li::before { content: counter(step); display: flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--color-accent); color: var(--color-on-accent); font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; margin-bottom: var(--space-2); }
  .steps h4 { font-size: 1.1rem; margin: 0 0 var(--space-1); color: var(--color-text); }
  .steps p { margin: 0; color: var(--color-muted); line-height: 1.6; }

  .guarantee { background: var(--color-primary); color: var(--color-on-primary); border-radius: var(--radius-lg); padding: var(--space-4); }
  .guarantee h3 { font-size: 1.5rem; margin: 0 0 var(--space-2); color: var(--color-on-primary); }
  .guarantee p { margin: 0 0 var(--space-3); line-height: 1.7; }
  .btn { display: inline-block; background: var(--color-accent); color: var(--color-on-accent); padding: 0.9rem 1.75rem; border-radius: var(--radius-sm); font-weight: 700; font-size: 1.25rem; text-decoration: none; }
</style>
