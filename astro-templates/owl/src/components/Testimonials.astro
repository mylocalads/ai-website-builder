---
export interface Testimonial { name: string; location?: string; text: string; rating?: number; }
export interface Props { items: Testimonial[]; eyebrow?: string; cta_text?: string; cta_href?: string; }
const { items, eyebrow = 'Real Customer Experiences', cta_text, cta_href } = Astro.props;
// Full-width band carrying one lead quote, then the remainder as a supporting
// row. The band is the point: it breaks the light page and gives the social
// proof its own moment rather than burying it in a text grid.
const [lead, ...rest] = items;
---
{items.length > 0 && (
  <section class="testimonials" aria-label="Testimonials">
    <div class="container">
      <p class="eyebrow">{eyebrow}</p>

      <figure class="lead">
        <span class="mark" aria-hidden="true">&ldquo;</span>
        <blockquote><p>{lead.text}</p></blockquote>
        <figcaption>
          <span class="name">{lead.name}</span>
          {lead.location && <span class="loc">{lead.location}</span>}
          {lead.rating && (
            <span class="stars" aria-label={`${lead.rating} out of 5 stars`}>
              <span aria-hidden="true">{'★'.repeat(Math.round(lead.rating))}</span>
            </span>
          )}
        </figcaption>
      </figure>

      {rest.length > 0 && (
        <ul class="rest">
          {rest.map((t) => (
            <li>
              <blockquote><p>{t.text}</p></blockquote>
              <p class="who">
                <span class="name">{t.name}</span>
                {t.rating && (
                  <span class="stars" aria-label={`${t.rating} out of 5 stars`}>
                    <span aria-hidden="true">{'★'.repeat(Math.round(t.rating))}</span>
                  </span>
                )}
              </p>
            </li>
          ))}
        </ul>
      )}
      {cta_text && cta_href && (
        <div class="section-cta"><a class="btn" href={cta_href}>{cta_text}</a></div>
      )}
    </div>
  </section>
)}
<style>
  .section-cta { text-align: center; margin-top: var(--space-4); }
  .section-cta .btn { display: inline-block; background: var(--color-accent); color: var(--color-on-accent); padding: 0.9rem 1.75rem; border-radius: var(--radius-sm); font-weight: 700; font-size: 1.25rem; letter-spacing: 0.02em; text-transform: uppercase; text-decoration: none; }

  .testimonials { background: var(--color-primary); color: var(--color-on-primary); padding: var(--space-5) 0; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.9rem; font-weight: 600; color: var(--color-accent); margin: 0 0 var(--space-3); text-align: center; }

  .lead { margin: 0 auto var(--space-4); max-width: 860px; text-align: center; position: relative; }
  .mark { display: block; font-family: var(--font-display); font-weight: 700; font-size: 5rem; line-height: 0.6; color: var(--color-accent); opacity: 0.55; margin-bottom: var(--space-2); }
  .lead blockquote { margin: 0; }
  .lead blockquote p { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: clamp(1.25rem, 2.4vw, 1.9rem); line-height: 1.4; color: var(--color-on-primary); }
  .lead figcaption { margin-top: var(--space-3); display: flex; flex-wrap: wrap; gap: 0.5rem 0.9rem; align-items: center; justify-content: center; }

  .name { font-weight: 700; color: var(--color-on-primary); }
  .loc { color: var(--color-on-primary); opacity: 0.65; font-size: 0.9rem; }
  .stars { color: var(--color-accent); letter-spacing: 0.12em; }

  .rest { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-3); }
  .rest li { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--radius-lg); padding: var(--space-3); }
  .rest blockquote { margin: 0 0 var(--space-2); }
  .rest blockquote p { margin: 0; color: var(--color-on-primary); opacity: 0.85; line-height: 1.6; font-size: 0.98rem; }
  .who { margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; align-items: center; font-size: 0.9rem; }
</style>
