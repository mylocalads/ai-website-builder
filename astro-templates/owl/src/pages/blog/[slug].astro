---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const site = (await getEntry('site', 'config')).data as any;
const { Content } = await post.render();
const path = `/blog/${post.slug}`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog' },
  { name: post.data.title, href: path },
];

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publish_date,
  author: { '@type': 'Organization', name: post.data.author ?? site.business_name },
  publisher: { '@type': 'Organization', name: site.business_name },
  mainEntityOfPage: new URL(path, site.site_url).toString(),
};
---
<BaseLayout
  title={`${post.data.title} — ${site.business_name}`}
  description={post.data.description}
  breadcrumbs={crumbs}
  jsonLd={[articleLd]}
  ogImage={post.data.hero_image}
  pagePath={path}
>
  <div class="container"><Breadcrumbs items={crumbs} /></div>
  <article class="post">
    <div class="container narrow">
      <div class="sheet">
      <p class="meta">{post.data.read_time} · Posted {post.data.publish_date}</p>
      <h1>{post.data.title}</h1>
      {post.data.hero_image && <img src={post.data.hero_image} alt="" class="hero" />}
      <div class="body"><Content /></div>
      </div>
    </div>
  </article>
  <ClosingCTA />
</BaseLayout>
<style>
  .post { padding: var(--space-4) 0 var(--space-5); }
  .narrow { max-width: 820px; }
  /* Article sits on a contained sheet rather than running bare across the page. */
  .sheet { background: var(--color-surface); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-4) var(--space-5); box-shadow: 0 8px 22px rgba(15,20,25,0.08); }
  @media (max-width: 620px) { .sheet { padding: var(--space-3); } }
  .meta { margin: 0 0 var(--space-1); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-muted); }
  h1 { font-size: clamp(2rem, 4vw, 3rem); margin: 0 0 var(--space-3); }
  .hero { width: 100%; border-radius: var(--radius-lg); margin-bottom: var(--space-3); }
  .body :global(h2) { font-size: 1.6rem; margin-top: var(--space-4); }
  .body :global(p) { line-height: 1.7; margin: 0 0 var(--space-2); }
</style>
