---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import ClosingCTA from '../components/ClosingCTA.astro';

const site = (await getEntry('site', 'config')).data as any;
---
<BaseLayout
  title={`Thanks — we've got your request | ${site.business_name}`}
  description={`Your estimate request has reached ${site.business_name}. We'll be in touch shortly.`}
  pagePath="/thank-you"
>
  <section class="ty">
    <div class="container inner">
      <p class="eyebrow">Request received</p>
      <h1>Thanks — we've got it</h1>
      <p class="lede">
        Your request is with the {site.business_name.split(' ')[0]} team. We'll call you back to
        confirm the details and book a time to come out and look at the job properly.
      </p>
      <p class="sub">In a hurry, or dealing with an active leak?</p>
      <a class="btn" href={`tel:${site.phone}`}>Call {site.phone_display}</a>
      <p class="back"><a href="/">Back to the homepage</a></p>
    </div>
  </section>
  <ClosingCTA headline="While you're here" cta_text="See our recent work" cta_href="/our-work" />
</BaseLayout>
<style>
  .ty { padding: var(--space-5) 0; }
  .inner { max-width: 720px; text-align: center; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.9rem; font-weight: 600; color: var(--color-accent-ink); margin: 0 0 var(--space-1); }
  h1 { font-family: var(--font-display); font-weight: 700; font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.1; margin: 0 0 var(--space-3); color: var(--color-text); }
  .lede { font-size: 1.1rem; line-height: 1.7; color: var(--color-muted); margin: 0 0 var(--space-4); }
  .sub { font-weight: 600; margin: 0 0 var(--space-2); color: var(--color-text); }
  .btn { display: inline-block; background: var(--color-accent); color: var(--color-on-accent); padding: 0.95rem 2rem; border-radius: var(--radius-sm); font-weight: 700; font-size: 1.25rem; text-decoration: none; text-transform: uppercase; }
  .back { margin: var(--space-4) 0 0; }
</style>
