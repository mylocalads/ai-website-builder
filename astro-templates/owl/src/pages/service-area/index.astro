---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHead from '../../components/SectionHead.astro';

const site = (await getEntry('site', 'config')).data as any;
const areas = (await getCollection('service_areas')).sort((a, b) => a.data.order - b.data.order).slice(0, 5);
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Service Areas', href: '/service-area' }];
---
<BaseLayout
  title={`Service Areas — ${site.business_name}`}
  description={`Communities served by ${site.business_name}.`}
  breadcrumbs={crumbs}
  pagePath="/service-area"
>
  <div class="container"><Breadcrumbs items={crumbs} /></div>
  <section class="areas">
    <div class="container">
      <SectionHead eyebrow="Where We Work" heading="Service areas" />
      <ul class="grid">
        {areas.map((a) => (
          <li>
            <a href={`/service-area/${a.slug}`} class="card">
              <h2>{a.data.name}, {a.data.state}</h2>
              {a.data.county && <p class="county">{a.data.county}</p>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
<style>
  .areas { padding: var(--space-5) 0; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-3); }
  .card { display: block; background: var(--color-surface); border-radius: var(--radius-lg); padding: var(--space-3); text-decoration: none; box-shadow: 0 8px 22px rgba(15,20,25,0.08); transition: transform 0.2s ease; }
  .card:hover, .card:focus-visible { transform: translateY(-4px); }
  h2 { margin: 0; font-size: 1.25rem; color: var(--color-text); }
  .county { margin: var(--space-1) 0 0; color: var(--color-muted); font-size: 0.95rem; }
</style>
