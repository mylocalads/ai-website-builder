---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import HeroOwl from '../../components/HeroOwl.astro';
import PartnerBadges from '../../components/PartnerBadges.astro';
import AboutSection from '../../components/AboutSection.astro';
import Gallery from '../../components/Gallery.astro';
import WhyChooseUs from '../../components/WhyChooseUs.astro';
import ServicesGridOwl from '../../components/ServicesGridOwl.astro';
import GHLReviewsWidget from '../../components/GHLReviewsWidget.astro';
import Financing from '../../components/Financing.astro';
import ServiceAreaGrid from '../../components/ServiceAreaGrid.astro';
import FAQ from '../../components/FAQ.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import GHLChatWidget from '../../components/GHLChatWidget.astro';

export async function getStaticPaths() {
  // Defined inside getStaticPaths because Astro extracts this function into its
  // own module at build time and does not carry along frontmatter-level consts.
  // Nesting under /service-area/ means a city slug can no longer collide with a
  // top-level static route, so only the directory index is reserved.
  const RESERVED_SLUGS = new Set(['index']);
  const SLUG_PATTERN = /^[a-z0-9-]+-[a-z]{2}$/;

  const areas = await getCollection('service_areas');
  const validated = areas
    .sort((a, b) => a.data.order - b.data.order)
    .slice(0, 5)
    .filter((a) => {
      const s = a.slug;
      if (RESERVED_SLUGS.has(s)) {
        console.warn(`[service_areas] Skipping "${s}" — reserved slug conflicts with the directory index.`);
        return false;
      }
      if (!SLUG_PATTERN.test(s)) {
        console.warn(`[service_areas] Skipping "${s}" — must match city-state pattern (e.g. miami-fl).`);
        return false;
      }
      return true;
    });
  return validated.map((a) => ({ params: { slug: a.slug }, props: { area: a } }));
}

const { area } = Astro.props;
const site = (await getEntry('site', 'config')).data as any;
const home = await getEntry('site', 'home').catch(() => null);
const homeData = (home?.data as any) ?? {};
const homeFaqs = homeData.faqs ?? [];

const title = `${site.business_name} — Serving ${area.data.name}, ${area.data.state}`;
const description = `${site.business_name} serves ${area.data.name}, ${area.data.state} with local, licensed service across ${area.data.neighborhoods.slice(0, 3).join(', ') || 'the metro area'}.`;
const path = `/service-area/${area.slug}`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Service Areas', href: '/service-area' },
  { name: `${area.data.name}, ${area.data.state}`, href: path },
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: `Local ${site.tagline}`,
  provider: { '@type': 'LocalBusiness', name: site.business_name },
  areaServed: { '@type': 'AdministrativeArea', name: `${area.data.name}, ${area.data.state}` },
  description,
};
---
<BaseLayout title={title} description={description} breadcrumbs={crumbs} jsonLd={[serviceLd]} pagePath={path}>
  <div class="container"><Breadcrumbs items={crumbs} /></div>
  <HeroOwl
    eyebrow={`${area.data.name}, ${area.data.state}`}
    headline={`${site.business_name} — Serving ${area.data.name}, ${area.data.state}`}
    subheadline={area.data.local_context || `Local service across ${area.data.name} and surrounding communities.`}
    cta_text="Get Your Free Estimate!"
    cta_href="/book"
    photo={area.data.hero_photo ?? site.default_hero_photo}
  />
  <PartnerBadges />
  <AboutSection
    eyebrow={`About ${area.data.name}`}
    heading={`Local roots in ${area.data.name}`}
    body={area.data.local_context || `${site.business_name} proudly serves ${area.data.name} and the surrounding areas with fast, honest, licensed work.`}
    photo={area.data.landmark_photo}
    photo_alt={area.data.landmark_alt ?? `${area.data.name} landmark`}
    photo_position="right"
  />
  <Gallery items={area.data.gallery ?? []} heading={`${area.data.name} work`} />
  <WhyChooseUs />
  <ServicesGridOwl />
  <GHLReviewsWidget />
  <Financing />
  <ServiceAreaGrid />
  <FAQ items={homeFaqs} />
  <ClosingCTA headline="It's time for a new roof" cta_text="Let's Get Started" cta_href="/book" />
  <GHLChatWidget />
</BaseLayout>
