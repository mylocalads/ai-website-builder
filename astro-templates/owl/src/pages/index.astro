---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import HeroOwl from '../components/HeroOwl.astro';
import GHLChatWidget from '../components/GHLChatWidget.astro';

const site = (await getEntry('site', 'config')).data as any;
const home = (await getEntry('site', 'home')).data as any;

const faqJsonLd = home.faqs && home.faqs.length > 0 ? {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: home.faqs.map((f: any) => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;
---
<BaseLayout
  title={`${site.business_name} — ${site.tagline}`}
  description={home.hero?.subheadline || site.tagline}
  jsonLd={faqJsonLd ? [faqJsonLd] : undefined}
  pagePath="/"
>
  <HeroOwl
    eyebrow={home.hero.eyebrow}
    headline={home.hero.headline}
    subheadline={home.hero.subheadline}
    cta_text={home.hero.cta_text}
    cta_href={home.hero.cta_href}
    photo={home.hero.photo ?? site.default_hero_photo}
    video={home.hero.video ?? site.default_hero_video}
    video_link_text={home.hero.video_link_text}
    video_link_href={home.hero.video_link_href}
    quote_card={home.hero.quote_card}
  />
  <GHLChatWidget />
</BaseLayout>
