---
import { getEntry } from 'astro:content';
const site = (await getEntry('site', 'config')).data as any;
const f = site.financing ?? { enabled: false };
---
{f.enabled && (
  <section class="financing" aria-label="Financing">
    <div class="container financing-inner">
      <div class="copy">
        {f.headline && <h2>{f.headline}</h2>}
        {f.description && <p>{f.description}</p>}
        {f.cta_text && f.cta_href && <a href={f.cta_href} class="cta">{f.cta_text}</a>}
      </div>
      {f.logo_url && <img src={f.logo_url} alt="Financing partner" class="logo" loading="lazy" />}
    </div>
  </section>
)}
<style>
  .financing { padding: var(--space-5) 0; background: var(--color-surface); }
  .financing-inner { display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-4); align-items: center; }
  .cta { display: inline-block; margin-top: var(--space-2); background: var(--color-accent); color: white; padding: 0.85rem 1.5rem; border-radius: var(--radius-sm); text-decoration: none; }
  .logo { max-height: 100px; width: auto; justify-self: center; }
  @media (max-width: 780px) { .financing-inner { grid-template-columns: 1fr; } }
</style>
